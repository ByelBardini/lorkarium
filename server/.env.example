NODE_ENV=development
PORT=3333
HOST=0.0.0.0
DATABASE_URL=postgres://lorkarium:lorkarium@localhost:5432/lorkarium
# Pool do pg (1 a 100, padrão 10) e tempos por conexão em ms (100 a 600000): um comando acima de
# DATABASE_STATEMENT_TIMEOUT_MS (5000) é cancelado; esperar a trava de uma cena acima de
# DATABASE_LOCK_TIMEOUT_MS (2000) falha em vez de segurar a conexão.
DATABASE_POOL_MAX=
DATABASE_STATEMENT_TIMEOUT_MS=
DATABASE_LOCK_TIMEOUT_MS=
# Admin criado no boot se o e-mail ainda não existe (nunca troca a senha de quem já existe).
# Os dois juntos ou nenhum. Em produção a senha exige 12+ caracteres; em dev vale admin@admin.com / admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# S3 dos assets: o SeaweedFS do pnpm db:up (identidade em infra/compose/seaweedfs/s3.json).
# O bucket é criado no boot se faltar. Em produção, qualquer S3 compatível (R2, B2, AWS).
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=lorkarium
S3_ACCESS_KEY_ID=lorkarium
S3_SECRET_ACCESS_KEY=lorkarium-dev-secret
S3_FORCE_PATH_STYLE=true
