NODE_ENV=development
PORT=3333
HOST=0.0.0.0
DATABASE_URL=postgres://lorkarium:lorkarium@localhost:5432/lorkarium
# Pool do pg (1 a 100, padrão 10) e tempos por conexão em ms (100 a 600000): um comando acima de
# DATABASE_STATEMENT_TIMEOUT_MS (5000) é cancelado; esperar a trava de uma cena acima de
# DATABASE_LOCK_TIMEOUT_MS (2000) falha em vez de segurar a conexão.
DATABASE_POOL_MAX=
DATABASE_STATEMENT_TIMEOUT_MS=
DATABASE_LOCK_TIMEOUT_MS=
# Admin criado no boot se o e-mail ainda não existe (nunca troca a senha de quem já existe).
# Os dois juntos ou nenhum. Em produção a senha exige 12+ caracteres; em dev vale admin@admin.com / admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# S3 dos assets: o SeaweedFS do pnpm db:up (identidade em infra/compose/seaweedfs/s3.json).
# O bucket é criado no boot se faltar. Em produção, qualquer S3 compatível (R2, B2, AWS).
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=lorkarium
S3_ACCESS_KEY_ID=lorkarium
S3_SECRET_ACCESS_KEY=lorkarium-dev-secret
S3_FORCE_PATH_STYLE=true
# Chave mestra da cifra de campos (e-mail, segredo do 2FA): 32 bytes em base64, obrigatória.
# ESTA É SÓ DE DESENVOLVIMENTO (pública no repositório). Em produção gere a sua com
# `openssl rand -base64 32` e guarde-a: perder a chave perde os e-mails cifrados.
DATA_ENCRYPTION_KEY=EJ0VAPvnCxgUGYKDbckfwbxEca0bm7NndOkKfFJQjeQ=
# E-mail (troca de e-mail, avisos de segurança). Em dev, o Mailpit do pnpm db:up (caixa em
# http://localhost:8025); vazio = só no log do server (recusado em produção, onde é obrigatório).
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Lorkarium <no-reply@lorkarium.dev>
# Onde o client é servido: a base dos links dos e-mails. Padrão http://localhost:5173; obrigatório em produção.
APP_PUBLIC_URL=
# Onde a landing é servida: GET /api/legal/terms e /privacy redirecionam para /termos/ e /privacidade/
# dela. Padrão http://localhost:4321 (pnpm site:dev); obrigatório em produção.
SITE_PUBLIC_URL=
# Proxies na frente do server cujo X-Forwarded-For vale (inteiro de 0 a 5). Vazio = 0 no dev; 1 atrás
# do Traefik do Coolify; 2 com a Cloudflare em modo proxy na frente dele. A porta só pode ser
# alcançável pelo proxy: quem fala direto com ela forjaria o IP do rate limit do login.
TRUST_PROXY=
# Pasta do build do client (vite build) que o server entrega na mesma origem, com o fallback da SPA.
# Caminho absoluto. Vazio no dev (o Vite serve o client); a imagem de produção usa /app/client/dist.
CLIENT_DIST_DIR=
# Registro de acesso (art. 15 do Marco Civil: IP, data e hora e a conta, guardados 6 meses; ver
# docs/context/access-log.md). Obrigatório em produção, os três juntos: o bucket próprio e a chave do
# usuário IAM só de escrita; endpoint e região são os do S3_*. Vazio no dev = desligado. Para ligar
# no dev, o bucket dos assets serve: lorkarium / lorkarium / lorkarium-dev-secret.
ACCESS_LOG_S3_BUCKET=
ACCESS_LOG_S3_ACCESS_KEY_ID=
ACCESS_LOG_S3_SECRET_ACCESS_KEY=
