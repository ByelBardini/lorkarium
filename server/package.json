{
  "name": "@lorkarium/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsdown --config-loader tsx",
    "start:dist": "node --env-file-if-exists=.env dist/index.mjs",
    "start:prod": "node dist/deploy-migrate.mjs && node dist/index.mjs",
    "typecheck": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:encrypt-emails": "tsx --env-file-if-exists=.env src/encrypt-emails.ts",
    "seed:dev": "tsx --env-file-if-exists=.env src/dev-seed.ts",
    "seed:stress": "tsx --env-file-if-exists=.env src/stress-seed.ts",
    "mail:preview": "tsx --env-file-if-exists=.env src/mail-preview.ts",
    "e2e:database": "tsx --env-file-if-exists=.env test/support/prepare-e2e-database.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@lorkarium/contracts": "workspace:*",
    "@lorkarium/game-core": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "cannon-es": "^0.20.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "nodemailer": "^10.2.1",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lorkarium/tsconfig": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15"
  }
}
