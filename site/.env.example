# Build-time values (astro:env). In Coolify they are Build Variables.
SITE_URL=http://localhost:4321
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_CONTACT_EMAIL=contato@lorkarium.dev
# Only dev and tests accept Termos/Privacidade still marked draft: true.
LEGAL_DRAFTS_ALLOWED=true
# The same for the recurso guides (drafts render with noindex).
GUIDE_DRAFTS_ALLOWED=true
# Who sells, in the terms. A test CPF with valid check digits: the real one goes only into
# Coolify, never into git. The site validates it and publishes only the ***.982.247-** mask.
LEGAL_SUPPLIER_NAME=Fornecedora de Teste
LEGAL_SUPPLIER_CPF=52998224725
