# Landing page server (site/Dockerfile). TLS ends at Coolify's Traefik, so Caddy speaks plain HTTP on :80.
# The CSP is not here: Astro's security.csp emits it as a <meta> with the hashes of its inline scripts.
{
	admin off
	auto_https off
	persist_config off
}

(security_headers) {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}
}

:80 {
	root * /srv
	encode zstd gzip
	import security_headers

	# Astro fingerprints everything under /_astro/, so a new build never reuses a cached name.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# HTML keeps its URL across deploys: revalidate on every visit.
	@unhashed not path /_astro/*
	header @unhashed Cache-Control "no-cache"

	# No try_files: file_server already serves {path}/index.html and redirects /termos to /termos/,
	# the one URL that astro.config.mjs (trailingSlash: 'always') puts in the canonical and the sitemap.
	file_server

	handle_errors 404 {
		import security_headers
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}
}
