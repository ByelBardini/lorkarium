---
import { PUBLIC_APP_URL, PUBLIC_CONTACT_EMAIL } from 'astro:env/client';
import { inviteMailto } from '@/copy/landing-copy';
import SiteLayout from '@/layouts/site-layout.astro';
import { RELEASES_PAGE_URL } from '@/lib/desktop-release';

const installSteps = [
  {
    title: 'Abra o instalador',
    text: 'Ao terminar o download, abra o arquivo Lorkarium_…_x64-setup.exe e siga as etapas de instalação. Não é necessária permissão de administrador.',
  },
  {
    title: 'Se aparecer um aviso do Windows',
    text: 'O SmartScreen pode exibir “O Windows protegeu o computador” se ainda não reconhecer o instalador. Para continuar com o arquivo baixado por este site, selecione Mais informações e depois Executar assim mesmo.',
  },
  {
    title: 'Entre na sua conta',
    text: 'Abra o Lorkarium e entre com o nome de usuário e a senha definidos ao aceitar o convite.',
  },
];
---

<SiteLayout
  title="Baixando o Lorkarium"
  description="Baixe o Lorkarium para Windows e veja as instruções de instalação e acesso à sua conta."
  noindex
>
  <section class="act relative isolate overflow-clip">
    <div class="site-wrap flex max-w-[960px] flex-col gap-10">
      <div class="flex flex-col gap-5">
        <span class="eyebrow">Download</span>
        <h1 class="act-title m-0">Seu download está começando</h1>
        <p class="m-0 text-[17px] leading-relaxed text-muted">
          <span data-release-label>Lorkarium para Windows 10 e 11</span>. O download não começou?
          <a href={RELEASES_PAGE_URL} data-manual-download class="font-semibold">
            Baixar manualmente
          </a>
        </p>
        <p
          data-download-fallback
          role="status"
          hidden
          class="m-0 border-l-2 border-gold bg-gold/6 px-4 py-3 text-sm leading-[1.55] text-label"
        >
          Não foi possível consultar a versão mais recente. Use o link acima para abrir a página de
          versões e baixar o arquivo Lorkarium_…_x64-setup.exe.
        </p>
      </div>
      <ol aria-label="Como instalar" class="m-0 grid list-none border-t border-edge p-0">
        {installSteps.map((step, index) => (
          <li class="flex gap-6 border-b border-edge py-6">
            <span
              class="w-8 shrink-0 font-wordmark text-4xl leading-[0.9] font-bold text-ember"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <span class="flex flex-col gap-2">
              <strong class="font-wordmark text-xl font-semibold tracking-[0.04em]">
                {step.title}
              </strong>
              <span class="text-[15px] leading-relaxed text-muted">{step.text}</span>
            </span>
          </li>
        ))}
      </ol>
      <div class="flex flex-col gap-2 text-[15px] leading-relaxed text-muted">
        <p class="m-0">
          Ainda não tem convite?{' '}
          <a href={inviteMailto(PUBLIC_CONTACT_EMAIL)} class="font-semibold">
            Pedir convite
          </a>
        </p>
        <p class="m-0">
          No Mac ou no Linux?{' '}
          <a href={`${PUBLIC_APP_URL}/login`} class="font-semibold">
            Jogue pelo navegador
          </a>
        </p>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  import { browserReleaseSource } from '@/scripts/browser-release-source';
  import { startDesktopDownload } from '@/scripts/thank-you';
  import { WindowNavigator } from '@/services/page-navigator';

  void startDesktopDownload(document, {
    source: browserReleaseSource(),
    navigator: new WindowNavigator(),
  });
</script>
