---
import { PUBLIC_APP_URL, PUBLIC_CONTACT_EMAIL } from 'astro:env/client';
import { inviteMailto } from '@/copy/landing-copy';
import SiteLayout from '@/layouts/site-layout.astro';
import { RELEASES_PAGE_URL } from '@/lib/desktop-release';

const installSteps = [
  {
    title: 'Abre o instalador',
    text: 'Quando o download terminar, abre o arquivo Lorkarium_…_x64-setup.exe. Ele instala sem pedir administrador.',
  },
  {
    title: 'Passa pelo SmartScreen',
    text: 'Se o Windows mostrar “O Windows protegeu o computador”, clica em Mais informações e depois em Executar assim mesmo. O aviso aparece porque o app é novo.',
  },
  {
    title: 'Entra com o seu convite',
    text: 'O Lorkarium abre na tela de entrada. Usa o @ e a senha que você escolheu no convite.',
  },
];
---

<SiteLayout
  title="Baixando o Lorkarium"
  description="O download do Lorkarium pra Windows começou. Veja como instalar."
  noindex
>
  <section class="py-16 md:py-24">
    <div class="site-wrap flex max-w-[880px] flex-col gap-10">
      <div class="flex flex-col gap-4">
        <span class="text-xs font-bold tracking-[0.2em] text-gold uppercase">Download</span>
        <h1 class="m-0 font-display text-[clamp(40px,5vw,60px)] leading-[1.02] font-medium tracking-[-0.01em]">
          Seu download está começando
        </h1>
        <p class="m-0 text-[17px] leading-relaxed text-muted">
          <span data-release-label>Lorkarium pra Windows 10 e 11</span>. O download não começou?
          <a href={RELEASES_PAGE_URL} data-manual-download class="font-semibold">
            Clica aqui pra baixar
          </a>
        </p>
        <p
          data-download-fallback
          role="status"
          hidden
          class="m-0 border-l-2 border-gold bg-gold/6 px-4 py-3 text-sm leading-[1.55] text-label"
        >
          Não deu pra achar a versão mais nova agora. Baixa o arquivo Lorkarium_…_x64-setup.exe pela
          página de versões no link acima.
        </p>
      </div>
      <ol aria-label="Como instalar" class="m-0 grid list-none border-t border-edge p-0">
        {installSteps.map((step, index) => (
          <li class="flex gap-6 border-b border-edge py-6">
            <span
              class="w-8 shrink-0 font-display text-5xl leading-[0.8] font-medium text-gold"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <span class="flex flex-col gap-2">
              <strong class="font-display text-2xl font-semibold">{step.title}</strong>
              <span class="text-[15px] leading-relaxed text-muted">{step.text}</span>
            </span>
          </li>
        ))}
      </ol>
      <div class="flex flex-col gap-2 text-[15px] leading-relaxed text-muted">
        <p class="m-0">
          Ainda não tem convite?{' '}
          <a href={inviteMailto(PUBLIC_CONTACT_EMAIL)} class="font-semibold">
            Pedir convite
          </a>
        </p>
        <p class="m-0">
          No Mac ou no Linux?{' '}
          <a href={`${PUBLIC_APP_URL}/login`} class="font-semibold">
            Jogue pelo navegador
          </a>
        </p>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  import { browserReleaseSource } from '@/scripts/browser-release-source';
  import { startDesktopDownload } from '@/scripts/thank-you';
  import { WindowNavigator } from '@/services/page-navigator';

  void startDesktopDownload(document, {
    source: browserReleaseSource(),
    navigator: new WindowNavigator(),
  });
</script>
