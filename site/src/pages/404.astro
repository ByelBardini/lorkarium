---
import SiteLayout from '@/layouts/site-layout.astro';
---

<SiteLayout
  title="Página não encontrada · Lorkarium"
  description="Essa página não existe no Lorkarium."
  noindex
>
  <section class="act relative isolate overflow-clip">
    <div class="site-wrap flex flex-col items-start gap-6">
      <p class="eyebrow m-0">Erro 404 · Página não encontrada</p>
      <h1 class="act-title m-0 max-w-[16ch]">Esta casa não está no mapa</h1>
      <p class="m-0 max-w-xl text-lg text-label">
        O link pode estar errado ou a página mudou de lugar.
      </p>
      <a href="/" class="font-semibold">
        Voltar para o início
      </a>
    </div>
  </section>
</SiteLayout>
