---
import ActChat from '@/components/act-chat.astro';
import ActCombat from '@/components/act-combat.astro';
import ActDice from '@/components/act-dice.astro';
import ActInitiative from '@/components/act-initiative.astro';
import ActParty from '@/components/act-party.astro';
import ActScene from '@/components/act-scene.astro';
import DownloadPanel from '@/components/download-panel.astro';
import FaqList from '@/components/faq-list.astro';
import Hero from '@/components/hero.astro';
import SiteLayout from '@/layouts/site-layout.astro';
---

<SiteLayout
  title="Lorkarium · Mapas e combate para o seu RPG"
  description="Prepare mapas e acompanhe iniciativa, pontos de vida e condições no Lorkarium. Mesa virtual de RPG com dados 3D e chat, para Windows e navegador."
>
  <Hero />
  <ActScene />
  <ActParty />
  <ActInitiative />
  <ActCombat />
  <ActDice />
  <ActChat />
  <DownloadPanel />
  <FaqList />
</SiteLayout>

<script>
  import { landingCopy } from '@/copy/landing-copy';
  import { visitorPlatformOf } from '@/lib/visitor-platform';
  import { browserReleaseSource } from '@/scripts/browser-release-source';
  import { enhanceDownloadCtas } from '@/scripts/download-cta';
  import { startHeroParallax } from '@/scripts/hero-parallax';
  import { REVEAL_ROOT_MARGIN, startRevealOnScroll } from '@/scripts/reveal-on-scroll';
  import { startStagedRound } from '@/scripts/staged-round';
  import { AnimationFrameScheduler } from '@/services/frame-scheduler';
  import { NavigatorLinkClipboard } from '@/services/link-clipboard';
  import { MediaQueryMotionPreference } from '@/services/motion-preference';
  import { TimeoutStepTimer } from '@/services/step-timer';
  import { browserViewportWatch } from '@/services/viewport-watch';

  const motion = new MediaQueryMotionPreference();
  startRevealOnScroll(document, {
    watch: browserViewportWatch(window, { rootMargin: REVEAL_ROOT_MARGIN }),
    motion,
  });
  startHeroParallax(document, {
    viewport: window,
    frames: new AnimationFrameScheduler(),
    watch: browserViewportWatch(window),
    motion,
  });
  startStagedRound(document, {
    encounter: landingCopy.encounter,
    timer: new TimeoutStepTimer(),
    watch: browserViewportWatch(window),
    motion,
  });

  void enhanceDownloadCtas(document, {
    source: browserReleaseSource(),
    platform: visitorPlatformOf({
      userAgent: navigator.userAgent,
      maxTouchPoints: navigator.maxTouchPoints,
    }),
    clipboard: new NavigatorLinkClipboard(),
    pageUrl: `${location.origin}/`,
  });
</script>
