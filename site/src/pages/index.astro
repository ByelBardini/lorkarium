---
import AudienceStrip from '@/components/audience-strip.astro';
import CombatShowcase from '@/components/combat-showcase.astro';
import DownloadPanel from '@/components/download-panel.astro';
import FaqList from '@/components/faq-list.astro';
import FeatureGrid from '@/components/feature-grid.astro';
import Hero from '@/components/hero.astro';
import HowItWorks from '@/components/how-it-works.astro';
import PlayShowcase from '@/components/play-showcase.astro';
import SiteLayout from '@/layouts/site-layout.astro';
---

<SiteLayout
  title="Lorkarium · Mapas e combate para o seu RPG"
  description="Prepare mapas e acompanhe iniciativa, pontos de vida e condições no Lorkarium. Mesa virtual de RPG com dados 3D e chat, para Windows e navegador."
>
  <Hero />
  <AudienceStrip />
  <FeatureGrid />
  <CombatShowcase />
  <PlayShowcase />
  <HowItWorks />
  <DownloadPanel />
  <FaqList />
</SiteLayout>

<script>
  import { visitorPlatformOf } from '@/lib/visitor-platform';
  import { browserReleaseSource } from '@/scripts/browser-release-source';
  import { enhanceDownloadCtas } from '@/scripts/download-cta';
  import { NavigatorLinkClipboard } from '@/services/link-clipboard';

  void enhanceDownloadCtas(document, {
    source: browserReleaseSource(),
    platform: visitorPlatformOf({
      userAgent: navigator.userAgent,
      maxTouchPoints: navigator.maxTouchPoints,
    }),
    clipboard: new NavigatorLinkClipboard(),
    pageUrl: `${location.origin}/`,
  });
</script>
