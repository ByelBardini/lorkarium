---
interface Props {
  kicker: string;
  title: string;
  /** Tag of the title; the hero owns the only h1. */
  level?: 'h2' | 'h3';
}

const { kicker, title, level: Title = 'h2' } = Astro.props;
---

<div class="flex max-w-160 flex-col gap-3.5">
  <span class="text-xs font-bold tracking-[0.2em] text-gold uppercase">{kicker}</span>
  <Title class="m-0 font-display text-[clamp(36px,5vw,48px)] leading-[1.05] font-medium tracking-[-0.01em]">
    {title}
  </Title>
  {Astro.slots.has('default') && (
    <p class="m-0 text-[17px] leading-relaxed text-muted">
      <slot />
    </p>
  )}
</div>
