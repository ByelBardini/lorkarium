---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** The caption of the fake window bar, as the desktop app titles itself. */
  windowTitle: string;
  sizes: string;
  eager?: boolean;
}

const { image, alt, windowTitle, sizes, eager = false } = Astro.props;
---

<figure class="m-0 overflow-hidden rounded-sm border border-edge-strong bg-surface-deep">
  <div
    class="flex h-9 items-center gap-2.5 border-b border-[#1f2329] bg-band px-3.5"
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 120 120"
      width="14"
      height="14"
      fill="none"
      stroke="currentColor"
      stroke-width="9"
      stroke-linejoin="round"
      class="text-gold"
    >
      <path d="M60 9 L78 42 L60 99 L42 42 Z"></path>
    </svg>
    <span class="truncate text-xs text-faint">{windowTitle}</span>
    <span class="flex-1"></span>
    <span class="h-px w-2.5 bg-[#6f7480]"></span>
    <span class="size-2.25 border border-[#6f7480]"></span>
    <span class="text-[13px] leading-none text-[#6f7480]">×</span>
  </div>
  <Picture
    src={image}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[640, 960, 1440, image.width]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    class="block h-auto w-full"
  />
</figure>
