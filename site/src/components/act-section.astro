---
import ActHeading from '@/components/act-heading.astro';
import { type ActId, actById } from '@/copy/landing-copy';

interface Props {
  id: ActId;
  /** `band` darkens the act, to break the rhythm between two acts on the page colour. */
  tone?: 'page' | 'band';
}

const { id, tone = 'page' } = Astro.props;
const act = actById(id);
// With an `aside` slot the act splits in two columns from the heading down, so a tall piece (the
// tracker) sits beside the title instead of leaving the space under the heading empty.
const hasAside = Astro.slots.has('aside');
---

<section
  id={act.id}
  class:list={[
    'act relative isolate overflow-clip border-t border-edge',
    tone === 'band' && 'bg-band',
  ]}
>
  <div
    class:list={[
      'site-wrap',
      hasAside &&
        'grid items-start gap-[clamp(40px,5vw,96px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,520px)]',
    ]}
  >
    <div>
      <div data-reveal>
        <ActHeading numeral={act.numeral} title={act.title}>
          {act.lead}
        </ActHeading>
      </div>
      <div class="mt-[clamp(48px,6vw,80px)]">
        <slot />
      </div>
    </div>
    {hasAside && (
      <div data-act-aside data-reveal="2">
        <slot name="aside" />
      </div>
    )}
  </div>
</section>
