---
import FeaturePreview from '@/components/feature-preview.astro';
import SectionHeading from '@/components/section-heading.astro';
import { landingCopy } from '@/copy/landing-copy';

const featureGroups = [
  { title: 'Prepare o cenário', kind: 'board' as const, indices: [0, 4, 5] },
  { title: 'Conduza o combate', kind: 'combat' as const, indices: [1, 2, 3] },
  { title: 'Jogue com o grupo', kind: 'play' as const, indices: [6, 7, 8] },
];
---

<section id="recursos" class="py-20 md:pt-28 md:pb-24">
  <div class="site-wrap flex flex-col gap-12 lg:gap-16">
    <SectionHeading kicker="Recursos" title="Do mapa à ordem de iniciativa">
      Use seus próprios mapas, defina os recursos dos personagens e acompanhe o que muda a cada
      turno.
    </SectionHeading>
    <div>
      {featureGroups.map((group, groupIndex) => (
        <div
          class:list={[
            'grid gap-8 border-t border-edge py-10 first:pt-8 last:pb-0 lg:gap-16 lg:py-12 xl:gap-24',
            groupIndex % 2 === 0 ? 'lg:grid-cols-[.85fr_1.5fr]' : 'lg:grid-cols-[1.5fr_.85fr]',
          ]}
        >
          <div class:list={['flex min-w-0 flex-col gap-6', groupIndex % 2 !== 0 && 'lg:order-2']}>
            <div class="flex items-baseline gap-4">
              <span class="text-xs tracking-widest text-gold" aria-hidden="true">
                0{groupIndex + 1}
              </span>
              <h3 class="m-0 font-display text-[32px] leading-tight font-medium text-parchment">
                {group.title}
              </h3>
            </div>
            <FeaturePreview kind={group.kind} />
          </div>
          <div class:list={['flex flex-col justify-center', groupIndex % 2 !== 0 && 'lg:order-1']}>
            {group.indices.map((index) => {
              const feature = landingCopy.features[index];
              if (!feature) return null;
              return (
                <article class="grid gap-3 border-edge py-6 first:pt-0 last:pb-0 [&+article]:border-t sm:grid-cols-[minmax(170px,.8fr)_1.3fr] sm:gap-6">
                  <div class="flex items-start gap-3">
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="mt-1 shrink-0 text-gold"
                      aria-hidden="true"
                    >
                      <path d={feature.icon} />
                    </svg>
                    <h4 class="m-0 font-display text-2xl leading-[1.15] font-semibold text-parchment">
                      {feature.title}
                    </h4>
                  </div>
                  <p class="m-0 max-w-[54ch] text-[15px] leading-relaxed text-muted">
                    {feature.text}
                  </p>
                </article>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
