---
import { PUBLIC_CONTACT_EMAIL } from 'astro:env/client';
import SectionHeading from '@/components/section-heading.astro';
import { inviteMailto, landingCopy } from '@/copy/landing-copy';
---

<section id="perguntas" class="pt-5 pb-20 md:pb-28">
  <div class="site-wrap flex flex-wrap gap-14">
    <div class="flex flex-[1_1_280px] flex-col gap-3.5">
      <SectionHeading kicker="Perguntas" title="Antes de baixar" />
      <p class="m-0 text-[15px] leading-relaxed text-faint">
        Para outras dúvidas, entre em contato pelo e-mail{' '}
        <a href={`mailto:${PUBLIC_CONTACT_EMAIL}`}>{PUBLIC_CONTACT_EMAIL}</a>.
      </p>
    </div>
    <div class="flex min-w-0 flex-[2_1_520px] flex-col">
      {landingCopy.faqs.map((faq, index) => (
        <details name="faq" open={index === 0} class="group border-t border-edge">
          <summary class="flex cursor-pointer list-none items-center gap-4 px-1 py-5.5 text-lg font-semibold text-parchment hover:text-gold-light [&::-webkit-details-marker]:hidden">
            <span class="flex-1">{faq.question}</span>
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
              class="shrink-0 text-gold transition-transform duration-200 group-open:rotate-45"
            >
              <path d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <p class="m-0 pr-11 pb-6 pl-1 text-[15px] leading-[1.65] text-muted">
            {faq.answer}
            {faq.invite && (
              <>
                {' '}
                <a href={inviteMailto(PUBLIC_CONTACT_EMAIL)}>Pedir convite</a>
              </>
            )}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
