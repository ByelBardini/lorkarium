---
import chatShot from '@/assets/screens/chat.png';
import diceShot from '@/assets/screens/dice.png';
import ProductShot from '@/components/product-shot.astro';
import SectionHeading from '@/components/section-heading.astro';
import { landingCopy } from '@/copy/landing-copy';

const showcases = [
  {
    id: 'dados',
    copy: landingCopy.dice,
    image: diceShot,
    alt: 'Rolagem de dados 3D sobre o mapa do Lorkarium, com fórmulas, rolagens salvas e histórico no painel Dados',
  },
  {
    id: 'chat',
    copy: landingCopy.chat,
    image: chatShot,
    alt: 'Chat do Lorkarium com conversa da mesa, fala de personagem, sussurro e resultado de uma rolagem',
  },
];
---

{showcases.map(({ id, copy, image, alt }) => (
  <section id={id} class="border-t border-edge py-20 md:py-28">
    <div class="site-wrap flex flex-col gap-10 lg:gap-14">
      <div class="grid items-end gap-7 lg:grid-cols-2 lg:gap-16">
        <SectionHeading kicker={copy.kicker} title={copy.title}>
          {copy.text}
        </SectionHeading>
        <ul class="m-0 flex list-none flex-col gap-3 p-0 text-[15px] leading-relaxed text-label">
          {copy.points.map((point) => (
            <li class="flex items-start gap-3">
              <span
                class="mt-2 size-1.75 shrink-0 rotate-45 border border-gold"
                aria-hidden="true"
              />
              {point}
            </li>
          ))}
        </ul>
      </div>
      <ProductShot
        image={image}
        alt={alt}
        windowTitle={`Lorkarium — ${copy.kicker} · Os Sinos de Vharn`}
        sizes="(min-width: 1680px) 1552px, 92vw"
      />
    </div>
  </section>
))}
