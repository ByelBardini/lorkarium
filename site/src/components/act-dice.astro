---
import { Picture } from 'astro:assets';
import diceShot from '@/assets/screens/dice.png';
import ActFeatures from '@/components/act-features.astro';
import ActPoints from '@/components/act-points.astro';
import ActSection from '@/components/act-section.astro';
import { landingCopy } from '@/copy/landing-copy';
---

<ActSection id="dados">
  <div class="grid items-start gap-[clamp(32px,5vw,96px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)]">
    <div class="flex flex-col gap-8">
      <ActFeatures act="dados" />
      <div data-reveal="2">
        <ActPoints points={landingCopy.dice.points} />
      </div>
    </div>
    <div
      data-dice-stage
      data-reveal="2"
      class="dice-felt relative aspect-[16/10] overflow-hidden rounded-sm border border-edge-strong bg-surface-deep"
    >
      <Picture
        src={diceShot}
        alt="Rolagem de dados 3D sobre o mapa do Lorkarium, com fórmulas, rolagens salvas e histórico no painel Dados"
        formats={['avif', 'webp']}
        widths={[640, 960, 1440, diceShot.width]}
        sizes="(min-width: 1024px) 60vw, 92vw"
        loading="lazy"
        data-dice-poster
        class="absolute inset-0 block size-full object-cover"
      />
      <div class="absolute inset-x-4 bottom-4 z-50 flex items-center gap-4">
        <button
          type="button"
          data-dice-roll
          hidden
          class="h-11 cursor-pointer rounded-sm bg-gold px-5 font-sans text-sm font-bold tracking-[0.08em] text-ink uppercase hover:bg-gold-hover disabled:cursor-wait disabled:opacity-60"
        >
          Rolar o d20
        </button>
        <span
          data-dice-total
          aria-live="polite"
          class="font-wordmark text-2xl font-bold text-parchment"
        ></span>
      </div>
    </div>
  </div>
</ActSection>
