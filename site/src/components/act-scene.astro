---
import boardShot from '@/assets/screens/feature-board.png';
import ActFeatures from '@/components/act-features.astro';
import ActSection from '@/components/act-section.astro';
import ActShot from '@/components/act-shot.astro';
---

<ActSection id="cena">
  <div class="grid items-start gap-[clamp(32px,5vw,96px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,560px)]">
    <ActFeatures act="cena" />
    <div data-reveal="2" class="lg:sticky lg:top-10">
      <ActShot
        image={boardShot}
        alt="Kael sendo arrastado em direção a Lyra: a trilha passa casa a casa, em diagonal e depois em linha reta, e marca 6 casas ou 9 metros"
        sizes="(min-width: 1024px) 560px, 92vw"
      />
    </div>
  </div>
</ActSection>
