---
import trackerShot from '@/assets/screens/tracker.png';
import ProductShot from '@/components/product-shot.astro';
import SectionHeading from '@/components/section-heading.astro';
import { landingCopy } from '@/copy/landing-copy';
---

<section id="combate" class="pt-10 pb-20 md:pb-28">
  <div class="site-wrap flex flex-wrap items-center gap-14">
    <div class="flex flex-[1_1_380px] flex-col gap-4.5">
      <SectionHeading kicker="Combate" title="Turnos, rodadas e condições à vista">
        O painel reúne a ordem de iniciativa, os pontos de vida e as condições dos participantes. Ao
        avançar o turno, o Lorkarium atualiza a duração dos efeitos. Se os bandidos agem na mesma
        iniciativa, você pode agrupá-los e passar a vez de todos de uma só vez.
      </SectionHeading>
      <ul class="m-0 flex list-none flex-col gap-2.5 p-0 text-[15px] text-label">
        {landingCopy.combatPoints.map((point) => (
          <li class="flex items-center gap-2.5">
            <span class="size-1.75 shrink-0 rotate-45 border border-gold" aria-hidden="true" />
            {point}
          </li>
        ))}
      </ul>
    </div>
    <div class="min-w-0 flex-[1_1_420px]">
      <ProductShot
        image={trackerShot}
        alt="O painel de combate do Lorkarium: rodada, vez atual, ordem de iniciativa com barras de vida e condições"
        windowTitle="Lorkarium — Combate"
        sizes="(min-width: 1200px) 560px, (min-width: 768px) 50vw, 100vw"
      />
    </div>
  </div>
</section>
