---
import { type ActId, actById, landingCopy } from '@/copy/landing-copy';

interface Props {
  act: ActId;
}

const features = actById(Astro.props.act).featureIndexes.flatMap((index) => {
  const feature = landingCopy.features[index];
  return feature ? [feature] : [];
});
---

<ul class="m-0 grid list-none border-t border-edge p-0">
  {features.map((feature, index) => (
    <li
      data-reveal={String(Math.min(index + 1, 3))}
      class="grid grid-cols-[40px_1fr] gap-4.5 border-b border-edge py-6.5 sm:grid-cols-[56px_1fr]"
    >
      <svg
        width="26"
        height="26"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mt-0.5 text-gold"
        aria-hidden="true"
      >
        <path d={feature.icon} />
      </svg>
      <div>
        <h3 class="m-0 font-wordmark text-[19px] font-semibold tracking-[0.04em] text-parchment">
          {feature.title}
        </h3>
        <p class="m-0 mt-2 max-w-[60ch] text-base leading-relaxed text-muted">{feature.text}</p>
      </div>
    </li>
  ))}
</ul>
