---
import SectionHeading from '@/components/section-heading.astro';
import { landingCopy } from '@/copy/landing-copy';
---

<section id="como" class="border-y border-line bg-band py-20 md:py-28">
  <div class="site-wrap flex flex-col gap-12">
    <SectionHeading kicker="Como funciona" title="Do download à primeira rolagem em minutos" />
    <ol class="m-0 grid list-none border-t border-edge p-0 md:grid-cols-3">
      {landingCopy.steps.map((step, index) => (
        <li class="flex flex-col gap-3 border-edge pt-8 pb-2 max-md:[&+li]:border-t md:pr-10 md:[&+li]:border-l md:[&+li]:pl-10">
          <span
            class="font-display text-[64px] leading-[0.8] font-medium text-gold"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <h3 class="m-0 mt-2 font-display text-[28px] font-semibold">{step.title}</h3>
          <p class="m-0 max-w-[42ch] text-[15px] leading-relaxed text-muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
