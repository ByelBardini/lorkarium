---
import { PUBLIC_APP_URL } from 'astro:env/client';
import BrandWordmark from '@/components/brand-wordmark.astro';
import DownloadCta from '@/components/download-cta.astro';

const anchors: ReadonlyArray<{ label: string; href: string }> = [
  { label: 'Recursos', href: '/#recursos' },
  { label: 'Como funciona', href: '/#como' },
  { label: 'Perguntas', href: '/#perguntas' },
];
const loginUrl = new URL('/login', PUBLIC_APP_URL).href;
const navLinkClass = 'text-sm font-medium text-muted hover:text-parchment';
---

<header class="relative z-10 border-b border-line">
  <div class="site-wrap flex min-h-18 items-center gap-4 py-2.5 md:gap-7">
    <a href="/#topo" aria-label="Lorkarium, início" class="inline-flex">
      <BrandWordmark />
    </a>
    <nav aria-label="Principal" class="hidden gap-6.5 md:flex">
      {anchors.map(({ label, href }) => (
        <a href={href} class={navLinkClass}>
          {label}
        </a>
      ))}
    </nav>
    <span class="flex-1"></span>
    <a href={loginUrl} class:list={['hidden sm:inline', navLinkClass]}>
      Já tenho conta
    </a>
    <DownloadCta size="small" label="Baixar" />
  </div>
</header>
