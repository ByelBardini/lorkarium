---
import { getCollection } from 'astro:content';
import { PUBLIC_APP_URL } from 'astro:env/client';
import { GUIDE_DRAFTS_ALLOWED } from 'astro:env/server';
import BrandWordmark from '@/components/brand-wordmark.astro';
import DownloadCta from '@/components/download-cta.astro';
import { signUpUrlOf } from '@/copy/landing-copy';
import { guideNavLinksOf } from '@/lib/guides';

const anchors: ReadonlyArray<{ label: string; href: string }> = [
  { label: 'A sessão', href: '/#cena' },
  { label: 'Combate', href: '/#combate' },
  { label: 'Perguntas', href: '/#perguntas' },
  { label: 'Planos', href: '/planos/' },
  ...guideNavLinksOf(await getCollection('guides'), GUIDE_DRAFTS_ALLOWED),
];
const loginUrl = new URL('/login', PUBLIC_APP_URL).href;
const navLinkClass = 'text-sm font-medium tracking-[0.02em] text-label hover:text-gold-light';
---

<header class="relative z-10 border-b border-parchment/7">
  <div class="site-wrap flex min-h-18 items-center gap-4 py-2.5 md:gap-7">
    <a href="/#topo" aria-label="Lorkarium, início" class="inline-flex">
      <BrandWordmark />
    </a>
    <nav aria-label="Principal" class="ml-auto hidden gap-6 md:flex">
      {anchors.map(({ label, href }) => (
        <a href={href} class={navLinkClass}>
          {label}
        </a>
      ))}
    </nav>
    <span class="flex-1"></span>
    <a href={loginUrl} class:list={['hidden sm:inline', navLinkClass]}>
      Já tenho conta
    </a>
    <a
      href={signUpUrlOf(PUBLIC_APP_URL)}
      class="hidden h-9 items-center rounded-sm border border-gold/60 px-3.5 text-[13px] font-bold tracking-[0.08em] whitespace-nowrap text-gold-light uppercase transition-colors hover:border-gold hover:text-parchment sm:inline-flex"
    >
      Criar conta
    </a>
    <DownloadCta size="small" label="Baixar" />
  </div>
</header>
