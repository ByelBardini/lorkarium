---
import chatShot from '@/assets/screens/chat.png';
import ActFeatures from '@/components/act-features.astro';
import ActPoints from '@/components/act-points.astro';
import ActSection from '@/components/act-section.astro';
import ActShot from '@/components/act-shot.astro';
import { landingCopy } from '@/copy/landing-copy';
---

<ActSection id="chat" tone="band">
  <div class="grid items-start gap-[clamp(32px,5vw,96px)] lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
    <div data-reveal="2">
      <ActShot
        image={chatShot}
        alt="Chat do Lorkarium com conversa da mesa, fala de personagem, sussurro e resultado de uma rolagem"
        sizes="(min-width: 1024px) 60vw, 92vw"
      />
    </div>
    <div class="flex flex-col gap-8">
      <ActFeatures act="chat" />
      <div data-reveal="2">
        <ActPoints points={landingCopy.chat.points} />
      </div>
    </div>
  </div>
</ActSection>
