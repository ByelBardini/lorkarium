---
import LogoMark from '@lorkarium/brand/logo-mark.svg';
import DownloadCta from '@/components/download-cta.astro';
import HeroScene from '@/components/hero-scene.astro';
import PlatformNote from '@/components/platform-note.astro';
import ReleaseMeta from '@/components/release-meta.astro';
import SecondaryLink from '@/components/secondary-link.astro';
---

<section
  id="topo"
  class="relative isolate -mt-18 flex min-h-[max(640px,100svh)] items-end overflow-clip"
>
  <div class="absolute inset-0 -z-10">
    <HeroScene />
    <div class="hero-shade absolute inset-0"></div>
    <LogoMark
      aria-hidden="true"
      data-parallax-depth="0.6"
      class="absolute top-[18%] right-[6%] w-[clamp(120px,16vw,260px)] text-gold opacity-16"
    />
  </div>
  <div class="site-wrap pt-30 pb-[clamp(56px,9vh,110px)]">
    <p class="eyebrow m-0 mb-5.5">Mesa virtual para RPG</p>
    <h1 class="headline m-0 max-w-[19ch]">
      <span class="block text-ember">Role a iniciativa.</span>{' '}
      <span class="block text-parchment">E que comece o combate.</span>
    </h1>
    <p class="mt-6.5 mb-0 max-w-140 text-[clamp(17px,1.4vw,20px)] leading-relaxed text-label">
      Mapas, iniciativa, pontos de vida e condições num só lugar, enquanto o grupo joga.{' '}
      <em class="font-display text-[1.22em] text-gold-light">
        O mestre conduz; o Lorkarium faz as contas.
      </em>
    </p>
    <div class="mt-8.5 flex flex-wrap items-center gap-3.5">
      <DownloadCta />
      <SecondaryLink href="#cena">Ver uma sessão</SecondaryLink>
    </div>
    <div class="mt-4 flex flex-col gap-3">
      <ReleaseMeta />
      <PlatformNote />
    </div>
  </div>
</section>
