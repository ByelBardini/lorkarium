---
import type { Crumb } from '@/lib/structured-data';

interface Props {
  /** The same trail the BreadcrumbList publishes, from the home page to this page. */
  crumbs: readonly Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Trilha" class="text-sm text-faint">
  <ol class="m-0 flex list-none flex-wrap items-center gap-2 p-0">
    {crumbs.map((crumb, index) => {
      const isLast = index === crumbs.length - 1;
      return (
        <li class="flex items-center gap-2">
          {isLast ? (
            <span aria-current="page" class="text-label">
              {crumb.name}
            </span>
          ) : (
            <>
              <a href={crumb.path} class="text-faint hover:text-gold-light">
                {crumb.name}
              </a>
              <span aria-hidden="true">›</span>
            </>
          )}
        </li>
      );
    })}
  </ol>
</nav>
