<svg
  class={svgClass}
  data-parallax-depth="0.3"
  data-scene-layer
  data-scene-tokens
  viewBox="0 0 1600 1000"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  font-family="Hanken Grotesk Variable, system-ui, sans-serif"
>
  {ogre && kael && dragOrigin && (
    <Fragment>
      <path
        data-drag-trail
        d={dragTrail}
        fill="none"
        stroke="#c5a46d"
        stroke-width="8"
        stroke-opacity=".3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      {dragRuns.map((run) => (
        <path
          d={run.map(({ cx, cy }, index) => `${index === 0 ? 'M' : 'L'}${cx} ${cy}`).join(' ')}
          fill="none"
          stroke="#c5a46d"
          stroke-width="3"
          stroke-dasharray="10 8"
          stroke-linecap="round"
        />
      ))}
      <circle
        cx={dragOrigin.cx}
        cy={dragOrigin.cy}
        r="9"
        fill="none"
        stroke="#c5a46d"
        stroke-width="2.5"
      />
      <text
        data-drag-label
        x={kael.cx + 38}
        y={kael.cy - 32}
        font-size="17"
        fill="#d5d0c4"
        stroke="#0a0b0e"
        stroke-width="4"
        paint-order="stroke"
      >
        {dragLabel}
      </text>
      <circle
        cx={ogre.cx}
        cy={ogre.cy}
        r={ogre.r + 14}
        fill="none"
        stroke="#c5a46d"
        stroke-width="5"
      />
    </Fragment>
  )}
  {placed.map(({ label, side, cx, cy, r, hp, size }) => (
    <g data-scene-token={label} data-token-size={size}>
      <circle cx={cx} cy={cy} r={r + 4} fill="#0a0b0e" opacity=".5" transform="translate(3 5)" />
      <circle
        data-token-body
        cx={cx}
        cy={cy}
        r={r}
        fill="#16181d"
        stroke={ringOf[side]}
        stroke-width="4"
      />
      <path
        d={`M${cx + r + 3} ${cy - 6} L${cx + r + 11} ${cy} L${cx + r + 3} ${cy + 6} Z`}
        fill={ringOf[side]}
        opacity=".9"
      />
      <text
        x={cx}
        y={cy}
        dy=".36em"
        text-anchor="middle"
        font-size={Math.round(r * 0.78)}
        font-weight="600"
        fill="#eae5da"
      >
        {label}
      </text>
      <rect
        x={cx - r}
        y={cy + r + 8}
        width={r * 2}
        height="7"
        rx="3"
        fill="#0c0e11"
        opacity=".85"
      />
      <rect
        x={cx - r}
        y={cy + r + 8}
        width={Math.round(r * 2 * hp)}
        height="7"
        rx="3"
        fill="#c9705a"
      />
    </g>
  ))}
</svg>
