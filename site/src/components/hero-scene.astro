---
import { type SceneToken, sceneCenterOf } from '@/lib/hero-scene';

// The demo table "Os Sinos de Vharn" at round 3. The scene shows only what the board draws
// (docs/context/site.md, Direção visual): tokens sit in their cells, the turn ring does not pulse.
const tokens: readonly SceneToken[] = [
  { label: 'OC', side: 'foe', col: 18, row: 6, size: 2, hp: 0.6 },
  { label: 'KA', side: 'party', col: 16, row: 10, size: 1, hp: 0.84 },
  { label: 'LY', side: 'party', col: 15, row: 12, size: 1, hp: 0.81 },
  { label: 'TH', side: 'party', col: 14, row: 11, size: 1, hp: 0.19 },
  { label: 'B1', side: 'foe', col: 21, row: 9, size: 1, hp: 0.7 },
  { label: 'B2', side: 'foe', col: 17, row: 12, size: 1, hp: 0.5 },
  { label: 'B3', side: 'foe', col: 17, row: 4, size: 1, hp: 0.9 },
  { label: 'B4', side: 'foe', col: 23, row: 11, size: 1, hp: 0.6 },
  { label: 'B5', side: 'foe', col: 20, row: 3, size: 1, hp: 0.8 },
  { label: 'B6', side: 'foe', col: 20, row: 13, size: 1, hp: 0.4 },
];
const ringOf = { party: '#eae5da', foe: '#c9705a' } as const;
const placed = tokens.map((token) => ({
  ...token,
  ...sceneCenterOf(token),
  r: token.size === 1 ? 26 : 58,
}));
const ogre = placed[0];
const kael = placed[1];
// Kael's drag, cell by cell as the board's trail draws it (origin first, Kael's cell last): a
// diagonal then a straight step, so the dashes restart at the bend like on the board.
const dragCells = [
  { col: 13, row: 8 },
  { col: 14, row: 9 },
  { col: 15, row: 10 },
  { col: 16, row: 10 },
].map((cell) => sceneCenterOf({ ...cell, size: 1 }));
const dragOrigin = dragCells[0];
const dragTrail = dragCells
  .map(({ cx, cy }, index) => `${index === 0 ? 'M' : 'L'}${cx} ${cy}`)
  .join(' ');
const dragRuns = dragCells.slice(1).reduce<{ cx: number; cy: number }[][]>((runs, cell, index) => {
  const from = dragCells[index] ?? cell;
  const run = runs.at(-1);
  const last = run?.at(-1);
  const before = run?.at(-2);
  const sameWay =
    last &&
    before &&
    cell.cx - last.cx === last.cx - before.cx &&
    cell.cy - last.cy === last.cy - before.cy;
  if (run && sameWay) run.push(cell);
  else runs.push([from, cell]);
  return runs;
}, []);
const dragSteps = dragCells.length - 1;
const dragLabel = `${dragSteps} casas · ${String(dragSteps * 1.5).replace('.', ',')} m`;
const svgClass =
  'absolute -inset-y-[8%] -inset-x-[4%] h-[116%] w-[108%] max-sm:right-[-10%] max-sm:left-[-190%] max-sm:w-auto max-sm:h-[112%] max-sm:-inset-y-[6%]';
---

