---
import DownloadIcon from '@/components/download-icon.astro';

interface Props {
  size?: 'large' | 'small';
  label?: string;
}

const { size = 'large', label = 'Baixar para Windows' } = Astro.props;
const sizeClass = size === 'large' ? 'h-13 gap-2.5 px-6 text-base' : 'h-10 gap-2 px-4 text-sm';
---

<a
  href="/obrigado/"
  data-download-cta
  class:list={[
    'inline-flex items-center justify-center rounded-sm bg-gold font-bold whitespace-nowrap text-ink transition-colors hover:bg-gold-hover',
    sizeClass,
  ]}
>
  <DownloadIcon size={size === 'large' ? 20 : 16} />
  {label}
</a>
