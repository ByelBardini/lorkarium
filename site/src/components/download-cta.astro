---
import DownloadIcon from '@/components/download-icon.astro';

interface Props {
  size?: 'large' | 'small';
  label?: string;
}

const { size = 'large', label = 'Baixar para Windows' } = Astro.props;
const sizeClass =
  size === 'large'
    ? 'h-15 gap-3 px-7 text-[15px] tracking-[0.12em] font-extrabold hover:-translate-y-0.5'
    : 'h-9 gap-2 px-3.5 text-[13px] tracking-[0.08em] font-bold';
---

<a
  href="/obrigado/"
  data-download-cta
  class:list={[
    'inline-flex items-center justify-center rounded-sm bg-gold whitespace-nowrap text-ink uppercase transition hover:bg-gold-hover',
    sizeClass,
  ]}
>
  <DownloadIcon size={size === 'large' ? 20 : 16} />
  {label}
</a>
