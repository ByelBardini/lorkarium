---
import faviconUrl from '@lorkarium/brand/favicon.svg?url';
import SiteFooter from '@/components/site-footer.astro';
import SiteHeader from '@/components/site-header.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
if (!Astro.site) {
  throw new Error(
    `Astro.site is ${String(Astro.site)}; expected SITE_URL like https://lorkarium.com.br`,
  );
}
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL('/og.png', Astro.site).href;
const softwareApplication = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Lorkarium',
  applicationCategory: 'GameApplication',
  operatingSystem: 'Windows 10, Windows 11',
  url: Astro.site.href,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
};
// `<` escaped so no value can close the data block early.
const structuredData = JSON.stringify(softwareApplication).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0b0e" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Lorkarium" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={structuredData} />
  </head>
  <body class="flex min-h-screen flex-col overflow-x-clip">
    <a
      href="#conteudo"
      class="sr-only rounded-sm bg-gold px-4 py-2 font-semibold text-ink focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-20"
    >
      Pular para o conteúdo
    </a>
    <SiteHeader />
    <main id="conteudo" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
