---
// Same file the CSS @font-face loads, so the preload and the font share one hashed URL.
import cinzelLatinUrl from '@fontsource-variable/cinzel/files/cinzel-latin-wght-normal.woff2?url';
import heroShot from '@/assets/screens/hero.png';
import SiteFooter from '@/components/site-footer.astro';
import SiteHeader from '@/components/site-header.astro';
import { siteGraphOf, type Crumb, type Offer, type SchemaNode } from '@/lib/structured-data';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** A site path under `public/`, like `/og-recursos.png` (1200×630). */
  ogImage?: string;
  ogImageAlt?: string;
  /** The trail from the home page, for the BreadcrumbList. */
  crumbs?: readonly Crumb[];
  /** Offers beyond the free plan. */
  offers?: readonly Offer[];
  /** JSON-LD nodes only this page has (its FAQPage). */
  structuredData?: readonly SchemaNode[];
}

const DEFAULT_OG_IMAGE_ALT = 'Mapas e combate para o seu RPG';
const {
  title,
  description,
  noindex = false,
  ogImage = '/og.png',
  ogImageAlt = DEFAULT_OG_IMAGE_ALT,
  crumbs = [],
  offers = [],
  structuredData = [],
} = Astro.props;
if (!ogImage.startsWith('/') || ogImage.startsWith('//')) {
  throw new Error(`ogImage is ${JSON.stringify(ogImage)}; expected a site path like /og.png`);
}
if (!Astro.site) {
  throw new Error(
    `Astro.site is ${String(Astro.site)}; expected SITE_URL like https://lorkarium.com.br`,
  );
}
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const graph = siteGraphOf({
  site: Astro.site,
  path: Astro.url.pathname,
  page: { title, description },
  screenshot: heroShot.src,
  crumbs,
  offers,
  extraNodes: structuredData,
});
// `<` escaped so no value can close the data block early.
const graphJson = JSON.stringify(graph).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0b0e" />
    {/* Stable crawlable URLs: Google shows the result icon only from a fetchable file. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Every h1 is in Cinzel: fetching it with the HTML keeps the LCP text from swapping late. */}
    <link rel="preload" as="font" type="font/woff2" href={cinzelLatinUrl} crossorigin />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Lorkarium" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={graphJson} />
  </head>
  <body class="flex min-h-screen flex-col overflow-x-clip">
    <a
      href="#conteudo"
      class="sr-only rounded-sm bg-gold px-4 py-2 font-semibold text-ink focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-20"
    >
      Pular para o conteúdo
    </a>
    <SiteHeader />
    <main id="conteudo" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
