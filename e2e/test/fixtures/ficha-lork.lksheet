{
  "format": "lorkarium.sheet-template",
  "formatVersion": 2,
  "exportedAt": "2026-11-10T00:00:00.000Z",
  "name": "Ficha de Lork",
  "files": [
    {
      "path": "index.html",
      "content": "<aside class=\"rail\" aria-label=\"Ficha\">\n  <div class=\"brand\"><span>Lork's Tales</span></div>\n  <div class=\"who\">\n    <div class=\"who-img\" id=\"who-img\"></div>\n    <div>\n      <div class=\"who-name\" id=\"who-name\">Sem nome</div>\n      <div class=\"who-sub\" id=\"who-sub\">Raça · Classe</div>\n    </div>\n  </div>\n  <div class=\"mini\" id=\"mini\"></div>\n  <div class=\"mini-stats\" id=\"mini-stats\"></div>\n  <nav class=\"nav\" id=\"nav\" role=\"tablist\" aria-label=\"Seções da ficha\"></nav>\n  <nav class=\"nav nav-foot\" id=\"nav-foot\" role=\"tablist\" aria-label=\"Regras do sistema\"></nav>\n  <div class=\"rail-foot\"><span class=\"status\" role=\"status\"></span></div>\n</aside>\n<main class=\"content\" id=\"main\">\n  <div class=\"page\" id=\"pg-perfil\" role=\"tabpanel\" aria-label=\"Perfil\"></div>\n  <div class=\"page\" id=\"pg-origem\" role=\"tabpanel\" aria-label=\"Origem\"></div>\n  <div class=\"page\" id=\"pg-atributos\" role=\"tabpanel\" aria-label=\"Atributos\"></div>\n  <div class=\"page\" id=\"pg-pericias\" role=\"tabpanel\" aria-label=\"Perícias\"></div>\n  <div class=\"page\" id=\"pg-habilidades\" role=\"tabpanel\" aria-label=\"Habilidades\"></div>\n  <div class=\"page\" id=\"pg-inventario\" role=\"tabpanel\" aria-label=\"Inventário\"></div>\n  <div class=\"page\" id=\"pg-anotacoes\" role=\"tabpanel\" aria-label=\"Anotações\"></div>\n  <div class=\"page\" id=\"pg-historia\" role=\"tabpanel\" aria-label=\"História\"></div>\n  <div class=\"page\" id=\"pg-regras\" role=\"tabpanel\" aria-label=\"Regras\">\n    <lk-include src=\"paginas/regras.html\"></lk-include>\n  </div>\n</main>\n<div id=\"rtbar\" role=\"toolbar\" aria-label=\"Formatação do texto\"></div>\n"
    },
    {
      "path": "paginas/regras.html",
      "content": "<header>\n  <p class=\"eyebrow\">Regras</p>\n  <h1 class=\"h1\">Regras</h1>\n</header>\n<section class=\"blk first\">\n  <h2 class=\"h2\">Lvl Up</h2>\n  <!-- data-every: o nível que ganha a regra é múltiplo deste número; data-odd/data-even só ímpar/par -->\n  <ul class=\"rules\" id=\"level-rules\">\n    <li style=\"--c: var(--moss-l)\" data-every=\"1\">\n      <b>Todo nível</b><span>sua barra máxima de Estresse (ES) sobe em 2.</span>\n    </li>\n    <li style=\"--c: var(--gold-l)\" data-odd>\n      <b>Todo nível ímpar</b\n      ><span\n        >você recebe +1 em um atributo, sem poder escolher o mesmo atributo duas vezes\n        seguidas.</span\n      >\n    </li>\n    <li style=\"--c: var(--gold-l)\" data-even>\n      <b>Todo nível par</b\n      ><span\n        >você pode aumentar a base de uma barra em 1, sem poder repetir a mesma barra duas vezes\n        seguidas.</span\n      >\n    </li>\n    <li style=\"--c: var(--amber)\" data-every=\"3\">\n      <b>Cada nível múltiplo de 3</b\n      ><span>você pode criar uma habilidade nova e upar uma que já possua.</span>\n    </li>\n    <li style=\"--c: var(--ember-l)\" data-every=\"4\">\n      <b>Cada nível múltiplo de 4</b><span>seu bônus de treino aumenta em 1.</span>\n    </li>\n    <li style=\"--c: var(--violet)\" data-every=\"5\">\n      <b>Cada nível múltiplo de 5</b><span>sua Classe e seu Original recebem um up.</span>\n    </li>\n    <li style=\"--c: var(--steel-l)\" data-every=\"10\">\n      <b>Cada nível múltiplo de 10</b><span>sua Raça recebe um up.</span>\n    </li>\n  </ul>\n  <div class=\"next-lv\" id=\"next-lv\"></div>\n</section>\n<section class=\"blk\">\n  <h2 class=\"h2\">Levantar aliado caído</h2>\n  <!-- data-share: quanto da vida máxima abaixo de zero marca a faixa -->\n  <ul class=\"rules fall\" id=\"fall\">\n    <li style=\"--c: #7fbf93\" data-fall=\"0\" data-share=\"0\">\n      <b>0% da vida máxima</b><span class=\"thr\"></span\n      ><span>Consegue levantar com uma ação padrão.</span\n      ><span class=\"here-tag\">Você está aqui</span>\n    </li>\n    <li style=\"--c: var(--moss-l)\" data-fall=\"1\" data-share=\"0.05\">\n      <b>−5% da vida máxima</b><span class=\"thr\"></span\n      ><span>Um aliado pode gastar uma ação padrão pra te levantar.</span\n      ><span class=\"here-tag\">Você está aqui</span>\n    </li>\n    <li style=\"--c: var(--gold-l)\" data-fall=\"2\" data-share=\"0.10\">\n      <b>−10% da vida máxima</b><span class=\"thr\"></span\n      ><span>Um teste de Medicina de dificuldade 10, aumentando em 3 a cada vez que cair.</span\n      ><span class=\"here-tag\">Você está aqui</span>\n    </li>\n    <li style=\"--c: var(--amber)\" data-fall=\"3\" data-share=\"0.40\">\n      <b>−40% da vida máxima</b><span class=\"thr\"></span\n      ><span>Um teste de Medicina de dificuldade 15, aumentando em 5 a cada vez que cair.</span\n      ><span class=\"here-tag\">Você está aqui</span>\n    </li>\n    <li style=\"--c: var(--ember-l)\" data-fall=\"4\" data-share=\"0.70\">\n      <b>−70% da vida máxima</b><span class=\"thr\"></span\n      ><span>Um teste de Medicina de dificuldade 20, aumentando em 5 a cada vez que cair.</span\n      ><span class=\"here-tag\">Você está aqui</span>\n    </li>\n  </ul>\n</section>\n<section class=\"blk\">\n  <h2 class=\"h2\">Descanso</h2>\n  <!-- data-bars: quanto do máximo cada barra recupera; data-stress: quanto do máximo o estresse (ES) desce -->\n  <div class=\"rest-grid\">\n    <div class=\"rest\">\n      <h3>Descanso curto</h3>\n      <p>Um descanso curto é feito quando você tem <b>um dia</b> inteiro de descanso.</p>\n      <div class=\"rest-opt\" style=\"--c: var(--ember-l)\">\n        <p>\n          <b>Lugar ruim:</b> regenera <b>20%</b> de todas as barras e seu estresse desce\n          <b>10%</b> do máximo.\n        </p>\n        <button\n          type=\"button\"\n          class=\"btn-rest\"\n          data-rest=\"Descanso curto em lugar ruim\"\n          data-bars=\"0.2\"\n          data-stress=\"0.1\"\n          aria-label=\"Descansar: curto em lugar ruim\"\n        >\n          Descansar\n        </button>\n      </div>\n      <div class=\"rest-opt\" style=\"--c: var(--moss-l)\">\n        <p>\n          <b>Lugar confortável:</b> regenera <b>50%</b> de todas as barras e seu estresse desce\n          <b>20%</b> do máximo.\n        </p>\n        <button\n          type=\"button\"\n          class=\"btn-rest\"\n          data-rest=\"Descanso curto em lugar confortável\"\n          data-bars=\"0.5\"\n          data-stress=\"0.2\"\n          aria-label=\"Descansar: curto em lugar confortável\"\n        >\n          Descansar\n        </button>\n      </div>\n      <p class=\"rest-note\">\n        Você pode fazer no máximo <b>5 descansos curtos</b> antes de fazer um descanso longo.\n      </p>\n    </div>\n    <div class=\"rest\">\n      <h3>Descanso longo</h3>\n      <p>Um descanso longo é feito quando você tem <b>uma semana</b> inteira de descanso.</p>\n      <div class=\"rest-opt\" style=\"--c: var(--ember-l)\">\n        <p>\n          <b>Lugar ruim:</b> regenera <b>100%</b> de todas as barras e seu estresse desce\n          <b>25%</b> do máximo.\n        </p>\n        <button\n          type=\"button\"\n          class=\"btn-rest\"\n          data-rest=\"Descanso longo em lugar ruim\"\n          data-bars=\"1\"\n          data-stress=\"0.25\"\n          aria-label=\"Descansar: longo em lugar ruim\"\n        >\n          Descansar\n        </button>\n      </div>\n      <div class=\"rest-opt\" style=\"--c: var(--moss-l)\">\n        <p>\n          <b>Lugar confortável:</b> regenera <b>100%</b> de todas as barras e seu estresse desce\n          <b>50%</b> do máximo.\n        </p>\n        <button\n          type=\"button\"\n          class=\"btn-rest\"\n          data-rest=\"Descanso longo em lugar confortável\"\n          data-bars=\"1\"\n          data-stress=\"0.5\"\n          aria-label=\"Descansar: longo em lugar confortável\"\n        >\n          Descansar\n        </button>\n      </div>\n    </div>\n  </div>\n  <p class=\"use-msg rest-msg\" id=\"rest-msg\" role=\"status\"></p>\n</section>\n"
    },
    {
      "path": "estilo/fontes.css",
      "content": "/* As fontes vêm junto do modelo (assets do .lksheet): o frame da ficha não tem rede.\n   Hanken Grotesk, Cormorant Garamond e Cinzel são as da marca (OFL), recorte latino.\n   A JetBrains Mono do protótipo não vem: as fórmulas usam a mono do sistema. */\n@font-face {\n  font-family: 'Hanken Grotesk';\n  font-style: normal;\n  font-weight: 100 900;\n  font-display: swap;\n  src: url('asset:fontes/hanken-grotesk.woff2') format('woff2');\n}\n@font-face {\n  font-family: 'Cormorant Garamond';\n  font-style: normal;\n  font-weight: 300 700;\n  font-display: swap;\n  src: url('asset:fontes/cormorant-garamond.woff2') format('woff2');\n}\n@font-face {\n  font-family: 'Cormorant Garamond';\n  font-style: italic;\n  font-weight: 300 700;\n  font-display: swap;\n  src: url('asset:fontes/cormorant-garamond-italic.woff2') format('woff2');\n}\n@font-face {\n  font-family: 'Cinzel';\n  font-style: normal;\n  font-weight: 400 900;\n  font-display: swap;\n  src: url('asset:fontes/cinzel.woff2') format('woff2');\n}\n"
    },
    {
      "path": "estilo/ficha.css",
      "content": "/* Layout: trilho escuro à esquerda (marca, personagem, barras, seções) e a página da seção alinhada à esquerda.\n   Tokens do Lorkarium: um acento só (o dourado), raio de 4px, sem sombra nem gradiente, serifa só em título.\n   Número sempre na grotesca (os algarismos da Cormorant são de texto e o 0 vira \"o\"). */\n:root {\n  --panel: #0c0e11;\n  --bg: #101216;\n  --card: #15181d;\n  --muted: #1b1f25;\n  --fg: #eae5da;\n  --label: #d5d0c4;\n  --dim: #a9a497;\n  --ph: #8a8f99;\n  --gold: #c5a46d;\n  --gold-h: #d4b57e;\n  --gold-l: #e2c793;\n  --input: #303640;\n  --border: #23272e;\n  --divider: #262b33;\n  --ember-l: #e6a28f;\n  --moss-l: #a9d1b4;\n  --steel-l: #aebcd6;\n  --violet: #b29ad6;\n  --amber: #e0a05a;\n  --err: #d0806a;\n  --sans: 'Hanken Grotesk', system-ui, sans-serif;\n  --display: 'Cormorant Garamond', Georgia, serif;\n  --brand: 'Cinzel', Georgia, serif;\n  --mono: ui-monospace, 'Cascadia Mono', Consolas, monospace;\n  --rail: 248px;\n  color-scheme: dark;\n}\n* {\n  box-sizing: border-box;\n}\n/* body cresce com o conteúdo: com height:100% o trilho sticky saía junto no scroll */\nhtml {\n  height: 100%;\n}\nbody {\n  margin: 0;\n  min-height: 100%;\n  display: grid;\n  grid-template-columns: var(--rail) minmax(0, 1fr);\n  background: var(--bg);\n  color: var(--fg);\n  font: 400 15px/1.55 var(--sans);\n}\n@media (prefers-reduced-motion: reduce) {\n  * {\n    transition: none !important;\n  }\n}\nbutton {\n  font: inherit;\n  color: inherit;\n  cursor: pointer;\n}\nbutton:disabled,\ninput:disabled,\nselect:disabled {\n  cursor: default;\n}\n/* display:grid/flex das classes vencia o atributo hidden */\n[hidden] {\n  display: none !important;\n}\nbutton:focus-visible,\nselect:focus-visible {\n  outline: 2px solid var(--gold);\n  outline-offset: 2px;\n}\nsvg {\n  display: block;\n  flex: none;\n}\n\n/* ---------- trilho ---------- */\n.rail {\n  position: sticky;\n  top: 0;\n  align-self: start;\n  height: 100vh;\n  height: 100dvh;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  gap: 22px;\n  padding: 22px 0 18px;\n  background: var(--panel);\n  border-right: 1px solid var(--border);\n}\n.brand {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 0 22px;\n  color: var(--gold);\n}\n.brand span {\n  font: 600 17px var(--brand);\n  letter-spacing: 0.08em;\n  color: var(--gold-l);\n}\n.mini-stats {\n  display: flex;\n  gap: 18px;\n  padding: 0 22px;\n  color: var(--dim);\n  font: 500 12px var(--sans);\n  font-variant-numeric: tabular-nums;\n}\n.mini-stats b {\n  margin-left: 5px;\n  color: var(--fg);\n  font-weight: 600;\n}\n.facts.facts-4 {\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n}\n@media (max-width: 700px) {\n  .facts.facts-4 {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n.stats {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  margin: -16px 0 -8px;\n}\n.stat {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 2px;\n  min-width: 180px;\n  padding: 0 40px;\n  text-align: center;\n  border-left: 1px solid var(--divider);\n}\n.stat:first-child {\n  border-left: 0;\n}\n.stat b {\n  color: var(--gold-l);\n  font: 600 34px/1.1 var(--sans);\n  font-variant-numeric: tabular-nums;\n}\n.stat small {\n  color: var(--dim);\n  font-size: 12.5px;\n}\n/* cartão só onde o bloco é uma conta fechada (bases + CD, CA da armadura) */\n.panel {\n  align-self: center;\n  max-width: 100%;\n  padding: 18px 28px;\n  background: var(--card);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n}\n.class-panel {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: center;\n  gap: 18px 36px;\n}\n.class-panel .bases-fld {\n  padding: 0;\n}\n.vsep {\n  align-self: stretch;\n  width: 1px;\n  background: var(--divider);\n}\n@media (max-width: 700px) {\n  .vsep {\n    display: none;\n  }\n}\n.who {\n  display: grid;\n  grid-template-columns: 44px 1fr;\n  gap: 12px;\n  align-items: center;\n  padding: 0 22px;\n}\n.who-img {\n  width: 44px;\n  height: 58px;\n  background: var(--card) center/cover no-repeat;\n  border: 1px solid var(--input);\n}\n.who-name {\n  font: 600 19px/1.1 var(--display);\n  overflow-wrap: anywhere;\n}\n.who-sub {\n  margin-top: 2px;\n  color: var(--dim);\n  font-size: 12.5px;\n}\n.mini {\n  display: grid;\n  gap: 9px;\n  padding: 0 22px;\n}\n.mini-row {\n  display: grid;\n  grid-template-columns: 34px 1fr auto;\n  align-items: center;\n  gap: 8px;\n  font: 500 11.5px var(--sans);\n  font-variant-numeric: tabular-nums;\n  color: var(--dim);\n}\n.mini-row b {\n  overflow: hidden;\n  font: 600 10.5px var(--sans);\n  letter-spacing: 0.1em;\n  color: var(--c);\n  white-space: nowrap;\n  text-overflow: clip;\n}\n.bar {\n  height: 4px;\n  background: var(--muted);\n}\n.bar i {\n  display: block;\n  height: 100%;\n  background: var(--c);\n  transition: width 0.3s ease;\n}\n.nav {\n  display: flex;\n  flex-direction: column;\n  border-top: 1px solid var(--border);\n  padding-top: 10px;\n}\n.nav button {\n  padding: 8px 22px 8px 20px;\n  background: none;\n  border: 0;\n  border-left: 2px solid transparent;\n  color: var(--dim);\n  font-weight: 500;\n  text-align: left;\n}\n.nav button:hover {\n  color: var(--fg);\n}\n.nav button[aria-selected='true'] {\n  border-left-color: var(--gold);\n  color: var(--gold-l);\n}\n.nav-foot {\n  margin-top: auto;\n  padding: 10px 0 4px;\n}\n.rail-foot {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 14px 22px 0;\n  border-top: 1px solid var(--border);\n}\n.status {\n  color: var(--err);\n  font-size: 12px;\n}\n.rail-foot:has(.status:empty) {\n  display: none;\n}\n\n/* ---------- página ---------- */\n/* sem cartões: os blocos se separam por fios que atravessam a área inteira (passam por cima do padding) */\n.content {\n  --pad: 56px;\n  min-width: 0;\n  padding: 44px var(--pad) 140px;\n}\n.page {\n  display: none;\n  flex-direction: column;\n  gap: 52px;\n}\n.page.on {\n  display: flex;\n}\n.eyebrow {\n  margin: 0;\n  font: 600 11px var(--sans);\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--dim);\n}\n.h1 {\n  margin: 4px 0 0;\n  font: 600 44px/1.05 var(--display);\n  text-wrap: balance;\n}\n.h2 {\n  margin: 0;\n  font: 600 30px/1.1 var(--display);\n  text-wrap: balance;\n}\n.hint {\n  margin: 6px 0 0;\n  max-width: 68ch;\n  color: var(--dim);\n}\n.blk {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  gap: 18px;\n  padding-top: 34px;\n}\n.blk::before,\n.entry::before,\n.list:not(:empty)::after {\n  content: '';\n  position: absolute;\n  left: calc(-1 * var(--pad));\n  right: calc(-1 * var(--pad));\n  height: 1px;\n  background: var(--divider);\n}\n.blk::before,\n.entry::before {\n  top: 0;\n}\n.blk.first {\n  padding-top: 0;\n}\n.blk.first::before {\n  display: none;\n}\n.blk-hd {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.fld {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  min-width: 0;\n}\n.lbl {\n  font: 600 11px var(--sans);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--label);\n}\n.in {\n  width: 100%;\n  height: 40px;\n  padding: 0 2px;\n  background: transparent;\n  border: 0;\n  border-bottom: 1px solid var(--input);\n  border-radius: 0;\n  color: var(--fg);\n  font: inherit;\n  outline: none;\n}\n.in::placeholder {\n  color: var(--ph);\n}\n.in:hover {\n  border-bottom-color: var(--label);\n}\n.in:focus {\n  border-bottom-color: var(--gold);\n  box-shadow: 0 1px 0 var(--gold);\n}\nselect.in option {\n  background: var(--card);\n  color: var(--fg);\n}\n.num {\n  text-align: center;\n  font-variant-numeric: tabular-nums;\n}\n.facts {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));\n  gap: 14px 16px;\n}\n.btn-ghost {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  height: 34px;\n  padding: 0 12px;\n  background: none;\n  border: 1px solid var(--input);\n  border-radius: 4px;\n  color: var(--label);\n  font-size: 13.5px;\n  font-weight: 500;\n}\n.btn-ghost:hover {\n  border-color: var(--gold);\n  color: var(--gold-l);\n}\n.mini-btn {\n  display: grid;\n  place-items: center;\n  width: 28px;\n  height: 28px;\n  padding: 0;\n  background: none;\n  border: 1px solid var(--input);\n  border-radius: 4px;\n  color: var(--dim);\n}\n.mini-btn:hover {\n  border-color: var(--gold);\n  color: var(--gold-l);\n}\n.mini-btn.danger:hover {\n  border-color: var(--err);\n  color: var(--err);\n}\n/* só de leitura: some o que só serve para editar */\n.readonly [data-edit-only] {\n  display: none !important;\n}\n\n/* ---------- texto rico ---------- */\n/* texto rico sem caixa: um fio à esquerda marca o campo e fica dourado no foco; começa com uma\n   linha e cresce com o texto, para não deixar um vão entre um item e outro */\n.rt-ed {\n  position: relative;\n  min-height: calc(1.62em + 10px);\n  padding: 4px 0 6px 18px;\n  background: transparent;\n  border: 0;\n  border-left: 2px solid var(--divider);\n  border-radius: 0;\n  color: var(--fg);\n  line-height: 1.62;\n  outline: none;\n  overflow-wrap: anywhere;\n}\n.rt-ed:hover {\n  border-left-color: var(--input);\n}\n.rt-ed:focus {\n  border-left-color: var(--gold);\n}\n.free .rt-ed {\n  min-height: 62vh;\n  padding: 6px 0 6px 22px;\n}\n.free .rt-ed.empty::before {\n  top: 6px;\n  left: 22px;\n}\n.rt-ed.empty::before {\n  content: attr(data-ph);\n  position: absolute;\n  top: 4px;\n  left: 18px;\n  right: 0;\n  color: var(--ph);\n  pointer-events: none;\n}\n.rt-ed > :first-child {\n  margin-top: 0;\n}\n.rt-ed > :last-child {\n  margin-bottom: 0;\n}\n.rt-ed p {\n  margin: 0 0 0.65em;\n}\n.rt-ed h4 {\n  margin: 1.1em 0 0.25em;\n  font: 600 22px/1.2 var(--display);\n  color: var(--fg);\n}\n.rt-ed blockquote {\n  margin: 0.9em 0;\n  padding: 0.05em 0 0.05em 14px;\n  border-left: 2px solid var(--gold);\n  font: italic 500 19px/1.4 var(--display);\n  color: var(--label);\n}\n.rt-ed hr {\n  height: 1px;\n  margin: 1.3em 0;\n  border: 0;\n  background: rgb(197 164 109 / 0.4);\n}\n.rt-ed ul,\n.rt-ed ol {\n  margin: 0.3em 0 0.8em;\n  padding-left: 1.4em;\n}\n.rt-ed li {\n  margin: 0.15em 0;\n}\n.rt-ed strong,\n.rt-ed b {\n  font-weight: 700;\n}\n\n#rtbar {\n  position: fixed;\n  left: calc(var(--rail) + (100vw - var(--rail)) / 2);\n  bottom: 18px;\n  z-index: 30;\n  display: none;\n  align-items: center;\n  gap: 2px;\n  padding: 4px;\n  background: var(--muted);\n  border: 1px solid var(--input);\n  border-radius: 4px;\n  transform: translateX(-50%);\n}\n#rtbar.on {\n  display: flex;\n}\n.tb {\n  display: grid;\n  place-items: center;\n  min-width: 32px;\n  height: 32px;\n  padding: 0 7px;\n  background: none;\n  border: 0;\n  border-radius: 4px;\n  color: var(--label);\n  font: 600 14px var(--sans);\n}\n.tb:hover {\n  background: var(--card);\n  color: var(--fg);\n}\n.tb[aria-pressed='true'] {\n  color: var(--gold-l);\n  background: var(--card);\n}\n.tb .serif {\n  font: 600 17px var(--display);\n}\n.sep {\n  width: 1px;\n  height: 20px;\n  margin: 0 4px;\n  background: var(--input);\n}\n.cur-sw {\n  width: 14px;\n  height: 14px;\n  border-radius: 50%;\n  background: var(--sw, var(--fg));\n  border: 1px solid #0008;\n}\n.swatches {\n  position: absolute;\n  bottom: calc(100% + 8px);\n  left: 50%;\n  display: none;\n  grid-template-columns: repeat(4, 26px);\n  gap: 8px;\n  padding: 10px;\n  background: var(--muted);\n  border: 1px solid var(--input);\n  border-radius: 4px;\n  transform: translateX(-50%);\n}\n.swatches.on {\n  display: grid;\n}\n.sw {\n  width: 26px;\n  height: 26px;\n  padding: 0;\n  border: 1px solid #000a;\n  border-radius: 50%;\n  background: var(--sw);\n}\n.sw:hover {\n  outline: 2px solid var(--gold);\n  outline-offset: 2px;\n}\n\n/* ---------- imagens ---------- */\n.img-slot {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 4px;\n}\n.img-btn {\n  padding: 0;\n  overflow: hidden;\n  background: var(--card);\n  border: 1px dashed var(--input);\n  color: var(--ph);\n  font: 500 13px var(--sans);\n}\n.img-btn:hover {\n  border-color: var(--gold);\n  color: var(--gold-l);\n}\n.img-btn img {\n  display: block;\n  width: 100%;\n}\n.img-rm {\n  padding: 2px 0;\n  background: none;\n  border: 0;\n  color: var(--dim);\n  font-size: 12px;\n}\n.img-rm:hover {\n  color: var(--err);\n}\n.img-note {\n  margin: 0;\n  color: var(--dim);\n  font-size: 12px;\n}\n.portrait {\n  width: 236px;\n}\n.portrait .img-btn {\n  display: grid;\n  place-items: center;\n  align-content: center;\n  gap: 6px;\n  width: 100%;\n  aspect-ratio: 3/4;\n}\n.portrait .img-btn.has {\n  border-style: solid;\n}\n.portrait .img-btn img {\n  height: 100%;\n  object-fit: cover;\n}\n.opt .img-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  height: 34px;\n  padding: 0 12px;\n  border-radius: 4px;\n  background: none;\n  color: var(--dim);\n  font-size: 13.5px;\n}\n.opt:has(.img-btn.has) {\n  align-items: center;\n  align-self: stretch;\n}\n.opt .img-btn.has {\n  display: block;\n  width: auto;\n  height: auto;\n  max-width: min(100%, 420px);\n  padding: 0;\n  border: 1px solid var(--input);\n  border-radius: 0;\n  background: var(--panel);\n}\n.opt .img-btn.has img {\n  width: auto;\n  max-width: 100%;\n  max-height: 300px;\n  object-fit: contain;\n}\n.readonly .opt:not(:has(.img-btn.has)) {\n  display: none;\n}\n\n/* ---------- perfil ---------- */\n.hero {\n  display: grid;\n  grid-template-columns: 236px minmax(0, 1fr);\n  gap: 36px;\n  align-items: start;\n}\n.hero-name {\n  width: 100%;\n  padding: 0;\n  background: none;\n  border: 0;\n  border-bottom: 1px solid var(--divider);\n  color: var(--fg);\n  font: 600 clamp(36px, 4.6vw, 56px)/1.08 var(--display);\n  outline: none;\n}\n.hero-name:focus {\n  border-bottom-color: var(--gold);\n}\n.hero-name::placeholder,\n.entry-name::placeholder,\n.big-name::placeholder {\n  color: #8a8f99aa;\n}\n.hero-sub {\n  display: inline-flex;\n  flex-wrap: wrap;\n  gap: 4px 10px;\n  margin: 8px 0 26px;\n  padding: 0;\n  background: none;\n  border: 0;\n  color: var(--label);\n  font: italic 500 22px var(--display);\n  text-align: left;\n}\n.hero-sub .ph {\n  color: var(--ph);\n}\n.hero-sub:hover {\n  color: var(--gold-l);\n}\n.rank {\n  position: relative;\n  --c: #b08a5e;\n}\n.rank-gem {\n  flex: none;\n  width: 9px;\n  height: 9px;\n  margin: 0 2px;\n  background: var(--c);\n  transform: rotate(45deg);\n}\n.rank-btn {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--c);\n  font-weight: 600;\n  text-align: left;\n}\n.rank-btn svg {\n  margin-left: auto;\n  color: var(--dim);\n}\n.rank-btn[aria-expanded='true'] {\n  border-color: var(--gold);\n}\n.rank-btn[aria-expanded='true'] svg {\n  transform: rotate(180deg);\n}\n.rank-list {\n  position: absolute;\n  z-index: 40;\n  top: calc(100% + 4px);\n  left: 0;\n  min-width: 100%;\n  max-height: 340px;\n  margin: 0;\n  padding: 4px;\n  overflow-y: auto;\n  list-style: none;\n  background: var(--muted);\n  border: 1px solid var(--input);\n  border-radius: 4px;\n  outline: none;\n}\n.rank-list li {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 7px 10px;\n  border-radius: 4px;\n  color: var(--c);\n  font-weight: 600;\n  white-space: nowrap;\n  cursor: pointer;\n}\n.rank-list li.active,\n.rank-list li:hover {\n  background: var(--card);\n}\n.rank-chk {\n  margin-left: auto;\n  padding-left: 14px;\n  color: var(--gold-l);\n  visibility: hidden;\n}\n.rank-list li[aria-selected='true'] .rank-chk {\n  visibility: visible;\n}\n.bars {\n  display: flex;\n  flex-direction: column;\n}\n.bar-row {\n  display: grid;\n  grid-template-columns: 150px minmax(0, 1fr) 76px 12px 76px 40px;\n  grid-template-areas: 'n b c s m t';\n  align-items: center;\n  gap: 12px;\n  padding: 11px 0;\n  border-bottom: 1px solid var(--divider);\n}\n.bar-row.head {\n  padding: 0 0 6px;\n  border-bottom-color: var(--input);\n}\n.bar-row.head .lbl {\n  color: var(--dim);\n  text-align: center;\n}\n.bar-n {\n  grid-area: n;\n  min-width: 0;\n}\n.bar-row .bar {\n  grid-area: b;\n  height: 8px;\n}\n.bar-c {\n  grid-area: c;\n}\n.bar-s {\n  grid-area: s;\n  text-align: center;\n  color: var(--ph);\n}\n.bar-m {\n  grid-area: m;\n}\n.bar-t {\n  grid-area: t;\n  display: flex;\n  justify-content: flex-end;\n  gap: 6px;\n}\n.bar-name {\n  font: 600 13px var(--sans);\n  letter-spacing: 0.14em;\n  color: var(--c);\n}\n.bar-row .in {\n  height: 34px;\n  padding: 0 6px;\n}\n@media (max-width: 700px) {\n  .bar-row {\n    grid-template-columns: minmax(0, 1fr) 76px 12px 76px;\n    grid-template-areas: 'n n n t' 'b b b b' '. c s m';\n  }\n  .bar-row.head {\n    display: none;\n  }\n}\n@media (max-width: 760px) {\n  .hero {\n    grid-template-columns: 1fr;\n  }\n  .portrait {\n    width: 180px;\n  }\n}\n\n/* ---------- origem ---------- */\n.big-name {\n  width: 100%;\n  padding: 0 0 4px;\n  background: none;\n  border: 0;\n  border-bottom: 1px solid var(--divider);\n  color: var(--fg);\n  font: 600 34px/1.1 var(--display);\n  outline: none;\n}\n.big-name:focus {\n  border-bottom-color: var(--gold);\n}\n.bases-fld {\n  align-items: center;\n  padding: 6px 0;\n  text-align: center;\n}\n.bases {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 12px 26px;\n}\n.bases .fld {\n  flex-direction: row;\n  align-items: center;\n  gap: 10px;\n}\n.bases .lbl {\n  color: var(--c);\n}\n.bases .in {\n  width: 64px;\n}\n.row-hd {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 12px 20px;\n}\n.fold-all {\n  display: flex;\n  gap: 8px;\n}\n.sec-hd,\n.fld-hd {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.fold {\n  display: grid;\n  place-items: center;\n  width: 24px;\n  height: 24px;\n  padding: 0;\n  background: none;\n  border: 1px solid transparent;\n  border-radius: 4px;\n  color: var(--dim);\n}\n.fold:hover {\n  border-color: var(--input);\n  color: var(--gold-l);\n}\n.fold[aria-expanded='false'] svg {\n  transform: rotate(-90deg);\n}\n.fold-prev {\n  display: none;\n  margin: 0;\n  padding: 2px 0 2px 18px;\n  overflow: hidden;\n  border-left: 2px solid var(--divider);\n  color: var(--dim);\n  font-size: 13.5px;\n  font-style: italic;\n  white-space: nowrap;\n  text-overflow: ellipsis;\n  cursor: pointer;\n}\n.fold-prev:hover {\n  border-left-color: var(--gold);\n  color: var(--label);\n}\n.fld.folded > .rt-ed {\n  display: none;\n}\n.fld.folded > .fold-prev {\n  display: block;\n}\n.blk.folded > :not(.blk-hd) {\n  display: none;\n}\n\n/* ---------- regras ---------- */\n.rules {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  border-top: 1px solid var(--divider);\n}\n.rules li {\n  display: grid;\n  grid-template-columns: 230px minmax(0, 1fr);\n  gap: 8px 18px;\n  padding: 12px 0;\n  border-bottom: 1px solid var(--divider);\n  color: var(--label);\n}\n.rules b {\n  color: var(--c);\n  font-weight: 700;\n}\n.fall li {\n  grid-template-columns: 190px 90px minmax(0, 1fr) auto;\n  align-items: baseline;\n}\n.fall .thr {\n  font-variant-numeric: tabular-nums;\n  color: var(--dim);\n  white-space: nowrap;\n}\n.here-tag {\n  visibility: hidden;\n  font: 600 10.5px var(--sans);\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--gold-l);\n  white-space: nowrap;\n}\n.fall li.here {\n  margin-left: -12px;\n  padding-left: 10px;\n  border-left: 2px solid var(--gold);\n  background: rgb(197 164 109 / 0.08);\n}\n.fall li.here .here-tag {\n  visibility: visible;\n}\n@media (max-width: 760px) {\n  .rules li,\n  .fall li {\n    grid-template-columns: 1fr;\n  }\n}\n.next-lv {\n  padding-left: 18px;\n  border-left: 2px solid var(--gold);\n}\n.next-hd {\n  display: flex;\n  align-items: baseline;\n  gap: 10px;\n  margin: 0;\n}\n.next-hd b {\n  font: 600 22px var(--sans);\n  font-variant-numeric: tabular-nums;\n  color: var(--gold-l);\n}\n.next-lv ul {\n  margin: 8px 0 0;\n  padding: 0;\n  list-style: none;\n}\n.next-lv li {\n  position: relative;\n  padding: 3px 0 3px 18px;\n  color: var(--fg);\n}\n.next-lv li::before {\n  content: '';\n  position: absolute;\n  left: 2px;\n  top: 0.72em;\n  width: 7px;\n  height: 7px;\n  background: var(--c);\n  transform: rotate(45deg);\n}\n.rest-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n.rest {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  padding-right: 36px;\n}\n.rest + .rest {\n  padding: 0 0 0 36px;\n  border-left: 1px solid var(--divider);\n}\n@media (max-width: 820px) {\n  .rest-grid {\n    grid-template-columns: 1fr;\n    gap: 28px;\n  }\n  .rest,\n  .rest + .rest {\n    padding: 0;\n    border-left: 0;\n  }\n}\n.rest h3 {\n  margin: 0;\n  font: 600 24px/1.1 var(--display);\n}\n.rest p {\n  margin: 0;\n  color: var(--label);\n}\n.rest p b {\n  color: var(--fg);\n}\n.rest-opt {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 16px;\n  padding-top: 12px;\n  border-top: 1px solid var(--divider);\n}\n.rest-opt > p > b:first-child {\n  color: var(--c);\n}\n.rest-note {\n  color: var(--dim) !important;\n  font-size: 13.5px;\n}\n.btn-rest {\n  height: 34px;\n  padding: 0 14px;\n  background: none;\n  border: 1px solid var(--gold);\n  border-radius: 4px;\n  color: var(--gold-l);\n  font-weight: 600;\n  white-space: nowrap;\n}\n.btn-rest:hover {\n  background: var(--gold);\n  color: #15130f;\n}\n.rest-msg {\n  font-size: 14px;\n  color: var(--label);\n}\n\n/* ---------- entradas (habilidades, extras, itens) ---------- */\n.list {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n}\n.list::after {\n  bottom: 0;\n}\n.entry {\n  position: relative;\n  padding: 20px 0 26px;\n}\n.entry-hd {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr) auto auto auto;\n  align-items: center;\n  gap: 10px 14px;\n}\n.mini-btn[data-armed] {\n  width: auto;\n  padding: 0 10px;\n  border-color: var(--err);\n  color: var(--err);\n  font-size: 12.5px;\n  font-weight: 600;\n}\n.entry-idx {\n  font: 500 12px var(--sans);\n  font-variant-numeric: tabular-nums;\n  letter-spacing: 0.08em;\n  color: var(--ph);\n}\n.entry-name {\n  min-width: 0;\n  padding: 0;\n  background: none;\n  border: 0;\n  border-bottom: 1px dashed transparent;\n  color: var(--fg);\n  font: 600 26px/1.2 var(--display);\n  outline: none;\n}\n.entry-name:hover {\n  border-bottom-color: var(--input);\n}\n.entry-name:focus {\n  border-bottom-color: var(--gold);\n}\n.entry-meta {\n  max-width: 34ch;\n  overflow: hidden;\n  color: var(--dim);\n  font: 500 13px var(--sans);\n  white-space: nowrap;\n  text-overflow: ellipsis;\n}\n.entry-meta:empty {\n  display: none;\n}\n.chev[aria-expanded='false'] svg {\n  transform: rotate(-90deg);\n}\n.entry.closed .entry-body {\n  display: none;\n}\n/* a ficha técnica é uma faixa no topo da entrada: as células crescem até preencher a linha */\n.entry-body {\n  display: flex;\n  flex-direction: column;\n  gap: 18px;\n  margin-top: 18px;\n}\n.spec {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));\n  gap: 16px 28px;\n}\n.spec-row {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  min-width: 0;\n}\n.spec-row:focus-within .lbl {\n  color: var(--gold-l);\n}\n.spec .lbl {\n  color: var(--dim);\n}\n.spec-in {\n  width: 100%;\n  min-height: 34px;\n  padding: 4px 0;\n  background: none;\n  border: 0;\n  border-bottom: 1px solid var(--input);\n  color: var(--fg);\n  font: 500 15px var(--sans);\n  outline: none;\n}\n.spec-in:hover {\n  border-bottom-color: var(--label);\n}\n.spec-in:focus {\n  border-bottom-color: var(--gold);\n  box-shadow: 0 1px 0 var(--gold);\n}\n.spec-in::placeholder {\n  color: var(--ph);\n}\n.spec .rt-ed {\n  min-height: 34px;\n  padding: 4px 0;\n  border-left: 0;\n  border-bottom: 1px solid var(--input);\n  line-height: 1.5;\n}\n.spec .rt-ed:hover {\n  border-bottom-color: var(--label);\n}\n.spec .rt-ed:focus {\n  border-bottom-color: var(--gold);\n  box-shadow: 0 1px 0 var(--gold);\n}\n.spec .rt-ed.empty::before {\n  top: 4px;\n  left: 0;\n}\n.cost-block {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: end;\n  gap: 8px 16px;\n}\n.cost-block > .lbl {\n  grid-column: 1/-1;\n  color: var(--dim);\n}\n.cost-block:focus-within > .lbl {\n  color: var(--gold-l);\n}\n.cost-block > .use-msg {\n  grid-column: 1/-1;\n}\n.costs {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 10px 28px;\n}\n.cost {\n  display: grid;\n  grid-template-columns: 150px 60px 22px;\n  align-items: center;\n  gap: 8px;\n}\n.cost-bar,\n.cost-v {\n  height: 34px;\n  padding: 0 2px;\n  background: transparent;\n  border: 0;\n  border-bottom: 1px solid var(--input);\n  border-radius: 0;\n  color: var(--fg);\n  font: 500 14.5px var(--sans);\n  outline: none;\n}\n.cost-bar {\n  cursor: pointer;\n}\n.cost-bar option {\n  background: var(--card);\n}\n.cost-v {\n  text-align: center;\n  font-variant-numeric: tabular-nums;\n}\n.cost-bar:focus,\n.cost-v:focus {\n  border-bottom-color: var(--gold);\n  box-shadow: 0 1px 0 var(--gold);\n}\n.btn-use {\n  height: 34px;\n  padding: 0 14px;\n  background: var(--gold);\n  border: 0;\n  border-radius: 4px;\n  color: #15130f;\n  font: 600 12.5px var(--sans);\n}\n.btn-use:hover {\n  background: var(--gold-h);\n}\n.use-msg {\n  margin: 0;\n  color: var(--dim);\n  font-size: 12.5px;\n}\n.use-msg:empty {\n  display: none;\n}\n.use-msg.bad {\n  color: var(--err);\n}\n.quote {\n  width: 100%;\n  padding: 4px 0 4px 14px;\n  background: none;\n  border: 0;\n  border-left: 2px solid var(--gold);\n  color: var(--gold-l);\n  font: italic 600 20px var(--display);\n  outline: none;\n}\n.quote::placeholder {\n  color: #c5a46d99;\n}\n.add-row {\n  padding-top: 16px;\n}\n.empty-list {\n  margin: 0;\n  color: var(--dim);\n}\n@media (max-width: 900px) {\n  .entry-meta {\n    display: none;\n  }\n}\n\n/* ---------- atributos ---------- */\n.tbl-wrap {\n  overflow-x: auto;\n}\ntable {\n  border-collapse: collapse;\n  font-variant-numeric: tabular-nums;\n}\ntable.attr,\ntable.res {\n  width: 100%;\n}\n.attr th,\n.attr td {\n  padding: 10px 12px;\n  border-bottom: 1px solid var(--divider);\n  text-align: center;\n  white-space: nowrap;\n}\n.attr thead th {\n  font: 600 12px var(--sans);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--dim);\n  border-bottom-color: var(--input);\n}\n.attr tbody th {\n  width: 18%;\n  padding-left: 0;\n  text-align: left;\n  font-size: 17px;\n  font-weight: 500;\n  color: var(--label);\n}\n.attr .grp th {\n  width: auto;\n  padding-top: 26px;\n  font: 600 12px var(--sans);\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--c);\n  border-bottom: 0;\n}\n.attr .op {\n  width: 28px;\n  padding: 0;\n  color: var(--ph);\n  font-size: 18px;\n}\n.attr .in {\n  width: 100%;\n  min-width: 60px;\n  height: 48px;\n  padding: 0 4px;\n  font-size: 18px;\n}\n.attr .tot {\n  width: 11%;\n  font: 600 32px var(--sans);\n  color: var(--fg);\n}\n.checks {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 6px 32px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  font-size: 16px;\n}\n.checks li {\n  color: var(--dim);\n}\n.checks b {\n  font-weight: 600;\n}\n.ok {\n  color: var(--moss-l) !important;\n}\n.warn {\n  color: var(--amber) !important;\n}\n.bad {\n  color: var(--err) !important;\n}\n.res th,\n.res td {\n  padding: 16px 18px 16px 0;\n  border-bottom: 1px solid var(--divider);\n  text-align: left;\n}\n.res thead th {\n  padding-top: 0;\n  font: 600 12px var(--sans);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--dim);\n  border-bottom-color: var(--input);\n}\n.res .rn {\n  width: 18%;\n  font: 600 16px var(--sans);\n  letter-spacing: 0.14em;\n  color: var(--c);\n}\n.res .rf {\n  font: 400 16px var(--mono);\n  color: var(--label);\n  white-space: normal;\n}\n.res .rf select {\n  height: 32px;\n  padding: 0 6px;\n  background: var(--card);\n  border: 1px solid var(--input);\n  border-radius: 4px;\n  color: var(--fg);\n  font: inherit;\n}\n.res .rx {\n  width: 30px;\n  padding-right: 0;\n}\n.res .conta-bar {\n  width: 100%;\n  max-width: 150px;\n}\n.res .conta-f {\n  width: 100%;\n  font: 400 16px var(--mono);\n}\n.res .conta-why:empty {\n  display: none;\n}\n.res .conta-why {\n  margin: 6px 0 0;\n  font: 400 12.5px var(--sans);\n}\n.res .rv {\n  width: 11%;\n  padding-right: 0;\n  font: 600 32px var(--sans);\n  text-align: right;\n  white-space: nowrap;\n}\n\n/* ---------- perícias ---------- */\n.train {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n.train .in {\n  width: 72px;\n  height: 44px;\n  color: var(--gold-l);\n  font-size: 20px;\n  font-weight: 600;\n}\n.train .in::placeholder {\n  color: var(--gold-l);\n  opacity: 0.85;\n}\n.sk-board {\n  display: flex;\n  flex-direction: column;\n  gap: 40px;\n}\n.sk-cols {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 30px 44px;\n}\n@media (max-width: 1100px) {\n  .sk-cols {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n@media (max-width: 640px) {\n  .sk-cols {\n    grid-template-columns: 1fr;\n  }\n}\n.sk-grp-hd {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 10px;\n  padding-bottom: 10px;\n  border-bottom: 1px solid var(--c);\n}\n.sk-grp-hd h3 {\n  margin: 0;\n  font: 600 25px/1 var(--display);\n}\n.sk-at {\n  font: 600 12px var(--sans);\n  letter-spacing: 0.12em;\n  color: var(--c);\n  font-variant-numeric: tabular-nums;\n}\n.sk {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto 30px;\n  align-items: center;\n  gap: 10px;\n  min-height: 40px;\n  padding: 0 2px;\n  border-bottom: 1px solid var(--divider);\n  color: var(--dim);\n  font: 500 14.5px var(--sans);\n}\n.sk-tog {\n  display: grid;\n  grid-template-columns: 16px minmax(0, 1fr);\n  align-items: center;\n  gap: 12px;\n  min-height: 39px;\n  padding: 0;\n  background: none;\n  border: 0;\n  color: inherit;\n  text-align: left;\n  font: inherit;\n}\n.sk-tog.only {\n  display: grid;\n  place-items: center;\n  width: 18px;\n  min-height: 0;\n  grid-template-columns: none;\n}\n.sk-tog:hover .sk-n,\n.sk-tog:hover .gem {\n  color: var(--fg);\n  border-color: var(--label);\n}\n.gem {\n  width: 9px;\n  height: 9px;\n  margin-left: 3px;\n  border: 1.5px solid var(--ph);\n  transform: rotate(45deg);\n  transition:\n    background 0.15s,\n    border-color 0.15s;\n}\n.sk-tog[aria-pressed='true'] .gem {\n  background: var(--gold);\n  border-color: var(--gold);\n}\n.sk:has(.sk-tog[aria-pressed='true']) .sk-n {\n  color: var(--fg);\n}\n.sk-v {\n  font: 500 14px var(--sans);\n  font-variant-numeric: tabular-nums;\n  text-align: right;\n  color: var(--dim);\n}\n.sk:has(.sk-tog[aria-pressed='true']) .sk-v {\n  color: var(--gold-l);\n}\n.sk-mult {\n  height: 22px;\n  padding: 0 6px;\n  background: none;\n  border: 1px solid var(--input);\n  border-radius: 4px;\n  color: var(--gold-l);\n  font: 600 11.5px var(--sans);\n  font-variant-numeric: tabular-nums;\n}\n.sk-mult:hover {\n  border-color: var(--gold);\n}\n.sk-multi {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  min-height: 40px;\n  padding: 0 2px 0 30px;\n  border-bottom: 1px solid var(--divider);\n  color: var(--label);\n  font: 500 14.5px var(--sans);\n}\n.sk-add {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 3px 6px;\n  background: none;\n  border: 0;\n  border-radius: 4px;\n  color: var(--dim);\n  font-size: 12.5px;\n}\n.sk-add:hover {\n  color: var(--gold-l);\n}\n.sk.sub {\n  grid-template-columns: 18px minmax(0, 1fr) auto 30px 22px;\n  gap: 10px;\n  padding-left: 14px;\n}\n.sk-def {\n  min-width: 0;\n  height: 28px;\n  padding: 0;\n  background: none;\n  border: 0;\n  border-bottom: 1px dashed transparent;\n  color: var(--fg);\n  font: inherit;\n  outline: none;\n}\n.sk-def:hover {\n  border-bottom-color: var(--input);\n}\n.sk-def:focus {\n  border-bottom-color: var(--gold);\n}\n.sk-def::placeholder {\n  color: var(--ph);\n}\n.sk-x {\n  display: grid;\n  place-items: center;\n  width: 22px;\n  height: 22px;\n  padding: 0;\n  background: none;\n  border: 0;\n  border-radius: 4px;\n  color: var(--ph);\n}\n.sk-x[data-armed] {\n  color: var(--err);\n  background: color-mix(in srgb, var(--err) 14%, transparent);\n}\n.sk-x:hover {\n  color: var(--err);\n}\n\n/* ---------- inventário ---------- */\n.purse {\n  display: grid;\n  grid-template-columns: repeat(5, minmax(0, 1fr));\n  gap: 20px 32px;\n}\n@media (max-width: 1100px) {\n  .purse {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n}\n@media (max-width: 560px) {\n  .purse {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n.coin {\n  display: grid;\n  grid-template-columns: 36px minmax(0, 1fr);\n  align-items: center;\n  gap: 12px;\n  cursor: text;\n}\n.coin-n {\n  display: block;\n  font: 600 11px var(--sans);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--c);\n}\n.coin input {\n  width: 100%;\n  padding: 0 0 2px;\n  background: none;\n  border: 0;\n  border-bottom: 1px solid var(--input);\n  color: var(--fg);\n  font: 600 22px/1.2 var(--sans);\n  font-variant-numeric: tabular-nums;\n  outline: none;\n}\n.coin input:focus {\n  border-bottom-color: var(--gold);\n  box-shadow: 0 1px 0 var(--gold);\n}\n.coin input::placeholder {\n  color: var(--ph);\n}\n/* CA da armadura: uma linha centrada que se lê como conta (valor + atributo = CA) */\n.ca {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 14px;\n  text-align: center;\n}\n.ca-row {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: flex-end;\n  justify-content: center;\n  gap: 12px 18px;\n}\n.ca-f {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 4px;\n  color: var(--dim);\n  font: 600 10.5px var(--sans);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n}\n.ca-f .in {\n  width: 96px;\n  height: 40px;\n  font: 500 18px var(--sans);\n  letter-spacing: 0;\n  text-align: center;\n  text-transform: none;\n}\n.ca-f select.in {\n  width: 170px;\n  font-size: 16px;\n  text-align: left;\n  cursor: pointer;\n}\n.ca-op {\n  padding-bottom: 9px;\n  color: var(--ph);\n  font-size: 20px;\n}\n.ca-res {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 2px;\n  padding-left: 6px;\n}\n.ca-res span {\n  color: var(--dim);\n  font: 600 10.5px var(--sans);\n  letter-spacing: 0.12em;\n}\n.ca-val {\n  color: var(--gold-l);\n  font: 600 40px/1 var(--sans);\n  font-variant-numeric: tabular-nums;\n}\n.ca-form {\n  margin: 0;\n  color: var(--dim);\n  font-size: 13.5px;\n}\n.wear {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--label);\n  cursor: pointer;\n}\n.wear input {\n  width: 18px;\n  height: 18px;\n  margin: 0;\n  accent-color: var(--gold);\n  cursor: pointer;\n}\n.wear input:checked + span {\n  color: var(--gold-l);\n  font-weight: 600;\n}\n.cd-row {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  color: var(--label);\n}\n.cd-row b {\n  color: var(--fg);\n  font-weight: 600;\n  font-variant-numeric: tabular-nums;\n}\n.cd-row select.in {\n  width: 200px;\n  cursor: pointer;\n}\n.cd-val {\n  color: var(--gold-l);\n  font: 600 30px/1 var(--sans);\n  font-variant-numeric: tabular-nums;\n}\n.carry-box {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-height: 26px;\n  color: var(--fg);\n  font: 500 15px var(--sans);\n  cursor: pointer;\n}\n.carry-box input {\n  width: 18px;\n  height: 18px;\n  margin: 0;\n  accent-color: var(--gold);\n  cursor: pointer;\n}\n.carry-box input:not(:checked) + .carry-txt {\n  color: var(--dim);\n}\n.entry.stored .entry-name {\n  color: var(--dim);\n}\n.load {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n.load-top {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 6px 16px;\n}\n.load-n {\n  color: var(--dim);\n  font: 500 16px var(--sans);\n  font-variant-numeric: tabular-nums;\n}\n.load-n b {\n  color: var(--fg);\n  font-size: 30px;\n  font-weight: 600;\n}\n.load-state {\n  color: var(--dim);\n  font-size: 14px;\n}\n.load-bar {\n  height: 8px;\n  background: var(--muted);\n}\n.load-bar i {\n  display: block;\n  height: 100%;\n  background: var(--gold);\n  transition: width 0.3s ease;\n}\n.load.over .load-bar i {\n  background: var(--err);\n}\n.load.over .load-state,\n.load.over .load-n b {\n  color: var(--err);\n}\n.load-parts {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px 28px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  font-size: 14px;\n}\n.load-parts li {\n  display: flex;\n  gap: 8px;\n  color: var(--dim);\n}\n.load-parts b {\n  color: var(--label);\n  font-weight: 600;\n  font-variant-numeric: tabular-nums;\n}\n.bag {\n  display: flex;\n  flex-direction: column;\n}\n.bag-empty {\n  margin: 0;\n  color: var(--dim);\n}\n.slot {\n  display: grid;\n  grid-template-columns: 32px minmax(0, 1fr) 84px 84px 64px 26px;\n  align-items: center;\n  gap: 12px;\n  padding: 8px 0;\n  border-bottom: 1px solid var(--divider);\n}\n.slot.head {\n  padding: 0 0 8px;\n  border-bottom-color: var(--input);\n  font: 600 11px var(--sans);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--dim);\n}\n.slot.head span:nth-child(n + 3) {\n  text-align: center;\n}\n.slot-i {\n  font: 500 12px var(--sans);\n  font-variant-numeric: tabular-nums;\n  color: var(--ph);\n}\n.slot .in {\n  height: 38px;\n}\n.slot-sub {\n  text-align: center;\n  color: var(--label);\n  font-weight: 600;\n  font-variant-numeric: tabular-nums;\n}\n@media (max-width: 640px) {\n  .slot {\n    grid-template-columns: 24px minmax(0, 1fr) 64px 64px 26px;\n  }\n  .slot-sub,\n  .slot.head span:nth-child(5) {\n    display: none;\n  }\n}\n\n@media (max-width: 900px) {\n  body {\n    grid-template-columns: 1fr;\n  }\n  .rail {\n    position: sticky;\n    top: 0;\n    z-index: 10;\n    height: auto;\n    flex-direction: row;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 10px;\n    padding: 12px 0 0;\n  }\n  .who,\n  .mini,\n  .mini-stats {\n    display: none;\n  }\n  .nav {\n    flex-direction: row;\n    width: 100%;\n    overflow-x: auto;\n    padding-top: 4px;\n  }\n  .nav button {\n    flex: none;\n    padding: 10px 14px;\n    border-left: 0;\n    border-bottom: 2px solid transparent;\n  }\n  .nav button[aria-selected='true'] {\n    border-bottom-color: var(--gold);\n  }\n  .content {\n    --pad: 18px;\n    padding: 28px var(--pad) 120px;\n  }\n  #rtbar {\n    left: 50%;\n    max-width: calc(100vw - 24px);\n    overflow-x: auto;\n  }\n}\n"
    },
    {
      "path": "js/nucleo.js",
      "content": "/* ---------- estado ---------- */\n/* S é a cópia dos valores que a mesa confirmou (lorkarium.values); toda mudança sai por\n   values.patch, por caminho, e volta no próximo state. Listas são objetos por id estável\n   (lorkarium.lists) com um campo \"ordem\", porque o servidor não guarda a ordem das chaves. */\nconst MULTI = ['conhecimento', 'oficios', 'conducao'];\nlet S = {};\nlet VIEW = { canEdit: false, bars: [], character: null, token: null };\n/* aba aberta, seções e entradas recolhidas são de quem olha: não vão para os valores */\nconst UI = { page: 'perfil', closed: {}, fold: {} };\n\nconst isObj = (v) => v != null && typeof v === 'object' && !Array.isArray(v);\nconst getP = (p) => p.split('.').reduce((o, k) => (isObj(o) ? o[k] : undefined), S);\nfunction setLocal(p, v) {\n  const ks = p.split('.');\n  let o = S;\n  for (const k of ks.slice(0, -1)) {\n    if (!isObj(o[k])) o[k] = {};\n    o = o[k];\n  }\n  if (v === null) delete o[ks[ks.length - 1]];\n  else o[ks[ks.length - 1]] = v;\n}\n\n/* o trilho só mostra aviso quando algo deu errado */\nfunction setStatus(msg) {\n  document.querySelectorAll('.status').forEach((el) => {\n    el.textContent = msg;\n  });\n}\nconst failText = (e) => (e && e.message ? e.message : String(e));\n\n/* null apaga o caminho; o estado local muda já, para a conta não esperar a volta do state */\nfunction patchMany(pairs) {\n  if (!VIEW.canEdit || !pairs.length) return Promise.resolve(false);\n  pairs.forEach(([p, v]) => setLocal(p, v));\n  markDirty();\n  const patches = pairs.map(([p, v]) => ({ path: p.split('.'), value: v }));\n  return lorkarium.values.patch(patches).then(\n    () => true,\n    (e) => {\n      setStatus('Não foi possível salvar: ' + failText(e));\n      return false;\n    },\n  );\n}\nconst patch = (p, v) => patchMany([[p, v]]);\n\nfunction itemsOf(path) {\n  const box = getP(path);\n  if (!isObj(box)) return [];\n  return Object.entries(box)\n    .filter(([, v]) => isObj(v))\n    .sort(([a, x], [b, y]) => num(x.ordem) - num(y.ordem) || (a < b ? -1 : 1));\n}\nfunction addItem(path, item) {\n  if (!VIEW.canEdit) return Promise.resolve(null);\n  return lorkarium.lists\n    .add(path, Object.assign({ ordem: Date.now() }, item || {}))\n    .catch((e) => setStatus('Não foi possível adicionar: ' + failText(e)));\n}\nfunction removeItem(path, id) {\n  if (!VIEW.canEdit) return Promise.resolve();\n  return lorkarium.lists\n    .remove(path, id)\n    .catch((e) => setStatus('Não foi possível remover: ' + failText(e)));\n}\n\n/* CA, CD e os máximos das barras vão à mesa só depois de uma edição de quem tem a ficha:\n   abrir a ficha nunca reescreve o que o mestre mudou à mão no card. */\nlet dirty = false;\nlet pushT = 0;\nfunction markDirty() {\n  dirty = true;\n  schedulePush();\n}\nfunction schedulePush() {\n  clearTimeout(pushT);\n  pushT = setTimeout(() => {\n    if (!dirty || !VIEW.canEdit) return;\n    dirty = false;\n    pushStats();\n    syncBarMaxes();\n  }, 600);\n}\n\n/* ---------- pequenos ---------- */\nconst esc = (s) =>\n  String(s).replace(\n    /[&<>\"]/g,\n    (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' })[c],\n  );\nconst slug = (s) =>\n  s\n    .normalize('NFD')\n    .replace(/\\p{M}/gu, '')\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, '-')\n    .replace(/^-|-$/g, '');\nlet uid = 0;\nconst nid = (p) => 'f-' + p.replace(/\\./g, '-') + '-' + uid++;\nconst num = (v) => {\n  const n = parseInt(String(v ?? '').replace(/\\s/g, ''), 10);\n  return Number.isFinite(n) ? n : 0;\n};\nconst sign = (n) => (n > 0 ? '+' + n : String(n));\nconst filled = (v) => v != null && String(v).trim() !== '';\nconst pct = (cur, max) => (max > 0 ? Math.max(0, Math.min(1, cur / max)) * 100 : 0);\n"
    },
    {
      "path": "js/pecas.js",
      "content": "/* ---------- ícones ---------- */\nconst ICON = {\n  chev: '<path d=\"m6 9 6 6 6-6\"/>',\n  check: '<path d=\"M20 6 9 17l-5-5\"/>',\n  plus: '<path d=\"M5 12h14M12 5v14\"/>',\n  x: '<path d=\"M18 6 6 18M6 6l12 12\"/>',\n  reset: '<path d=\"M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5\"/>',\n  trash:\n    '<path d=\"M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"/>',\n  image:\n    '<rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"9\" cy=\"9\" r=\"2\"/><path d=\"m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21\"/>',\n  list: '<path d=\"M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01\"/>',\n  left: '<path d=\"M21 6H3M15 12H3M17 18H3\"/>',\n  center: '<path d=\"M21 6H3M17 12H7M19 18H5\"/>',\n  rule: '<path d=\"M4 12h16\"/>',\n  quote: '<path d=\"M7 7h4v4c0 3-1.5 5-4 6M15 7h4v4c0 3-1.5 5-4 6\"/>',\n  clear:\n    '<path d=\"m7 21-4.3-4.3a2.4 2.4 0 0 1 0-3.4l9.6-9.6a2.4 2.4 0 0 1 3.4 0l5.6 5.6a2.4 2.4 0 0 1 0 3.4L13 21M22 21H7M5 11l9 9\"/>',\n};\nconst ic = (n, s = 16) =>\n  `<svg width=\"${s}\" height=\"${s}\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">${ICON[n]}</svg>`;\n\n/* ---------- peças ---------- */\n/* campo simples ligado ao valor por data-lk: o SDK preenche a cada state e grava por values.patch */\nconst bare = (p, ph, cls, attrs = '', id = nid(p)) =>\n  `<input type=\"text\" id=\"${id}\" class=\"${cls}\" data-lk=\"${p}\" placeholder=\"${esc(ph)}\" autocomplete=\"off\" ${attrs}>`;\nfunction field(label, p, ph = '', cls = '', attrs = '') {\n  const id = nid(p);\n  return `<div class=\"fld ${cls}\"><label class=\"lbl\" for=\"${id}\">${label}</label>${bare(p, ph, 'in', attrs, id)}</div>`;\n}\n/* texto rico: data-rt, não data-lk, para a ficha mostrar o HTML limpo também a quem só lê */\nconst editor = (p, ph, aria) =>\n  `<div class=\"rt-ed\" contenteditable=\"true\" role=\"textbox\" aria-multiline=\"true\" ${aria} data-rt=\"${p}\" data-ph=\"${esc(ph)}\"></div>`;\nfunction rich(label, p, ph, cls = '') {\n  const id = nid(p);\n  if (!label) return `<div class=\"fld ${cls}\">${editor(p, ph, `aria-label=\"${esc(ph)}\"`)}</div>`;\n  return `<div class=\"fld ${cls}\" data-foldbox=\"${p}\"><div class=\"fld-hd\"><span class=\"lbl\" id=\"${id}-l\">${label}</span>${foldBtn(p, label)}</div>\n    <p class=\"fold-prev\"></p>${editor(p, ph, `aria-labelledby=\"${id}-l\"`)}</div>`;\n}\nconst foldBtn = (key, label) =>\n  `<button type=\"button\" class=\"fold\" data-fold=\"${key}\" data-keep aria-expanded=\"true\" aria-label=\"Recolher ou mostrar: ${esc(label)}\">${ic('chev', 14)}</button>`;\nconst isFolded = (k) => !!UI.fold[k];\nfunction setFold(k, v) {\n  if (v) UI.fold[k] = true;\n  else delete UI.fold[k];\n}\nfunction applyFold(box) {\n  const k = box.dataset.foldbox;\n  const folded = isFolded(k);\n  const btn = box.querySelector(`[data-fold=\"${k}\"]`);\n  box.classList.toggle('folded', folded);\n  if (btn) btn.setAttribute('aria-expanded', String(!folded));\n  const prev = box.querySelector(':scope > .fold-prev');\n  const ed = box.querySelector(':scope > .rt-ed');\n  if (!prev || !ed) return;\n  const txt = ed.textContent.trim();\n  prev.textContent = txt ? txt.slice(0, 160) + (txt.length > 160 ? '…' : '') : 'Vazio';\n}\n/* imagem guardada como id de asset da ficha (assets.upload); o arquivo é lido por assets.read */\nconst imgSlot = (p, label, cls) =>\n  `<div class=\"img-slot ${cls}\" data-img=\"${p}\" data-label=\"${esc(label)}\"><button type=\"button\" class=\"img-btn\"></button><button type=\"button\" class=\"img-rm\" data-edit-only hidden>Remover imagem</button><input type=\"file\" accept=\"image/png,image/jpeg,image/webp\" hidden aria-label=\"Arquivo: ${esc(label)}\"></div>`;\nconst optImg = (p) => imgSlot(p, 'Adicionar imagem', 'opt');\nconst pageHead = (eyebrow, title, hint = '') =>\n  `<header><p class=\"eyebrow\">${eyebrow}</p><h1 class=\"h1\">${title}</h1>${hint ? `<p class=\"hint\">${hint}</p>` : ''}</header>`;\n\n/* ficha técnica no topo das entradas */\nfunction specIn(label, p, ph = '—', attrs = '') {\n  const id = nid(p);\n  return `<div class=\"spec-row\"><label class=\"lbl\" for=\"${id}\">${label}</label>${bare(p, ph, 'spec-in', attrs, id)}</div>`;\n}\nfunction specRich(label, p, ph) {\n  const id = nid(p);\n  return `<div class=\"spec-row\"><span class=\"lbl\" id=\"${id}-l\">${label}</span>${editor(p, ph, `aria-labelledby=\"${id}-l\"`)}</div>`;\n}\n"
    },
    {
      "path": "js/barras.js",
      "content": "/* ---------- barras ---------- */\n/* As barras são as do personagem na mesa (o manifesto cria HP, MP, EN e ES ao dar a ficha).\n   A ficha calcula o máximo de HP/MP/EN/ES pelas regras e o grava por bars.adjust; o atual\n   muda por bars.adjust (editar), bars.spend (Usar habilidade) e os descansos. */\nconst RES = [\n  ['hp', 'HP', '#c9705a'],\n  ['mp', 'MP', '#7f9fd6'],\n  ['en', 'EN', '#8fb39a'],\n  ['es', 'ES', '#b29ad6'],\n];\nconst PALETTE = {\n  gold: '#c5a46d',\n  steel: '#7f9fd6',\n  ember: '#c9705a',\n  moss: '#8fb39a',\n  ash: '#a9a497',\n};\nconst barKey = (l) =>\n  String(l || '')\n    .normalize('NFD')\n    .replace(/\\p{M}/gu, '')\n    .trim()\n    .toLowerCase();\nconst tableBar = (label) => VIEW.bars.find((b) => barKey(b.label) === barKey(label)) || null;\nconst resOf = (b) => RES.find((r) => barKey(r[1]) === barKey(b.label)) || null;\nconst colorOfBar = (b) => (resOf(b) ? resOf(b)[2] : PALETTE[b.color] || PALETTE.gold);\nconst sortedBars = () => [...VIEW.bars].sort((a, b) => a.position - b.position);\n\nconst level = () => Math.max(1, filled(getP('f.nivel')) ? num(getP('f.nivel')) : 1);\n/* regras de nível: ES máximo +2 por nível; bônus de treino +1 a cada nível múltiplo de 4 */\nconst autoTrainBonus = () => 2 + Math.floor(level() / 4);\nconst trainBonus = () => (filled(getP('f.treino')) ? num(getP('f.treino')) : autoTrainBonus());\nfunction autoMax(t) {\n  const lv = level();\n  const b = (k) => num(getP(`res.${k}.base`)) * lv;\n  const enAttr = getP('res.en.attr') === 'sab' ? t.sab : t.con;\n  return {\n    hp: 12 + (t.con * 2 + t.for) + b('hp'),\n    mp: 10 + (t.sab * 2 + t.int) + b('mp'),\n    en: 10 + (t.des * 2 + enAttr) + b('en'),\n    es: 15 + 2 * (lv - 1),\n  };\n}\nconst wantedMax = (k, t) =>\n  filled(getP(`res.${k}.max`)) ? num(getP(`res.${k}.max`)) : autoMax(t)[k];\n\nfunction barRow(b) {\n  const r = resOf(b);\n  const label = esc(b.label);\n  const max = r\n    ? bare(\n        `res.${r[0]}.max`,\n        '0',\n        'in num',\n        `inputmode=\"numeric\" aria-label=\"${label}: máximo\" title=\"Vazio usa a conta automática\"`,\n        'max-' + r[0],\n      )\n    : `<input type=\"text\" class=\"in num\" inputmode=\"numeric\" data-barmax=\"${b.id}\" aria-label=\"${label}: máximo\">`;\n  const reset = r\n    ? `<button type=\"button\" class=\"mini-btn\" data-reset=\"${r[0]}\" data-edit-only title=\"Voltar para a conta automática\" aria-label=\"${label}: voltar para a conta automática\" hidden>${ic('reset', 14)}</button>`\n    : '';\n  return `<div class=\"bar-row\" style=\"--c:${colorOfBar(b)}\"><div class=\"bar-n\"><label class=\"bar-name\" for=\"cur-${b.id}\">${label}</label></div><div class=\"bar\"><i data-fill=\"${b.id}\"></i></div>\n    <div class=\"bar-c\"><input type=\"text\" class=\"in num\" id=\"cur-${b.id}\" inputmode=\"numeric\" data-barcur=\"${b.id}\"></div><span class=\"bar-s\">/</span>\n    <div class=\"bar-m\">${max}</div><div class=\"bar-t\">${reset}</div></div>`;\n}\nfunction renderBars() {\n  const box = document.getElementById('bars');\n  const bars = sortedBars();\n  box.innerHTML = bars.length\n    ? `<div class=\"bar-row head\" aria-hidden=\"true\"><span></span><span></span><span class=\"lbl\">Atual</span><span></span><span class=\"lbl\">Máximo</span><span></span></div>` +\n      bars.map(barRow).join('')\n    : '<p class=\"hint\">Sem barras: quem tem a ficha ainda não tem barras na mesa.</p>';\n}\n/* o que vem da mesa; o campo com foco não é sobrescrito enquanto alguém digita */\nfunction paintBars() {\n  for (const b of VIEW.bars) {\n    const cur = document.querySelector(`[data-barcur=\"${b.id}\"]`);\n    if (cur && document.activeElement !== cur) cur.value = b.current;\n    const max = document.querySelector(`[data-barmax=\"${b.id}\"]`);\n    if (max && document.activeElement !== max) max.value = b.max;\n    const fill = document.querySelector(`[data-fill=\"${b.id}\"]`);\n    if (fill) fill.style.width = pct(b.current, b.max) + '%';\n  }\n}\nconst miniRow = (label, color, cur, max) =>\n  `<div class=\"mini-row\" style=\"--c:${color}\"><b>${esc(label)}</b><div class=\"bar\"><i style=\"width:${pct(cur, max)}%\"></i></div><span>${cur}/${max}</span></div>`;\nfunction calcBars(t) {\n  const auto = autoMax(t);\n  for (const [k] of RES) {\n    const rv = document.getElementById('rv-' + k);\n    if (rv) rv.textContent = auto[k];\n    const max = document.getElementById('max-' + k);\n    if (max) max.placeholder = auto[k];\n    const reset = document.querySelector(`[data-reset=\"${k}\"]`);\n    if (reset) reset.hidden = !filled(getP(`res.${k}.max`));\n  }\n  document.getElementById('mini').innerHTML = sortedBars()\n    .map((b) => miniRow(b.label.slice(0, 4).toUpperCase(), colorOfBar(b), b.current, b.max))\n    .join('');\n}\n\nfunction adjustBar(id, change) {\n  return lorkarium.bars\n    .adjust(id, change)\n    .catch((e) => setStatus('A barra não mudou: ' + failText(e)));\n}\nfunction syncBarMaxes() {\n  const t = totals();\n  for (const [k, l] of RES) {\n    const b = tableBar(l);\n    const want = wantedMax(k, t);\n    if (b && want >= 1 && want !== b.max) adjustBar(b.id, { op: 'max', value: want });\n  }\n  for (const [b, want] of contaMaxes(t)) {\n    if (want !== b.max) adjustBar(b.id, { op: 'max', value: want });\n  }\n}\n\n/* custo nas barras: hab.<id>.custos.<id> = { bar: rótulo da barra, v }; tudo ou nada (bars.spend) */\nfunction costsOf(habId) {\n  const sums = {};\n  for (const [, c] of itemsOf(`hab.${habId}.custos`)) {\n    if (filled(c.bar) && num(c.v) > 0) sums[c.bar] = (sums[c.bar] || 0) + num(c.v);\n  }\n  return Object.entries(sums);\n}\nfunction shortOf(costs) {\n  for (const [label, v] of costs) {\n    const b = tableBar(label);\n    if (b && b.current < v) return `${b.label} insuficiente: tem ${b.current}, precisa de ${v}.`;\n  }\n  return null;\n}\nfunction useSkill(habId) {\n  const msg = document.getElementById('use-' + habId);\n  const costs = costsOf(habId);\n  msg.classList.remove('bad');\n  if (!costs.length) {\n    msg.textContent = 'Escolha uma barra e um valor maior que zero.';\n    return;\n  }\n  lorkarium.bars.spend(costs.map(([bar, amount]) => ({ bar, amount }))).then(\n    () => {\n      msg.textContent = 'Gastou ' + costs.map(([l, v]) => `${v} de ${l}`).join(', ') + '.';\n    },\n    (e) => {\n      msg.textContent =\n        (e && e.code === 'INSUFFICIENT_BAR' && shortOf(costs)) ||\n        'Não deu para usar: ' + failText(e);\n      msg.classList.add('bad');\n    },\n  );\n}\n\n/* ES é estresse: desce no descanso; as outras barras sobem até o máximo */\nfunction restTarget(b, share, stress) {\n  if (barKey(b.label) === 'es') return Math.max(0, b.current - Math.round(stress * b.max));\n  return Math.max(b.current, Math.min(b.max, b.current + Math.round(share * b.max)));\n}\nfunction takeRest(button) {\n  const share = Number(button.dataset.bars);\n  const stress = Number(button.dataset.stress);\n  const changes = [];\n  const sent = [];\n  for (const b of sortedBars()) {\n    const next = b.max > 0 ? restTarget(b, share, stress) : b.current;\n    if (next === b.current) continue;\n    changes.push(`${b.label} ${b.current} → ${next}`);\n    sent.push(adjustBar(b.id, { op: 'set', value: next }));\n  }\n  const msg = document.getElementById('rest-msg');\n  Promise.all(sent).then(() => {\n    msg.textContent =\n      `${button.dataset.rest}: ` +\n      (changes.length ? changes.join(', ') + '.' : 'nada mudou, as barras já estavam cheias.');\n  });\n}\n"
    },
    {
      "path": "js/perfil.js",
      "content": "/* ---------- Perfil ---------- */\nconst RANKS = [\n  ['madeira', 'Madeira', '#b08a5e'],\n  ['cobre', 'Cobre', '#cf7a52'],\n  ['bronze', 'Bronze', '#c39a5a'],\n  ['prata', 'Prata', '#c4cad3'],\n  ['niquel', 'Níquel', '#a3b0a8'],\n  ['ouro', 'Ouro', '#e0b84f'],\n  ['rubi', 'Rubi', '#e0607a'],\n  ['platina', 'Platina', '#d6e6ea'],\n  ['diamante', 'Diamante', '#9fe3f2'],\n  ['obsidiana', 'Obsidiana', '#9a8fc2'],\n  ['lorkarium', 'Lorkarium', '#b48cff'],\n];\n/* lista própria em vez de <select>: a opção nativa não desenha o losango colorido de cada patente */\nfunction rankField() {\n  const opts = RANKS.map(\n    ([v, l, c]) =>\n      `<li role=\"option\" id=\"rank-${v}\" data-rank=\"${v}\" aria-selected=\"false\" style=\"--c:${c}\"><span class=\"rank-gem\"></span>${l}<span class=\"rank-chk\">${ic('check', 14)}</span></li>`,\n  ).join('');\n  return `<div class=\"fld\"><span class=\"lbl\" id=\"rank-l\">Patente de aventureiro</span><div class=\"rank\" id=\"rank-wrap\">\n    <button type=\"button\" class=\"in rank-btn\" id=\"rank-btn\" aria-haspopup=\"listbox\" aria-expanded=\"false\" aria-labelledby=\"rank-l rank-btn\"><span class=\"rank-gem\"></span><span id=\"rank-val\"></span>${ic('chev', 14)}</button>\n    <ul class=\"rank-list\" id=\"rank-list\" role=\"listbox\" tabindex=\"-1\" aria-labelledby=\"rank-l\" hidden>${opts}</ul></div></div>`;\n}\nconst currentRank = () => RANKS.find((r) => r[0] === getP('f.patente')) || RANKS[0];\nfunction paintRank() {\n  const [v, l, c] = currentRank();\n  const wrap = document.getElementById('rank-wrap');\n  wrap.style.setProperty('--c', c);\n  document.getElementById('rank-val').textContent = l;\n  wrap\n    .querySelectorAll('[data-rank]')\n    .forEach((li) => li.setAttribute('aria-selected', String(li.dataset.rank === v)));\n}\nfunction setActiveRank(li) {\n  const list = document.getElementById('rank-list');\n  list.querySelectorAll('.active').forEach((o) => o.classList.remove('active'));\n  li.classList.add('active');\n  list.setAttribute('aria-activedescendant', li.id);\n  if (li.scrollIntoView) li.scrollIntoView({ block: 'nearest' });\n}\nfunction openRank(open) {\n  const btn = document.getElementById('rank-btn');\n  const list = document.getElementById('rank-list');\n  list.hidden = !open;\n  btn.setAttribute('aria-expanded', String(open));\n  if (!open) return;\n  setActiveRank(document.getElementById('rank-' + currentRank()[0]));\n  list.focus();\n}\nfunction pickRank(v) {\n  patch('f.patente', v);\n  paintRank();\n  openRank(false);\n  document.getElementById('rank-btn').focus();\n}\nfunction onRankKey(e) {\n  const list = document.getElementById('rank-list');\n  const items = [...list.children];\n  const at = items.findIndex((li) => li.classList.contains('active'));\n  const moves = { ArrowDown: at + 1, ArrowUp: at - 1, Home: 0, End: items.length - 1 };\n  if (e.key in moves) {\n    e.preventDefault();\n    setActiveRank(items[Math.max(0, Math.min(items.length - 1, moves[e.key]))]);\n    return;\n  }\n  if (e.key === 'Enter' || e.key === ' ') {\n    e.preventDefault();\n    pickRank(items[at].dataset.rank);\n    return;\n  }\n  if (e.key === 'Escape' || e.key === 'Tab') {\n    e.preventDefault();\n    openRank(false);\n    document.getElementById('rank-btn').focus();\n  }\n}\n\n/* o retrato é o do personagem na mesa: trocar aqui é character.setImage */\nconst portraitSlot = () =>\n  `<div class=\"img-slot portrait\" data-portrait data-label=\"Trocar o retrato\"><button type=\"button\" class=\"img-btn\"></button><input type=\"file\" accept=\"image/png,image/jpeg,image/webp\" hidden aria-label=\"Arquivo: retrato\"><p class=\"img-note\" id=\"portrait-note\" hidden></p></div>`;\nconst pgPerfil = () => `\n  <section class=\"hero\">\n    ${portraitSlot()}\n    <div>\n      <p class=\"eyebrow\">Aventureiro de Lork</p>\n      ${bare('f.nome', 'Nome do personagem', 'hero-name', 'aria-label=\"Nome do personagem\"')}\n      <button type=\"button\" class=\"hero-sub\" id=\"hero-sub\" data-goto=\"origem\" data-keep title=\"Editar na aba Origem\"></button>\n      <div class=\"facts facts-4\">\n        ${field('Nível', 'f.nivel', '1', '', 'inputmode=\"numeric\"')}${rankField()}${field('Equipe', 'f.equipe')}${field('Idade', 'f.idade')}\n        ${['Sexo', 'Sexualidade', 'Altura', 'Peso'].map((l) => field(l, 'f.' + slug(l))).join('')}\n      </div>\n    </div>\n  </section>\n  <div class=\"stats\">\n    <div class=\"stat\"><span class=\"eyebrow\">CA</span><b id=\"st-ca\">—</b><small id=\"st-ca-sub\"></small></div>\n    <div class=\"stat\"><span class=\"eyebrow\">CD</span><b id=\"st-cd\">—</b><small id=\"st-cd-sub\"></small></div>\n    <div class=\"stat\"><span class=\"eyebrow\">Bônus de treino</span><b id=\"st-tb\">+2</b><small>Perícias treinadas</small></div>\n  </div>\n  <section class=\"blk\"><div class=\"blk-hd\"><h2 class=\"h2\">Barras</h2><p class=\"hint\">As barras do personagem na mesa. O máximo de HP, MP, EN e ES segue as contas dos Atributos.</p></div>\n    <div class=\"bars\" id=\"bars\"></div></section>\n  <section class=\"blk\"><div class=\"blk-hd\"><h2 class=\"h2\">Descrição mental</h2><p class=\"hint\">Como ele tende a agir.</p></div>${rich('', 'f.mental', 'Temperamento, manias, medos, o que o move…', 'tall')}</section>\n  <section class=\"blk\"><div class=\"blk-hd\"><h2 class=\"h2\">Descrição física</h2><p class=\"hint\">O que não está na imagem: modo de se portar, cicatrizes, trejeitos.</p></div>${rich('', 'f.fisica', 'Como ele anda, fala, se veste…', 'tall')}</section>`;\n\n/* nome e retrato: os da ficha quando preenchidos, senão os do personagem na mesa */\nfunction renderWho() {\n  const raca = getP('origem.raca.nome');\n  const classe = getP('origem.classe.nome');\n  const tableName =\n    (VIEW.character && VIEW.character.name) || (VIEW.token && VIEW.token.name) || '';\n  document.getElementById('who-name').textContent = getP('f.nome') || tableName || 'Sem nome';\n  document.getElementById('who-sub').textContent =\n    [raca, classe].filter(filled).join(' · ') || 'Raça · Classe';\n  const part = (v, ph) => (filled(v) ? `<span>${esc(v)}</span>` : `<span class=\"ph\">${ph}</span>`);\n  document.getElementById('hero-sub').innerHTML =\n    `${part(raca, 'Raça')}<span aria-hidden=\"true\">·</span>${part(classe, 'Classe')}`;\n  document.getElementById('who-img').style.backgroundImage = portraitUrl\n    ? `url(\"${portraitUrl}\")`\n    : '';\n}\n"
    },
    {
      "path": "js/origem.js",
      "content": "/* ---------- Origem ---------- */\nfunction originBlock(tag, key, ph, inner, first) {\n  const id = nid(`origem.${key}.nome`);\n  const fk = 'sec.' + key;\n  return `<section class=\"blk ${first ? 'first' : ''}\" data-foldbox=\"${fk}\">\n    <div class=\"blk-hd\"><div class=\"sec-hd\"><label class=\"eyebrow\" for=\"${id}\">${tag}</label>${foldBtn(fk, tag)}</div>${bare(`origem.${key}.nome`, ph, 'big-name', '', id)}</div>\n    ${optImg(`origem.${key}.img`)}\n    ${inner}\n  </section>`;\n}\nfunction classBases() {\n  const rows = RES.filter((r) => r[0] !== 'es')\n    .map(([k, l, c]) => {\n      const id = nid(`res.${k}.base`);\n      return `<div class=\"fld\" style=\"--c:${c}\"><label class=\"lbl\" for=\"${id}\">${l} base</label>${bare(`res.${k}.base`, '0', 'in num', 'inputmode=\"numeric\"', id)}</div>`;\n    })\n    .join('');\n  return `<div class=\"fld bases-fld\"><span class=\"lbl\">Bases da classe</span><div class=\"bases\">${rows}</div></div>`;\n}\nconst attrOptions = (none) =>\n  `<option value=\"\">${none}</option>` +\n  ATTRS.map(([k, n]) => `<option value=\"${k}\">${n}</option>`).join('');\n/* CD do personagem = 8 + bônus de treino + o atributo escolhido na classe */\nfunction cdField() {\n  const id = nid('origem.classe.cd');\n  return `<div class=\"fld bases-fld\"><label class=\"lbl\" for=\"${id}\">CD</label><div class=\"cd-row\">\n    <span>8 + Bônus de treino <b data-cdbonus>+2</b> +</span>\n    <select class=\"in\" id=\"${id}\" data-lk=\"origem.classe.cd\">${attrOptions('Escolha o atributo')}</select>\n    <b data-cdattr></b><span>=</span><output class=\"cd-val\" id=\"cd-val\">—</output></div></div>`;\n}\nconst pgOrigem = () => `\n  <header class=\"row-hd\"><div><p class=\"eyebrow\">Origem</p><h1 class=\"h1\">Raça, original e classe</h1></div>\n    <div class=\"fold-all\"><button type=\"button\" class=\"btn-ghost\" data-foldall=\"close\" data-keep>Recolher tudo</button><button type=\"button\" class=\"btn-ghost\" data-foldall=\"open\" data-keep>Mostrar tudo</button></div></header>\n  ${originBlock(\n    'Raça',\n    'raca',\n    'Qual é a sua raça?',\n    rich('Descrição', 'origem.raca.desc', 'Descreva sua raça', 'tall') +\n      rich('Efeitos', 'origem.raca.vant', 'Área do Mestre', 'tall') +\n      rich('Desvantagens', 'origem.raca.desv', 'Área do Mestre', 'tall'),\n    true,\n  )}\n  ${originBlock(\n    'Original',\n    'original',\n    'O que te torna único?',\n    rich('Descrição', 'origem.original.desc', 'Descreva seu original', 'tall') +\n      rich('Efeito', 'origem.original.efeito', 'Área do Mestre', 'tall'),\n  )}\n  ${originBlock(\n    'Classe',\n    'classe',\n    'O que você faz?',\n    rich('Descrição', 'origem.classe.desc', 'Descreva sua classe', 'tall') +\n      `<div class=\"panel class-panel\">${classBases()}<span class=\"vsep\" aria-hidden=\"true\"></span>${cdField()}</div>` +\n      rich('Efeito', 'origem.classe.efeito', 'Área do Mestre', 'tall'),\n  )}`;\n\n/* CA = a da armadura em uso; CD = a da classe; nulas enquanto não há como calcular */\nfunction statsOf(t) {\n  const a = getP('origem.classe.cd');\n  const worn = wornArmor();\n  return {\n    attr: ATTRS.some((x) => x[0] === a) ? a : '',\n    ca: worn ? caOf(worn, t).v : null,\n    cd: ATTRS.some((x) => x[0] === a) ? 8 + trainBonus() + t[a] : null,\n    worn,\n  };\n}\nfunction calcCd(t) {\n  const { attr, ca, cd, worn } = statsOf(t);\n  const bonus = trainBonus();\n  document.querySelector('[data-cdbonus]').textContent = sign(bonus);\n  document.querySelector('[data-cdattr]').textContent = attr ? `(${sign(t[attr])})` : '';\n  document.getElementById('cd-val').textContent = cd ?? '—';\n  document.getElementById('st-ca').textContent = ca ?? '—';\n  document.getElementById('st-ca-sub').textContent = worn\n    ? worn.nome || 'Armadura sem nome'\n    : 'Sem armadura em uso';\n  document.getElementById('st-cd').textContent = cd ?? '—';\n  document.getElementById('st-cd-sub').textContent = attr\n    ? `Atributo: ${ATTRS.find((x) => x[0] === attr)[1]}`\n    : 'Escolha o atributo na Classe';\n  document.getElementById('st-tb').textContent = sign(bonus);\n  document.getElementById('mini-stats').innerHTML =\n    `<span>CA<b>${ca ?? '—'}</b></span><span>CD<b>${cd ?? '—'}</b></span>`;\n}\n/* a CA e a CD calculadas vão ao personagem (character.set), que o card da mesa mostra */\nconst statValue = (v) => Math.max(0, Math.min(999, v));\nfunction pushStats() {\n  const ch = VIEW.character;\n  if (!ch) return;\n  const { ca, cd } = statsOf(totals());\n  const changes = {};\n  if (ca != null && statValue(ca) !== ch.armorClass) changes.armorClass = statValue(ca);\n  if (cd != null && statValue(cd) !== ch.difficultyClass) changes.difficultyClass = statValue(cd);\n  if (!Object.keys(changes).length) return;\n  lorkarium.character\n    .set(changes)\n    .catch((e) => setStatus('A CA e a CD não foram para a mesa: ' + failText(e)));\n}\n"
    },
    {
      "path": "js/atributos.js",
      "content": "/* ---------- Atributos ---------- */\nconst ATTRS = [\n  ['for', 'Força', 'FOR', 'fis'],\n  ['des', 'Destreza', 'DES', 'fis'],\n  ['con', 'Constituição', 'CON', 'fis'],\n  ['int', 'Inteligência', 'INT', 'men'],\n  ['car', 'Carisma', 'CAR', 'men'],\n  ['sab', 'Sabedoria', 'SAB', 'men'],\n];\nconst COLS = [\n  ['base', 'Base'],\n  ['raca', 'Raça'],\n  ['outros', 'Outros'],\n  ['up', 'UP'],\n];\nfunction attrRow([k, name]) {\n  const cells = COLS.map(\n    ([c, l], i) =>\n      `<td>${bare(`at.${k}.${c}`, '0', 'in num', `inputmode=\"numeric\" aria-label=\"${name}: ${l}\"`)}</td><td class=\"op\">${i < 3 ? '+' : '='}</td>`,\n  ).join('');\n  return `<tr><th scope=\"row\">${name}</th>${cells}<td class=\"tot\" id=\"tot-${k}\">0</td></tr>`;\n}\nconst attrGroup = (g, label, color) =>\n  `<tr class=\"grp\" style=\"--c:${color}\"><th colspan=\"10\" scope=\"colgroup\">${label}</th></tr>${ATTRS.filter(\n    (a) => a[3] === g,\n  )\n    .map(attrRow)\n    .join('')}`;\nfunction pgAtributos() {\n  const head = COLS.map(([, l]) => `<th scope=\"col\">${l}</th><th></th>`).join('');\n  // a opção vazia é a Constituição, a conta padrão do EN\n  const enSel =\n    '<select data-lk=\"res.en.attr\" aria-label=\"Atributo do EN\"><option value=\"\">Cons</option><option value=\"sab\">Sab</option></select>';\n  const forms = {\n    hp: '12 + (Cons×2 + Força) + (Base×Nível)',\n    mp: '10 + (Sab×2 + Int) + (Base×Nível)',\n    en: `10 + (Dex×2 + ${enSel}) + (Base×Nível)`,\n    es: '15 + 2×(Nível − 1)',\n  };\n  const rows = RES.map(\n    ([k, l, c]) =>\n      `<tr style=\"--c:${c}\"><td class=\"rn\">${l}</td><td class=\"rf\">${forms[k] ?? '—'}</td><td class=\"rv\" id=\"rv-${k}\">0</td><td class=\"rx\"></td></tr>`,\n  ).join('');\n  return `${pageHead('Atributos', 'Atributos', 'Começa com 4 pontos, e dá para ganhar no máximo 2 pontos deixando atributos negativos.')}\n    <section class=\"blk first\">\n      <ul class=\"checks\" id=\"checks\"></ul>\n      <div class=\"tbl-wrap\"><table class=\"attr\"><thead><tr><th></th>${head}<th scope=\"col\">Total</th></tr></thead>\n        <tbody>${attrGroup('fis', 'Físicos', 'var(--ember-l)')}${attrGroup('men', 'Mentais', 'var(--steel-l)')}</tbody></table></div>\n    </section>\n    <section class=\"blk\"><div class=\"blk-hd\"><h2 class=\"h2\">Contas das barras</h2><p class=\"hint\">O máximo de HP, MP, EN e ES segue a conta fixa, a menos que se escreva outro no Perfil. Outras barras da mesa podem ganhar uma conta: números, + − × ÷, parênteses, FOR, DES, CON, INT, CAR, SAB, Nível e Treino.</p></div>\n      <div class=\"tbl-wrap\"><table class=\"res\"><thead><tr><th>Barra</th><th>Fórmula</th><th style=\"text-align:right\">Máximo</th><th></th></tr></thead><tbody>${rows}</tbody><tbody id=\"contas\"></tbody></table></div>\n      <button type=\"button\" class=\"sk-add\" data-add=\"contas\" data-edit-only>${ic('plus', 12)}Adicionar conta</button>\n    </section>`;\n}\n\nconst totals = () =>\n  Object.fromEntries(\n    ATTRS.map(([k]) => [k, COLS.reduce((s, [c]) => s + num(getP(`at.${k}.${c}`)), 0)]),\n  );\nfunction checkPoints() {\n  const bases = ATTRS.map(([k]) => num(getP(`at.${k}.base`)));\n  const gained = bases.filter((b) => b < 0).reduce((s, b) => s - b, 0);\n  const spent = bases.filter((b) => b > 0).reduce((s, b) => s + b, 0);\n  const budget = 4 + Math.min(gained, 2);\n  const item = (label, val, tone) => `<li>${label} <b class=\"${tone}\">${val}</b></li>`;\n  document.getElementById('checks').innerHTML =\n    item(\n      'Pontos',\n      `${spent}/${budget}`,\n      spent === budget ? 'ok' : spent > budget ? 'bad' : 'warn',\n    ) + item('Ganhos com negativos', `${gained}/2`, gained > 2 ? 'bad' : 'ok');\n}\n"
    },
    {
      "path": "js/contas.js",
      "content": "/* ---------- contas extras ---------- */\n/* HP, MP, EN e ES têm conta fixa (Atributos). Qualquer outra barra da mesa pode ganhar uma:\n   contas.<id> = { ordem, bar: rótulo da barra, f: fórmula }. A fórmula aceita números,\n   + − × ÷ (ou * e /), parênteses, os atributos pelo nome ou pela sigla (FOR, DES, CON, INT,\n   CAR, SAB), Nível e Treino; o resultado arredonda para baixo. Sem eval: o CSP da ficha não o\n   roda, e a fórmula é texto de quem tem a ficha. */\nconst CONTA_VARS = {\n  for: 'for',\n  forca: 'for',\n  des: 'des',\n  dex: 'des',\n  destreza: 'des',\n  con: 'con',\n  cons: 'con',\n  constituicao: 'con',\n  int: 'int',\n  inteligencia: 'int',\n  car: 'car',\n  carisma: 'car',\n  sab: 'sab',\n  sabedoria: 'sab',\n  nivel: 'nivel',\n  nv: 'nivel',\n  treino: 'treino',\n};\nconst CONTA_MAX_CHARS = 200;\nconst contaValues = (t) => Object.assign({}, t, { nivel: level(), treino: trainBonus() });\n\nfunction contaTokens(text) {\n  const src = String(text).trim().replace(/−/g, '-').replace(/×/g, '*').replace(/÷/g, '/');\n  const re = /\\s*(\\d+|\\p{L}+|[-+*/()])\\s*/uy;\n  const out = [];\n  while (re.lastIndex < src.length) {\n    const at = re.lastIndex;\n    const m = re.exec(src);\n    if (!m) throw new Error(`não entendi \"${src.slice(at).trim().slice(0, 12)}\"`);\n    out.push(m[1]);\n  }\n  return out;\n}\n\n/* soma de produtos de fatores, com parênteses e sinal na frente */\nfunction contaParser(toks, vals) {\n  let at = 0;\n  const peek = () => toks[at];\n  const take = () => toks[at++];\n  function factor() {\n    const t = take();\n    if (t === undefined) throw new Error('a conta termina no meio');\n    if (t === '-') return -factor();\n    if (t === '+') return factor();\n    if (t === '(') {\n      const v = sum();\n      if (take() !== ')') throw new Error('falta fechar um parêntese');\n      return v;\n    }\n    if (/^\\d+$/.test(t)) return Number(t);\n    const k = CONTA_VARS[barKey(t)];\n    if (k) return vals[k];\n    throw new Error(`não conheço \"${t}\"`);\n  }\n  function product() {\n    let v = factor();\n    while (peek() === '*' || peek() === '/') {\n      const op = take();\n      const r = factor();\n      if (op === '/' && r === 0) throw new Error('divisão por zero');\n      v = op === '*' ? v * r : v / r;\n    }\n    return v;\n  }\n  function sum() {\n    let v = product();\n    while (peek() === '+' || peek() === '-') v = take() === '+' ? v + product() : v - product();\n    return v;\n  }\n  return { sum, rest: () => toks.slice(at) };\n}\n\n/* { ok: true, value } ou { ok: false, why } com o motivo em palavras */\nfunction evalConta(text, vals) {\n  if (String(text).length > CONTA_MAX_CHARS) return { ok: false, why: 'conta longa demais' };\n  try {\n    const toks = contaTokens(text);\n    if (!toks.length) return { ok: false, why: 'conta vazia' };\n    const parser = contaParser(toks, vals);\n    const value = parser.sum();\n    const rest = parser.rest();\n    if (rest.length) throw new Error(`sobrou \"${rest.join(' ')}\"`);\n    return { ok: true, value: Math.floor(value) };\n  } catch (e) {\n    return { ok: false, why: e.message };\n  }\n}\n\n/* só barras sem conta fixa; a guardada fica na lista mesmo se a barra sumiu da mesa */\nfunction contaBarOptions(stored) {\n  const labels = sortedBars()\n    .filter((b) => !resOf(b))\n    .map((b) => b.label);\n  if (filled(stored) && !labels.some((l) => barKey(l) === barKey(stored))) labels.push(stored);\n  return (\n    '<option value=\"\">Escolha a barra</option>' +\n    labels.map((l) => `<option value=\"${esc(l)}\">${esc(l)}</option>`).join('')\n  );\n}\nfunction contaRow([id]) {\n  const p = 'contas.' + id;\n  const b = tableBar(getP(p + '.bar'));\n  return `<tr style=\"--c:${b ? colorOfBar(b) : 'var(--dim)'}\">\n    <td class=\"rn\"><select class=\"cost-bar conta-bar\" data-lk=\"${p}.bar\" aria-label=\"Barra da conta\">${contaBarOptions(getP(p + '.bar'))}</select></td>\n    <td class=\"rf\">${bare(p + '.f', 'ex.: 10 + DES×2 + Nível', 'in conta-f', 'aria-label=\"Fórmula da conta\"')}<p class=\"conta-why bad\" id=\"cw-${id}\" role=\"status\"></p></td>\n    <td class=\"rv\" id=\"cv-${id}\">—</td>\n    <td class=\"rx\"><button type=\"button\" class=\"sk-x\" data-rm=\"contas:${id}\" data-arm-icon data-edit-only aria-label=\"Tirar a conta\">${ic('x', 12)}</button></td></tr>`;\n}\nfunction renderContas() {\n  const box = document.getElementById('contas');\n  if (box) box.innerHTML = itemsOf('contas').map(contaRow).join('');\n}\nfunction calcContas(t) {\n  const vals = contaValues(t);\n  for (const [id, c] of itemsOf('contas')) {\n    const out = document.getElementById('cv-' + id);\n    const why = document.getElementById('cw-' + id);\n    if (!out || !why) continue;\n    const r = filled(c.f) ? evalConta(c.f, vals) : null;\n    out.textContent = r && r.ok ? r.value : '—';\n    why.textContent = r && !r.ok ? `Conta inválida: ${r.why}.` : '';\n  }\n}\n/* [barra da mesa, máximo] das contas válidas; duas contas na mesma barra: vale a última */\nfunction contaMaxes(t) {\n  const vals = contaValues(t);\n  const byBar = new Map();\n  for (const [, c] of itemsOf('contas')) {\n    const b = tableBar(c.bar);\n    if (!b || resOf(b) || !filled(c.f)) continue;\n    const r = evalConta(c.f, vals);\n    if (r.ok && r.value >= 1) byBar.set(b.id, [b, r.value]);\n  }\n  return [...byBar.values()];\n}\n"
    },
    {
      "path": "js/pericias.js",
      "content": "/* ---------- Perícias ---------- */\nconst PERICIAS = [\n  [\n    'Físicos',\n    'var(--ember-l)',\n    [\n      ['Força', 'for', ['Atletismo', 'Arremesso', 'Carregar']],\n      ['Destreza', 'des', ['Acrobacia', 'Furtividade', 'Reflexos', 'Prestidigitação', 'Condução+']],\n      ['Constituição', 'con', ['Resistência', 'Fôlego', 'Ignorar Dor', 'Imunidade']],\n    ],\n  ],\n  [\n    'Mentais',\n    'var(--steel-l)',\n    [\n      [\n        'Inteligência',\n        'int',\n        [\n          'Conhecimento+',\n          'Ofícios+',\n          'Medicina',\n          'Manha',\n          'Percepção Mágica',\n          'História',\n          'Religião',\n          'Natureza',\n          'Investigação',\n        ],\n      ],\n      [\n        'Carisma',\n        'car',\n        ['Sex Appeal', 'Persuasão', 'Adestrar Animais', 'Intimidação', 'Performance'],\n      ],\n      ['Sabedoria', 'sab', ['Intuição', 'Empatia', 'Sobrevivência', 'Força Mental', 'Percepção']],\n    ],\n  ],\n];\n/* per.<perícia> guarda o multiplicador do bônus de treino: ausente (não treinada), 0.5, 1, 1.5 ou 2 */\nconst NEXT_MULT = { 1: 1.5, 1.5: 2, 2: 0.5, 0.5: 1 };\nconst multOf = (v) => (v === true ? 1 : typeof v === 'number' ? v : 0);\nconst multLabel = (m) => (m === 0.5 ? '½×' : String(m).replace('.', ',') + '×');\nconst multBtn = (p, name) =>\n  `<button type=\"button\" class=\"sk-mult\" data-mult=\"${p}\" title=\"Multiplicador do bônus de treino\" aria-label=\"${name}: multiplicador do bônus de treino\" hidden></button>`;\nfunction skSingle(name, attr) {\n  const p = 'per.' + slug(name);\n  return `<div class=\"sk\"><button type=\"button\" class=\"sk-tog\" data-tr=\"${p}\" aria-pressed=\"false\"><span class=\"gem\"></span><span class=\"sk-n\">${name}</span></button>\n    ${multBtn(p, name)}<span class=\"sk-v\" data-mod=\"${p}\" data-attr=\"${attr}\">+0</span></div>`;\n}\n/* perícias com vários itens (Conhecimento de quê?) são listas com id estável */\nfunction skMulti(name, attr) {\n  const k = slug(name);\n  const rows = itemsOf('perlist.' + k)\n    .map(([id]) => {\n      const p = `perlist.${k}.${id}`;\n      return `<div class=\"sk sub\"><button type=\"button\" class=\"sk-tog only\" data-tr=\"${p}.t\" aria-pressed=\"false\" aria-label=\"${name}: treinada\"><span class=\"gem\"></span></button>\n      ${bare(p + '.def', 'Qual?', 'sk-def', `aria-label=\"${name}: qual\"`)}${multBtn(p + '.t', name)}<span class=\"sk-v\" data-mod=\"${p}.t\" data-attr=\"${attr}\">+0</span>\n      <button type=\"button\" class=\"sk-x\" data-prm=\"${k}:${id}\" data-edit-only aria-label=\"Remover ${name.toLowerCase()}\">${ic('x', 12)}</button></div>`;\n    })\n    .join('');\n  return `<div class=\"sk-multi\"><span>${name}</span><button type=\"button\" class=\"sk-add\" data-padd=\"${k}\" data-edit-only>${ic('plus', 12)}Adicionar</button></div>${rows}`;\n}\nconst skRow = (name, attr) =>\n  name.endsWith('+') ? skMulti(name.slice(0, -1), attr) : skSingle(name, attr);\nconst skGroup = ([name, attr, list]) =>\n  `<section><div class=\"sk-grp-hd\"><h3>${name}</h3><span class=\"sk-at\">${ATTRS.find((a) => a[0] === attr)[2]} <span data-attrtot=\"${attr}\">+0</span></span></div>${list\n    .map((n) => skRow(n, attr))\n    .join('')}</section>`;\nfunction renderPericias() {\n  document.getElementById('sk-board').innerHTML = PERICIAS.map(\n    ([label, color, groups]) =>\n      `<div style=\"--c:${color}\"><p class=\"eyebrow\" style=\"margin-bottom:14px\">${label}</p><div class=\"sk-cols\">${groups.map(skGroup).join('')}</div></div>`,\n  ).join('');\n}\nconst pgPericias = () => `\n  ${pageHead('Perícias', 'Perícias', 'Escolha 4 perícias iniciais.')}\n  <section class=\"blk first\"><div class=\"train\"><label class=\"eyebrow\" for=\"train-in\">Bônus de treino</label>\n      ${bare('f.treino', '2', 'in num', 'inputmode=\"numeric\" title=\"Vazio usa a conta pelo nível\"', 'train-in')}\n      <button type=\"button\" class=\"mini-btn\" data-resettrain data-edit-only title=\"Voltar para a conta pelo nível\" aria-label=\"Bônus de treino: voltar para a conta pelo nível\" hidden>${ic('reset', 14)}</button></div>\n    <div class=\"sk-board\" id=\"sk-board\"></div></section>`;\nfunction calcPericias(t) {\n  document.querySelectorAll('[data-attrtot]').forEach((el) => {\n    el.textContent = sign(t[el.dataset.attrtot]);\n  });\n  const bonus = trainBonus();\n  document.getElementById('train-in').placeholder = autoTrainBonus();\n  document.querySelector('[data-resettrain]').hidden = !filled(getP('f.treino'));\n  document.querySelectorAll('[data-mod]').forEach((m) => {\n    m.textContent = sign(t[m.dataset.attr] + Math.round(bonus * multOf(getP(m.dataset.mod))));\n  });\n  document.querySelectorAll('[data-mult]').forEach((b) => {\n    const m = multOf(getP(b.dataset.mult));\n    b.hidden = !m;\n    b.textContent = multLabel(m);\n  });\n  document\n    .querySelectorAll('[data-tr]')\n    .forEach((b) => b.setAttribute('aria-pressed', String(!!multOf(getP(b.dataset.tr)))));\n}\n"
    },
    {
      "path": "js/listas.js",
      "content": "/* ---------- entradas em lista (habilidades, extras, itens) ---------- */\nfunction entry(list, id, i, namePh, main, side) {\n  const key = `${list}:${id}`;\n  const open = !UI.closed[key];\n  return `<article class=\"entry ${open ? '' : 'closed'}\" data-entry=\"${key}\">\n    <div class=\"entry-hd\"><span class=\"entry-idx\">${String(i + 1).padStart(2, '0')}</span>\n      ${bare(`${list}.${id}.nome`, namePh, 'entry-name', `aria-label=\"${esc(namePh)}\"`)}\n      <span class=\"entry-meta\"></span>\n      <button type=\"button\" class=\"mini-btn danger\" data-rm=\"${key}\" data-edit-only data-confirm=\"Remover?\" title=\"Remover\" aria-label=\"Remover\">${ic('trash', 14)}</button>\n      <button type=\"button\" class=\"mini-btn chev\" data-toggle=\"${key}\" data-keep aria-expanded=\"${open}\" aria-label=\"Mostrar ou esconder\">${ic('chev', 14)}</button></div>\n    <div class=\"entry-body\"><div class=\"spec\">${side}</div>${main}</div>\n  </article>`;\n}\nfunction habCard(id, i) {\n  const p = 'hab.' + id;\n  return entry(\n    'hab',\n    id,\n    i,\n    'Nome da habilidade',\n    costBlock(id) +\n      optImg(p + '.img') +\n      rich('Descrição', p + '.desc', 'Descreva sua habilidade aqui') +\n      bare(p + '.frase', '“Frase de efeito”', 'quote', 'aria-label=\"Frase de efeito\"') +\n      rich('Efeito', p + '.efeito', 'Definido pelo mestre', 'tall'),\n    specIn('Nível', p + '.nivel', '1', 'inputmode=\"numeric\"') +\n      specIn('Tipo', p + '.tipo', 'Físico, Mental, Marcial…') +\n      specIn('Funcionalidade', p + '.func', 'Buff, Debuff, Ofensiva…') +\n      specRich('Custo de ativação', p + '.ativ', 'Mestre') +\n      specRich('Cooldown', p + '.cd', 'Mestre'),\n  );\n}\n/* as opções são as barras da mesa; um rótulo guardado que sumiu da mesa continua na lista */\nfunction barOptions(stored) {\n  const labels = sortedBars().map((b) => b.label);\n  if (filled(stored) && !labels.some((l) => barKey(l) === barKey(stored))) labels.push(stored);\n  return labels.map((l) => `<option value=\"${esc(l)}\">${esc(l)}</option>`).join('');\n}\nfunction costRow(habId, costId) {\n  const p = `hab.${habId}.custos.${costId}`;\n  return `<div class=\"cost\"><select class=\"cost-bar\" data-lk=\"${p}.bar\" aria-label=\"Barra que paga o custo\">${barOptions(getP(p + '.bar'))}</select>\n    ${bare(p + '.v', '0', 'cost-v', 'inputmode=\"numeric\" aria-label=\"Quanto sai da barra\"')}\n    <button type=\"button\" class=\"sk-x\" data-rmcost=\"${habId}:${costId}\" data-edit-only aria-label=\"Desvincular barra\">${ic('x', 12)}</button></div>`;\n}\n/* fora da faixa da ficha técnica: com várias barras vinculadas ele cresce sem esticar as outras células */\nfunction costBlock(habId) {\n  const rows = itemsOf(`hab.${habId}.custos`)\n    .map(([costId]) => costRow(habId, costId))\n    .join('');\n  return `<div class=\"cost-block\"><span class=\"lbl\">Custo</span>\n    <div class=\"costs\">${rows}<button type=\"button\" class=\"sk-add\" data-addcost=\"${habId}\" data-edit-only>${ic('plus', 12)}Vincular barra</button></div>\n    ${rows ? `<button type=\"button\" class=\"btn-use\" data-use=\"${habId}\">Usar habilidade</button>` : ''}\n    <p class=\"use-msg\" id=\"use-${habId}\" role=\"status\"></p></div>`;\n}\nfunction extraCard(id, i) {\n  const p = 'extras.' + id;\n  return entry(\n    'extras',\n    id,\n    i,\n    'Nome do extra',\n    optImg(p + '.img') +\n      rich('Descrição', p + '.desc', 'O que faz…') +\n      rich('Efeito', p + '.efeito', 'Definido pelo mestre', 'tall'),\n    specIn('Tipo', p + '.tipo', 'Passiva ou ativa') +\n      specIn('Origem', p + '.origem', 'Como foi adquirida'),\n  );\n}\nfunction itemCard(list, id, i, namePh, withQty) {\n  const p = `${list}.${id}`;\n  return entry(\n    list,\n    id,\n    i,\n    namePh,\n    (list === 'armaduras' ? caBlock(p) : '') +\n      optImg(p + '.img') +\n      rich('Descrição', p + '.desc', 'Aparência, história, de onde veio…') +\n      rich('Efeito', p + '.efeito', 'Dano, durabilidade, propriedades…', 'tall'),\n    specIn('Qualidade', p + '.qual') +\n      specIn('Material', p + '.mat') +\n      specIn('Peso', p + '.peso') +\n      (withQty ? specIn('Quantidade', p + '.qtd', '1', 'inputmode=\"numeric\"') : '') +\n      specCarry(p),\n  );\n}\n/* <item>.guardado = true quando não está com o personagem: aí o peso não entra na carga */\nfunction specCarry(p) {\n  const id = nid(p + '.carrega');\n  return `<div class=\"spec-row carry\"><label class=\"lbl\" for=\"${id}\">Carregando</label>\n    <label class=\"carry-box\"><input type=\"checkbox\" id=\"${id}\" data-carry=\"${p}\"><span class=\"carry-txt\"></span></label></div>`;\n}\nconst isCarried = (it) => !(it && it.guardado);\nfunction paintCarry(box) {\n  box.checked = isCarried(getP(box.dataset.carry));\n  box.nextElementSibling.textContent = box.checked ? 'Sim, conta no peso' : 'Não, guardado';\n}\n\n/* CA da armadura: valor fixo; ou valor + atributo; ou valor + atributo limitado (caLim) */\nfunction caBlock(p) {\n  const id = nid(p + '.ca');\n  const wid = nid(p + '.emUso');\n  return `<div class=\"ca panel\"><p class=\"eyebrow\">CA da armadura</p><div class=\"ca-row\">\n    <label class=\"ca-f\" for=\"${id}\">Valor${bare(p + '.ca', '0', 'in num', 'inputmode=\"numeric\"', id)}</label>\n    <span class=\"ca-op\">+</span>\n    <label class=\"ca-f\">Atributo<select class=\"in\" data-lk=\"${p}.caAttr\">${attrOptions('Nenhum')}</select></label>\n    <label class=\"ca-f\" data-calim=\"${p}\">Limite${bare(p + '.caLim', 'Sem', 'in num', 'inputmode=\"numeric\" aria-label=\"Limite do atributo\"')}</label>\n    <span class=\"ca-op\">=</span><div class=\"ca-res\"><span>CA</span><output class=\"ca-val\" data-ca=\"${p}\">0</output></div></div>\n    <p class=\"ca-form\" data-caform=\"${p}\"></p>\n    <label class=\"wear\" for=\"${wid}\"><input type=\"checkbox\" id=\"${wid}\" data-wear=\"${p}\"><span>Em uso: é a CA do personagem</span></label></div>`;\n}\n/* só uma armadura em uso; vestir também marca como carregando */\nconst wornArmor = () =>\n  itemsOf('armaduras')\n    .map(([, a]) => a)\n    .find((a) => a.emUso && isCarried(a));\nfunction setWorn(p, on) {\n  const pairs = itemsOf('armaduras')\n    .filter(([id, a]) => a.emUso && !(on && `armaduras.${id}` === p))\n    .map(([id]) => [`armaduras.${id}.emUso`, null]);\n  if (on) pairs.push([p + '.emUso', true], [p + '.guardado', null]);\n  return patchMany(pairs);\n}\nfunction caOf(it, t) {\n  const base = num(it.ca);\n  const a = it.caAttr;\n  const name = (ATTRS.find((x) => x[0] === a) || [])[2];\n  if (!a || !name) return { v: base, txt: 'Valor fixo' };\n  const raw = t[a];\n  const lim = filled(it.caLim) ? num(it.caLim) : null;\n  const used = lim == null ? raw : Math.min(raw, lim);\n  const limTxt =\n    lim == null ? '' : `, limite ${sign(lim)}${raw > lim ? `: conta ${sign(used)}` : ''}`;\n  return { v: base + used, txt: `${base} + ${name} (${sign(raw)}${limTxt})` };\n}\nfunction calcArmor(t) {\n  for (const [id, it] of itemsOf('armaduras')) {\n    const p = 'armaduras.' + id;\n    const out = document.querySelector(`[data-ca=\"${p}\"]`);\n    if (!out) continue;\n    const ca = caOf(it, t);\n    out.textContent = ca.v;\n    document.querySelector(`[data-caform=\"${p}\"]`).textContent = ca.txt;\n    document.querySelector(`[data-calim=\"${p}\"]`).hidden = !it.caAttr;\n  }\n}\nconst LISTS = {\n  hab: { card: habCard, add: 'Adicionar habilidade' },\n  extras: { card: extraCard, add: 'Adicionar extra' },\n  armas: {\n    card: (id, i) => itemCard('armas', id, i, 'Nome da arma', false),\n    add: 'Adicionar arma',\n  },\n  armaduras: {\n    card: (id, i) => itemCard('armaduras', id, i, 'Nome da armadura', false),\n    add: 'Adicionar armadura',\n  },\n  equip: {\n    card: (id, i) => itemCard('equip', id, i, 'Nome do equipamento', true),\n    add: 'Adicionar equipamento',\n  },\n};\nconst listBox = (name) =>\n  `<div class=\"list\" id=\"list-${name}\"></div><div class=\"add-row\" data-edit-only><button type=\"button\" class=\"btn-ghost\" data-add=\"${name}\">${ic('plus', 14)}${LISTS[name].add}</button></div>`;\nfunction renderList(name) {\n  const box = document.getElementById('list-' + name);\n  box.innerHTML = itemsOf(name)\n    .map(([id], i) => LISTS[name].card(id, i))\n    .join('');\n}\nfunction updateMeta(art) {\n  const [n, id] = art.dataset.entry.split(':');\n  const it = getP(`${n}.${id}`) || {};\n  const meta = art.querySelector('.entry-meta');\n  if (n === 'hab') {\n    meta.textContent = ['Nível ' + (filled(it.nivel) ? it.nivel : '1'), it.tipo, it.func]\n      .filter(filled)\n      .join(' · ');\n    return;\n  }\n  if (n === 'extras') {\n    meta.textContent = it.tipo || '';\n    return;\n  }\n  const ca = n === 'armaduras' ? `CA ${caOf(it, totals()).v}` : '';\n  const worn = n === 'armaduras' && it.emUso && isCarried(it) ? 'Em uso' : '';\n  meta.textContent = [\n    isCarried(it) ? '' : 'Guardado',\n    worn,\n    ca,\n    n === 'equip' && filled(it.qtd) ? `${it.qtd}×` : '',\n    it.qual,\n    it.mat,\n  ]\n    .filter(filled)\n    .join(' · ');\n  art.classList.toggle('stored', !isCarried(it));\n}\n\nconst pgHabilidades = () => `\n  ${pageHead('Habilidades', 'Habilidades', 'Você começa com duas habilidades nível 1.')}\n  <section class=\"blk first\">${listBox('hab')}</section>\n  <section class=\"blk\"><div class=\"blk-hd\"><h2 class=\"h2\">Extras</h2><p class=\"hint\">Habilidades que vocês adquirirem durante o jogo, sejam passivas ou ativas, normalmente as que não dá para upar com treinamento ou Lvl. Up.</p></div>${listBox('extras')}</section>`;\n"
    },
    {
      "path": "js/inventario.js",
      "content": "/* ---------- Inventário ---------- */\nconst COINS = [\n  ['Cobre', 'cobre', '#c27a4c', '#7e4a2c', '#e3a27a'],\n  ['Prata', 'prata', '#c4cad3', '#7f8691', '#e4e8ee'],\n  ['Ouro', 'ouro', '#dcb54c', '#94741f', '#f0d27e'],\n  ['Platina', 'platina', '#d3e2e6', '#8aa2aa', '#eef6f8'],\n  ['Lorkarium', 'lorkarium', '#9a6cf0', '#5a36ad', '#c4a8ff'],\n];\nfunction coinSvg(fill, rim, light, gem) {\n  const face = gem\n    ? `<path d=\"M18 9.5 23.5 17 18 25 12.5 17Z\" fill=\"${rim}\"/><path d=\"M18 9.5V25M12.5 17h11\" stroke=\"${light}\" stroke-width=\".9\" opacity=\".7\"/>`\n    : `<circle cx=\"18\" cy=\"17\" r=\"6\" fill=\"none\" stroke=\"${rim}\" stroke-width=\"1.2\" opacity=\".55\"/>`;\n  return `<svg width=\"36\" height=\"36\" viewBox=\"0 0 36 36\" aria-hidden=\"true\"><circle cx=\"18\" cy=\"18.6\" r=\"15.6\" fill=\"${rim}\"/><circle cx=\"18\" cy=\"17\" r=\"15\" fill=\"${fill}\"/>\n    <circle cx=\"18\" cy=\"17\" r=\"11.2\" fill=\"none\" stroke=\"${rim}\" stroke-width=\"1.4\" opacity=\".75\"/>${face}\n    <path d=\"M8.5 11.5A11 11 0 0 1 16 6.2\" fill=\"none\" stroke=\"${light}\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>`;\n}\nfunction coinCell([l, k, fill, rim, light]) {\n  const id = nid('moedas.' + k);\n  return `<label class=\"coin\" for=\"${id}\" style=\"--c:${light}\">${coinSvg(fill, rim, light, k === 'lorkarium')}<span><span class=\"coin-n\">${l}</span>${bare('moedas.' + k, '0', '', 'inputmode=\"numeric\"', id)}</span></label>`;\n}\nconst pgInventario = () => `\n  ${pageHead('Inventário', 'Inventário', 'Começa com uma arma e uma armadura, ou um equipamento e uma armadura.')}\n  <section class=\"blk first\"><h2 class=\"h2\">Bolsa</h2><div class=\"purse\">${COINS.map(coinCell).join('')}</div></section>\n  <section class=\"blk\"><h2 class=\"h2\">Armas</h2>${listBox('armas')}</section>\n  <section class=\"blk\"><h2 class=\"h2\">Armaduras</h2>${listBox('armaduras')}</section>\n  <section class=\"blk\"><h2 class=\"h2\">Equipamentos</h2>${listBox('equip')}</section>\n  <section class=\"blk\"><div class=\"blk-hd\"><h2 class=\"h2\">Mochila</h2><p class=\"hint\">1 slot +1 a cada ponto de Força.</p></div>\n    <div class=\"load\" id=\"load\">\n      <div class=\"load-top\"><span class=\"load-n\"><b id=\"load-used\">0</b> / <span id=\"load-cap\">1</span> slots</span><span class=\"load-state\" id=\"load-state\"></span></div>\n      <div class=\"load-bar\"><i id=\"load-fill\"></i></div>\n      <ul class=\"load-parts\" id=\"load-parts\"></ul>\n    </div>\n    <div class=\"bag\" id=\"bag\"></div>\n    <div data-edit-only><button type=\"button\" class=\"btn-ghost\" data-addbag>${ic('plus', 14)}Adicionar item</button></div></section>`;\n\nfunction renderBag() {\n  const box = document.getElementById('bag');\n  const items = itemsOf('mochila');\n  if (!items.length) {\n    box.innerHTML = '<p class=\"bag-empty\">A mochila está vazia.</p>';\n    return;\n  }\n  const rows = items.map(([id], i) => {\n    const p = 'mochila.' + id;\n    const n = i + 1;\n    return `<div class=\"slot\"><span class=\"slot-i\">${String(n).padStart(2, '0')}</span>\n      ${bare(p + '.nome', 'Nome do item', 'in', `aria-label=\"Item ${n}: nome\"`)}\n      ${bare(p + '.qtd', '1', 'in num', `inputmode=\"numeric\" aria-label=\"Item ${n}: quantidade\"`)}\n      ${bare(p + '.peso', '0', 'in num', `inputmode=\"decimal\" aria-label=\"Item ${n}: peso\"`)}\n      <span class=\"slot-sub\" data-sub=\"${id}\">0</span>\n      <button type=\"button\" class=\"sk-x\" data-rmbag=\"${id}\" data-edit-only aria-label=\"Remover item ${n}\">${ic('x', 12)}</button></div>`;\n  });\n  box.innerHTML =\n    '<div class=\"slot head\" aria-hidden=\"true\"><span></span><span>Item</span><span>Qtd</span><span>Peso</span><span>Total</span><span></span></div>' +\n    rows.join('');\n}\nconst decimal = (v) => {\n  const n = parseFloat(String(v ?? '').replace(',', '.'));\n  return Number.isFinite(n) ? n : 0;\n};\nconst fmtNum = (n) => n.toLocaleString('pt-BR', { maximumFractionDigits: 2 });\n/* peso × quantidade; quantidade vazia vale 1 */\nconst weightOf = (it) => decimal(it && it.peso) * (it && filled(it.qtd) ? decimal(it.qtd) : 1);\n/* a carga soma o peso de tudo que o personagem leva: armas, armaduras, equipamentos e a mochila */\nconst LOAD_PARTS = [\n  ['armas', 'Armas'],\n  ['armaduras', 'Armaduras'],\n  ['equip', 'Equipamentos'],\n  ['mochila', 'Mochila'],\n];\nfunction calcLoad(t) {\n  const cap = 1 + Math.max(0, t.for);\n  const parts = LOAD_PARTS.map(([k, l]) => [\n    l,\n    itemsOf(k)\n      .map(([, it]) => it)\n      .filter(isCarried)\n      .reduce((s, it) => s + weightOf(it), 0),\n  ]);\n  const used = parts.reduce((s, [, w]) => s + w, 0);\n  const over = used > cap;\n  document.getElementById('load-used').textContent = fmtNum(used);\n  document.getElementById('load-cap').textContent = cap;\n  document.getElementById('load').classList.toggle('over', over);\n  document.getElementById('load-state').textContent = over\n    ? `Acima da capacidade em ${fmtNum(used - cap)}`\n    : `${fmtNum(cap - used)} livre${cap - used === 1 ? '' : 's'}`;\n  document.getElementById('load-fill').style.width = pct(used, cap) + '%';\n  document.getElementById('load-parts').innerHTML = parts\n    .map(([l, w]) => `<li><span>${l}</span><b>${fmtNum(w)}</b></li>`)\n    .join('');\n  for (const [id, it] of itemsOf('mochila')) {\n    const el = document.querySelector(`[data-sub=\"${id}\"]`);\n    if (el) el.textContent = fmtNum(weightOf(it));\n  }\n}\n"
    },
    {
      "path": "js/regras.js",
      "content": "/* ---------- Regras ---------- */\n/* o texto das regras mora em paginas/regras.html; aqui só se lê qual vale para o próximo nível\n   e em que faixa de \"caído\" o HP está */\nfunction ruleHolds(li, n) {\n  if (li.hasAttribute('data-odd')) return n % 2 === 1;\n  if (li.hasAttribute('data-even')) return n % 2 === 0;\n  return n % num(li.dataset.every || 1) === 0;\n}\nfunction calcNextLevel() {\n  const next = level() + 1;\n  const gains = [...document.querySelectorAll('#level-rules li')].filter((li) =>\n    ruleHolds(li, next),\n  );\n  const line = (li) => {\n    const txt = li.querySelector('span').textContent;\n    return `<li style=\"${li.getAttribute('style') || ''}\">${esc(txt.charAt(0).toUpperCase() + txt.slice(1))}</li>`;\n  };\n  document.getElementById('next-lv').innerHTML =\n    `<p class=\"next-hd\"><span class=\"eyebrow\">Próximo nível</span><b>${next}</b></p><ul>${gains.map(line).join('')}</ul>`;\n}\nfunction calcFall() {\n  const hp = tableBar('HP');\n  const rows = [...document.querySelectorAll('[data-fall]')];\n  const marks = rows.map((li) => -Math.ceil(Number(li.dataset.share) * (hp ? hp.max : 0)));\n  const here =\n    !hp || hp.current > 0 ? -1 : marks.reduce((at, m, i) => (hp.current <= m ? i : at), -1);\n  rows.forEach((li, i) => {\n    li.querySelector('.thr').textContent = i === 0 ? 'HP 0' : `HP ≤ ${marks[i]}`.replace('-', '−');\n    li.classList.toggle('here', i === here);\n  });\n}\nfunction calcRules() {\n  calcNextLevel();\n  calcFall();\n}\n"
    },
    {
      "path": "js/texto-rico.js",
      "content": "/* ---------- texto rico ---------- */\n/* o HTML guardado e o colado passam por lorkarium.html.sanitize: a mesma lista de tags dos\n   botões abaixo. Imagem vai no espaço \"Adicionar imagem\" de cada entrada, não no texto. */\nconst COLORS = [\n  ['Padrão', '#eae5da'],\n  ['Ouro', '#e2c793'],\n  ['Brasa', '#e6a28f'],\n  ['Musgo', '#a9d1b4'],\n  ['Aço', '#aebcd6'],\n  ['Âmbar', '#e0a05a'],\n  ['Violeta', '#b29ad6'],\n  ['Apagado', '#a9a497'],\n];\nconst TOOLS = [\n  ['bold', '<b>B</b>', 'Negrito'],\n  ['italic', '<i class=\"serif\">I</i>', 'Itálico'],\n  ['underline', '<u>U</u>', 'Sublinhado'],\n  '|',\n  ['h4', '<span class=\"serif\">Título</span>', 'Subtítulo'],\n  ['blockquote', ic('quote'), 'Citação'],\n  ['insertUnorderedList', ic('list'), 'Lista'],\n  '|',\n  ['justifyLeft', ic('left'), 'Alinhar à esquerda'],\n  ['justifyCenter', ic('center'), 'Centralizar'],\n  '|',\n  ['color', '<span class=\"cur-sw\" id=\"cur-sw\"></span>', 'Cor do texto'],\n  ['insertHorizontalRule', ic('rule'), 'Divisor'],\n  ['removeFormat', ic('clear'), 'Limpar formatação'],\n];\nconst PRESSABLE = ['bold', 'italic', 'underline', 'insertUnorderedList'];\nfunction renderToolbar() {\n  const bar = document.getElementById('rtbar');\n  bar.innerHTML = TOOLS.map((t) =>\n    t === '|'\n      ? '<span class=\"sep\"></span>'\n      : `<button type=\"button\" class=\"tb\" data-cmd=\"${t[0]}\" title=\"${t[2]}\" aria-label=\"${t[2]}\" ${PRESSABLE.includes(t[0]) ? 'aria-pressed=\"false\"' : ''}>${t[1]}</button>`,\n  ).join('');\n  bar.insertAdjacentHTML(\n    'beforeend',\n    `<div class=\"swatches\" id=\"swatches\">${COLORS.map(([n, c]) => `<button type=\"button\" class=\"sw\" data-color=\"${c}\" title=\"${n}\" aria-label=\"Cor: ${n}\" style=\"--sw:${c}\"></button>`).join('')}</div>`,\n  );\n}\nlet activeEd = null;\nlet savedRange = null;\nfunction keepRange() {\n  const s = getSelection();\n  if (s && s.rangeCount && activeEd && activeEd.contains(s.anchorNode))\n    savedRange = s.getRangeAt(0).cloneRange();\n}\nfunction restoreRange() {\n  if (!activeEd) return;\n  activeEd.focus();\n  const s = getSelection();\n  if (!savedRange || !s) return;\n  s.removeAllRanges();\n  s.addRange(savedRange);\n}\n/* execCommand é obsoleto, mas é o que edita contenteditable sem biblioteca; falha sem quebrar */\nfunction exec(cmd, val) {\n  try {\n    return document.execCommand(cmd, false, val);\n  } catch (e) {\n    return false;\n  }\n}\nfunction query(fn, cmd) {\n  try {\n    return document[fn](cmd);\n  } catch (e) {\n    return fn === 'queryCommandState' ? false : '';\n  }\n}\nfunction runCmd(cmd, val) {\n  restoreRange();\n  exec('styleWithCSS', true);\n  const block = String(query('queryCommandValue', 'formatBlock') || '').toLowerCase();\n  if (cmd === 'h4' || cmd === 'blockquote') exec('formatBlock', block === cmd ? 'p' : cmd);\n  else exec(cmd, val);\n  keepRange();\n  syncToolbar();\n}\nfunction syncToolbar() {\n  if (!activeEd) return;\n  document\n    .querySelectorAll('#rtbar [aria-pressed]')\n    .forEach((b) =>\n      b.setAttribute('aria-pressed', String(!!query('queryCommandState', b.dataset.cmd))),\n    );\n  const sw = document.getElementById('cur-sw');\n  if (sw) sw.style.setProperty('--sw', query('queryCommandValue', 'foreColor') || '#eae5da');\n}\nfunction markEmpty(ed) {\n  ed.classList.toggle('empty', !ed.textContent.trim() && !ed.querySelector('hr'));\n}\n/* o campo com foco não é sobrescrito: o state que volta da própria edição chegaria no meio */\nfunction paintRich(root) {\n  root.querySelectorAll('[data-rt]').forEach((ed) => {\n    if (ed === activeEd && document.activeElement === ed) return;\n    const html = lorkarium.html.sanitize(String(getP(ed.dataset.rt) || ''));\n    if (ed.dataset.shown !== html) {\n      ed.innerHTML = html;\n      ed.dataset.shown = html;\n    }\n    markEmpty(ed);\n  });\n}\nfunction saveRich(ed) {\n  markEmpty(ed);\n  const html = ed.classList.contains('empty') ? '' : lorkarium.html.sanitize(ed.innerHTML);\n  ed.dataset.shown = html;\n  patch(ed.dataset.rt, html || null);\n}\nfunction pasteInto(e) {\n  const dt = e.clipboardData;\n  if (!dt) return;\n  e.preventDefault();\n  if ([...dt.files].some((f) => f.type.startsWith('image/'))) {\n    setStatus('Para imagens, use o “Adicionar imagem” da entrada.');\n    return;\n  }\n  const html = dt.getData('text/html');\n  if (!html) exec('insertText', dt.getData('text/plain'));\n  else exec('insertHTML', lorkarium.html.sanitize(html));\n}\n/* campo vazio ganha um <p> ao focar: sem ele a 1ª linha fica texto solto e o espaçamento difere */\nfunction primeEmpty(ed) {\n  if (ed.innerHTML.trim()) return;\n  ed.innerHTML = '<p><br></p>';\n  const r = document.createRange();\n  r.setStart(ed.firstChild, 0);\n  r.collapse(true);\n  const s = getSelection();\n  if (!s) return;\n  s.removeAllRanges();\n  s.addRange(r);\n}\n"
    },
    {
      "path": "js/imagens.js",
      "content": "/* ---------- imagens ---------- */\n/* Nada de rede nem de data: URL nos valores: cada imagem é um asset da ficha (assets.upload),\n   guardado pelo id; os bytes chegam por assets.read e viram um blob: só desta página. */\nconst imageUrls = new Map();\nlet portraitUrl = '';\nlet portraitBytes = null;\n\nfunction imageUrlOf(assetId) {\n  if (!imageUrls.has(assetId)) {\n    const read = lorkarium.assets\n      .read(assetId)\n      .then(({ type, bytes }) => URL.createObjectURL(new Blob([bytes], { type })));\n    read.catch(() => imageUrls.delete(assetId));\n    imageUrls.set(assetId, read);\n  }\n  return imageUrls.get(assetId);\n}\nfunction showImage(btn, url, label, small) {\n  btn.textContent = '';\n  btn.classList.toggle('has', !!url);\n  btn.setAttribute('aria-label', (url ? 'Trocar imagem: ' : '') + label);\n  if (!url) {\n    btn.innerHTML = ic('image', small ? 15 : 20) + `<span>${esc(label)}</span>`;\n    return;\n  }\n  const im = document.createElement('img');\n  im.src = url;\n  im.alt = '';\n  btn.append(im);\n}\nfunction renderImg(slot) {\n  const id = getP(slot.dataset.img);\n  const btn = slot.querySelector('.img-btn');\n  slot.querySelector('.img-rm').hidden = !id;\n  if (slot.dataset.shown === String(id || '')) return;\n  slot.dataset.shown = String(id || '');\n  if (!id) return showImage(btn, '', slot.dataset.label, true);\n  imageUrlOf(id).then(\n    (url) => {\n      if (slot.dataset.shown === id) showImage(btn, url, slot.dataset.label, true);\n    },\n    () => setStatus('Não deu para ler uma imagem da ficha.'),\n  );\n}\nfunction uploadInto(slot, file) {\n  setStatus('');\n  lorkarium.assets\n    .upload(file)\n    .then(({ assetId }) => patch(slot.dataset.img, assetId).then(() => renderImg(slot)))\n    .catch(imgFail);\n}\nconst imgFail = (e) =>\n  setStatus('Não deu para enviar essa imagem (PNG, JPG ou WebP): ' + failText(e));\n\n/* o retrato é a imagem do personagem na mesa: chega no state e muda por character.setImage */\nfunction readPortrait(token) {\n  const image = token && token.image;\n  if (!image || !image.bytes) {\n    portraitBytes = null;\n    portraitUrl = '';\n    return;\n  }\n  // cada state traz uma cópia nova dos bytes: o tamanho e o tipo dizem se a imagem mudou\n  const key = `${image.type}:${image.bytes.byteLength}`;\n  if (key === portraitBytes) return;\n  if (portraitUrl) URL.revokeObjectURL(portraitUrl);\n  portraitBytes = key;\n  portraitUrl = URL.createObjectURL(new Blob([image.bytes], { type: image.type }));\n}\nfunction renderPortrait() {\n  const slot = document.querySelector('[data-portrait]');\n  const note = document.getElementById('portrait-note');\n  showImage(\n    slot.querySelector('.img-btn'),\n    portraitUrl,\n    VIEW.character ? 'Trocar o retrato' : 'Sem retrato',\n    false,\n  );\n  note.hidden = !!VIEW.character || !VIEW.canEdit;\n  note.textContent = 'O retrato é o do personagem: esta ficha não é de um personagem.';\n}\nfunction changePortrait(file) {\n  if (!VIEW.character) return;\n  setStatus('');\n  lorkarium.character.setImage(file).catch((e) => setStatus('O retrato não mudou: ' + failText(e)));\n}\n"
    },
    {
      "path": "js/eventos.js",
      "content": "/* ---------- eventos ---------- */\n/* script do modelo não usa atributo on*: o CSP da ficha não o roda; tudo por addEventListener */\nfunction arm(btn, action) {\n  if (btn.dataset.armed) {\n    delete btn.dataset.armed;\n    action();\n    return;\n  }\n  const label = btn.innerHTML;\n  const aria = btn.getAttribute('aria-label');\n  btn.dataset.armed = '1';\n  // botão só de ícone não cabe o texto: fica vermelho e a dica pede o segundo clique\n  if (btn.hasAttribute('data-arm-icon')) {\n    btn.setAttribute('aria-label', 'Clique de novo para tirar');\n    btn.title = 'Clique de novo para tirar';\n  } else btn.textContent = btn.dataset.confirm || 'Clique de novo para confirmar';\n  setTimeout(() => {\n    if (!btn.isConnected || !btn.dataset.armed) return;\n    delete btn.dataset.armed;\n    btn.innerHTML = label;\n    if (aria) btn.setAttribute('aria-label', aria);\n    btn.removeAttribute('title');\n  }, 3500);\n}\nfunction onCarry(el) {\n  const p = el.dataset.carry;\n  const pairs = [[p + '.guardado', el.checked ? null : true]];\n  if (!el.checked && (getP(p) || {}).emUso) pairs.push([p + '.emUso', null]);\n  patchMany(pairs).then(refresh);\n}\ndocument.addEventListener('input', (e) => {\n  const el = e.target;\n  if (!el || !el.dataset) return;\n  // o campo data-lk o próprio SDK grava; aqui só se marca que CA, CD e máximos podem ter mudado\n  if (el.dataset.lk) return markDirty();\n  if (el.dataset.rt) return saveRich(el);\n  if (el.dataset.carry) return onCarry(el);\n  if (el.dataset.wear) return setWorn(el.dataset.wear, el.checked).then(refresh);\n});\nconst wholeOf = (el) => {\n  const v = String(el.value).trim();\n  return /^\\d+$/.test(v) ? Number(v) : null;\n};\ndocument.addEventListener('change', (e) => {\n  const el = e.target;\n  if (!el || !el.dataset) return;\n  if (el.dataset.barcur && wholeOf(el) != null)\n    return adjustBar(el.dataset.barcur, { op: 'set', value: wholeOf(el) });\n  if (el.dataset.barmax && wholeOf(el) > 0)\n    return adjustBar(el.dataset.barmax, { op: 'max', value: wholeOf(el) });\n  if (el.type !== 'file' || !el.files || !el.files[0]) return;\n  const file = el.files[0];\n  el.value = '';\n  if (el.closest('[data-portrait]')) return changePortrait(file);\n  uploadInto(el.closest('[data-img]'), file);\n});\ndocument.addEventListener('focusin', (e) => {\n  const ed = e.target.closest && e.target.closest('.rt-ed');\n  if (!ed || !VIEW.canEdit) return;\n  primeEmpty(ed);\n  activeEd = ed;\n  document.getElementById('rtbar').classList.add('on');\n  syncToolbar();\n});\ndocument.addEventListener('focusout', (e) => {\n  const ed = e.target.closest && e.target.closest('.rt-ed');\n  if (ed && ed.classList.contains('empty')) {\n    ed.innerHTML = '';\n    if (getP(ed.dataset.rt)) saveRich(ed);\n  }\n  setTimeout(() => {\n    const a = document.activeElement;\n    if (a && a.closest && (a.closest('.rt-ed') || a.closest('#rtbar'))) return;\n    document.getElementById('rtbar').classList.remove('on');\n    document.getElementById('swatches').classList.remove('on');\n  }, 0);\n});\ndocument.addEventListener('selectionchange', () => {\n  if (!activeEd || document.activeElement !== activeEd) return;\n  keepRange();\n  syncToolbar();\n});\ndocument.addEventListener('paste', (e) => {\n  if (e.target.closest && e.target.closest('.rt-ed')) pasteInto(e);\n});\ndocument.addEventListener('keydown', (e) => {\n  if (e.target.id === 'rank-list') onRankKey(e);\n});\n\nconst CLICKS = {\n  goto: (b) => showPage(b.dataset.goto),\n  page: (b) => showPage(b.dataset.page),\n  toggle(b) {\n    const key = b.dataset.toggle;\n    UI.closed[key] = !UI.closed[key];\n    b.closest('.entry').classList.toggle('closed', UI.closed[key]);\n    b.setAttribute('aria-expanded', String(!UI.closed[key]));\n  },\n  add: (b) => addItem(b.dataset.add),\n  rm(b) {\n    const [n, id] = b.dataset.rm.split(':');\n    arm(b, () => removeItem(n, id));\n  },\n  tr(b) {\n    patch(b.dataset.tr, multOf(getP(b.dataset.tr)) ? null : 1).then(refresh);\n  },\n  mult(b) {\n    patch(b.dataset.mult, NEXT_MULT[multOf(getP(b.dataset.mult))] || 1).then(refresh);\n  },\n  padd: (b) => addItem('perlist.' + b.dataset.padd),\n  prm(b) {\n    const [k, id] = b.dataset.prm.split(':');\n    removeItem('perlist.' + k, id);\n  },\n  addcost(b) {\n    const first = sortedBars()[0];\n    addItem(`hab.${b.dataset.addcost}.custos`, {\n      bar: tableBar('MP') ? 'MP' : first ? first.label : '',\n      v: '',\n    });\n  },\n  rmcost(b) {\n    const [habId, costId] = b.dataset.rmcost.split(':');\n    removeItem(`hab.${habId}.custos`, costId);\n  },\n  use: (b) => useSkill(b.dataset.use),\n  fold(b) {\n    const k = b.dataset.fold;\n    setFold(k, !isFolded(k));\n    applyFold(b.closest(`[data-foldbox=\"${k}\"]`));\n  },\n  foldall(b) {\n    const close = b.dataset.foldall === 'close';\n    document.querySelectorAll('#pg-origem [data-foldbox]').forEach((box) => {\n      setFold(box.dataset.foldbox, close && box.dataset.foldbox.startsWith('sec.'));\n      applyFold(box);\n    });\n  },\n  rest: (b) => takeRest(b),\n  addbag: () => addItem('mochila'),\n  rmbag: (b) => removeItem('mochila', b.dataset.rmbag),\n  resettrain: () => patch('f.treino', null).then(refresh),\n  reset: (b) => patch(`res.${b.dataset.reset}.max`, null).then(refresh),\n};\nfunction onImageClick(b) {\n  const slot = b.closest('[data-img],[data-portrait]');\n  if (b.classList.contains('img-btn')) {\n    if (VIEW.canEdit && !(slot.hasAttribute('data-portrait') && !VIEW.character))\n      slot.querySelector('input[type=file]').click();\n    return;\n  }\n  patch(slot.dataset.img, null).then(() => renderImg(slot));\n}\ndocument.addEventListener('click', (e) => {\n  const rankList = document.getElementById('rank-list');\n  const li = e.target.closest && e.target.closest('[data-rank]');\n  if (li) return VIEW.canEdit && pickRank(li.dataset.rank);\n  if (e.target.closest('#rank-btn')) return openRank(rankList.hidden);\n  if (!rankList.hidden && !e.target.closest('#rank-wrap')) openRank(false);\n  const prev = e.target.closest('.fold-prev');\n  if (prev) {\n    const box = prev.closest('[data-foldbox]');\n    setFold(box.dataset.foldbox, false);\n    applyFold(box);\n    return;\n  }\n  const b = e.target.closest('button');\n  if (!b || b.disabled || b.closest('#rtbar')) return;\n  if (b.classList.contains('img-btn') || b.classList.contains('img-rm')) return onImageClick(b);\n  const key = Object.keys(CLICKS).find((k) => k in b.dataset);\n  if (key) CLICKS[key](b);\n});\nconst rtbar = document.getElementById('rtbar');\nrtbar.addEventListener('mousedown', (e) => e.preventDefault());\nrtbar.addEventListener('click', (e) => {\n  const sw = e.target.closest('[data-color]');\n  if (sw) {\n    document.getElementById('swatches').classList.remove('on');\n    runCmd('foreColor', sw.dataset.color);\n    return;\n  }\n  const b = e.target.closest('[data-cmd]');\n  if (!b) return;\n  if (b.dataset.cmd === 'color') document.getElementById('swatches').classList.toggle('on');\n  else runCmd(b.dataset.cmd);\n});\n"
    },
    {
      "path": "js/inicio.js",
      "content": "/* ---------- abas ---------- */\n/* abas por estado (UI.page): o frame da ficha não navega, nem por location.hash */\nconst freeText = (title, p) => () =>\n  `<header><h1 class=\"h1\">${title}</h1></header>${rich('', p, 'Escreva aqui', 'free')}`;\nconst PAGES = [\n  ['perfil', 'Perfil', pgPerfil],\n  ['origem', 'Origem', pgOrigem],\n  ['atributos', 'Atributos', pgAtributos],\n  ['pericias', 'Perícias', pgPericias],\n  ['habilidades', 'Habilidades', pgHabilidades],\n  ['inventario', 'Inventário', pgInventario],\n  ['anotacoes', 'Anotações', freeText('Anotações', 'notas.livre')],\n  ['historia', 'História', freeText('História', 'notas.historia')],\n  ['regras', 'Regras', null],\n];\n/* regras do sistema, não do personagem: ficam no pé do menu, separadas */\nconst FOOT_PAGES = ['regras'];\nfunction showPage(id) {\n  UI.page = PAGES.some((p) => p[0] === id) ? id : 'perfil';\n  for (const [pid] of PAGES) {\n    document.getElementById('pg-' + pid).classList.toggle('on', pid === UI.page);\n    document\n      .querySelector(`[data-page=\"${pid}\"]`)\n      .setAttribute('aria-selected', String(pid === UI.page));\n  }\n  if (window.scrollTo) window.scrollTo(0, 0);\n}\n\n/* ---------- montagem ---------- */\n/* o que muda a forma da página (ids das listas, barras da mesa) pede montar de novo; o resto\n   só se pinta por cima, sem tirar o foco de quem digita */\nfunction signature() {\n  const ids = (path) => itemsOf(path).map(([id]) => id);\n  return JSON.stringify([\n    Object.keys(LISTS).map(ids),\n    ids('mochila'),\n    ids('contas'),\n    MULTI.map((k) => ids('perlist.' + k)),\n    ids('hab').map((id) => ids(`hab.${id}.custos`)),\n    sortedBars().map((b) => [b.id, b.label, b.color]),\n  ]);\n}\nlet shape = '';\nfunction renderStructure() {\n  shape = signature();\n  renderBars();\n  renderContas();\n  Object.keys(LISTS).forEach(renderList);\n  renderPericias();\n  renderBag();\n}\nfunction renderAll() {\n  const tab = ([id, l]) =>\n    `<button type=\"button\" role=\"tab\" data-page=\"${id}\" data-keep aria-selected=\"false\" aria-controls=\"pg-${id}\">${l}</button>`;\n  document.getElementById('nav').innerHTML = PAGES.filter((p) => !FOOT_PAGES.includes(p[0]))\n    .map(tab)\n    .join('');\n  document.getElementById('nav-foot').innerHTML = PAGES.filter((p) => FOOT_PAGES.includes(p[0]))\n    .map(tab)\n    .join('');\n  for (const [id, , fn] of PAGES) if (fn) document.getElementById('pg-' + id).innerHTML = fn();\n  renderToolbar();\n  renderStructure();\n  showPage(UI.page);\n}\nfunction paintAll() {\n  const main = document.getElementById('main');\n  paintRich(main);\n  main.querySelectorAll('[data-img]').forEach(renderImg);\n  main.querySelectorAll('[data-carry]').forEach(paintCarry);\n  main.querySelectorAll('[data-wear]').forEach((cb) => {\n    cb.checked = !!(getP(cb.dataset.wear) || {}).emUso;\n  });\n  main.querySelectorAll('[data-foldbox]').forEach(applyFold);\n  paintRank();\n  paintBars();\n  renderPortrait();\n  renderWho();\n}\nfunction recalc() {\n  const t = totals();\n  for (const [k] of ATTRS) document.getElementById('tot-' + k).textContent = sign(t[k]);\n  checkPoints();\n  calcBars(t);\n  calcContas(t);\n  calcPericias(t);\n  calcLoad(t);\n  calcRules();\n  calcArmor(t);\n  calcCd(t);\n  document.querySelectorAll('[data-entry]').forEach(updateMeta);\n}\n/* quem só lê vê tudo e não muda nada: abas e recolher seguem funcionando */\nfunction applyAccess() {\n  const ro = !VIEW.canEdit;\n  document.body.classList.toggle('readonly', ro);\n  document.querySelectorAll('input, select, textarea, button').forEach((el) => {\n    if (!el.hasAttribute('data-keep') && !el.closest('#rtbar')) el.disabled = ro;\n  });\n  document\n    .querySelectorAll('.rt-ed')\n    .forEach((ed) => ed.setAttribute('contenteditable', ro ? 'false' : 'true'));\n}\nfunction refresh() {\n  if (signature() !== shape) renderStructure();\n  paintAll();\n  recalc();\n  applyAccess();\n}\nfunction onState(state) {\n  VIEW = {\n    canEdit: state.canEdit === true,\n    bars: lorkarium.bars.list(),\n    character: lorkarium.character.get(),\n    token: state.token,\n  };\n  S = lorkarium.values.all();\n  readPortrait(state.token);\n  refresh();\n  if (dirty) schedulePush();\n}\n\n/* ---------- início ---------- */\nrenderAll();\nrefresh();\ntry {\n  document.execCommand('defaultParagraphSeparator', false, 'p');\n} catch (e) {\n  // sem execCommand (fora do navegador) o texto rico só perde a quebra em <p>\n}\nlorkarium.onState(onState);\nlorkarium.ready();\n"
    }
  ],
  "manifest": {
    "permissions": [
      "character:stats",
      "character:portrait",
      "sheet:images"
    ],
    "bars": [
      {
        "label": "HP",
        "color": "ember",
        "max": 12
      },
      {
        "label": "MP",
        "color": "steel",
        "max": 10
      },
      {
        "label": "EN",
        "color": "moss",
        "max": 10
      },
      {
        "label": "ES",
        "color": "ash",
        "max": 15
      }
    ],
    "assets": []
  },
  "assets": [
    {
      "path": "fontes/hanken-grotesk.woff2",
      "type": "font/woff2",
      "data": ""
    },
    {
      "path": "fontes/cormorant-garamond.woff2",
      "type": "font/woff2",
      "data": ""
    },
    {
      "path": "fontes/cormorant-garamond-italic.woff2",
      "type": "font/woff2",
      "data": ""
    },
    {
      "path": "fontes/cinzel.woff2",
      "type": "font/woff2",
      "data": ""
    }
  ]
}
