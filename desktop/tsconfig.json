{
  "extends": "@lorkarium/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    // release/ runs straight on Node (semantic-release imports the .ts), which only strips types.
    "erasableSyntaxOnly": true,
    // scripts/ also runs straight on Node, which needs the .ts extension on relative imports.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "release", "scripts", "vite.config.ts"]
}
