{
  "name": "@lorkarium/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "tauri": "tauri",
    "installer:art": "node scripts/installer-art.ts",
    "release": "semantic-release"
  },
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "desktop-v${version}",
    "plugins": [
      [
        "./release/desktop-commits.ts",
        {
          "preset": "conventionalcommits",
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "Novidades"
              },
              {
                "type": "fix",
                "section": "Correções"
              },
              {
                "type": "perf",
                "section": "Desempenho"
              }
            ]
          }
        }
      ],
      [
        "@semantic-release/github",
        {
          "draftRelease": true,
          "releaseNameTemplate": "Lorkarium para Windows <%= nextRelease.version %>",
          "releaseBodyTemplate": "Instale o Lorkarium_<%= nextRelease.version %>_x64-setup.exe. Quem já tem o app recebe esta versão sozinho ao abrir.\n\n<%= nextRelease.notes %>",
          "successComment": false,
          "failComment": false,
          "releasedLabels": false
        }
      ]
    ]
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lorkarium/tsconfig": "workspace:*",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "semantic-release": "^25.0.9",
    "sharp": "^0.35.5",
    "vite": "^8.3.4"
  }
}
