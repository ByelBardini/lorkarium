; Lorkarium installer look: one dark window in the brand palette, with the logo on top of every page.
; Tauri includes this file (bundle.windows.nsis.installerHooks) near the top of installer.nsi, before
; PRODUCTNAME, VERSION and UNINSTKEY exist, so anything that reads them lives inside a macro that the
; template inserts later (LK_PAGE_HOME, LK_STYLE_INSTFILES, LK_PAGE_DONE).
; No skin plugin on purpose: only nsDialogs and System::Call, so the window keeps the Windows frame.

!include LogicLib.nsh
!include nsDialogs.nsh
!include WinMessages.nsh

; Generated by `pnpm --filter @lorkarium/desktop installer:art`.
!define LK_ART "${__FILEDIR__}\art"

; SetCtlColors takes 0xRRGGBB; the Win32 messages and DWM take a COLORREF (0x00BBGGRR).
!define LK_BG 0x101216
!define LK_BG_COLORREF 0x00161210
!define LK_PANEL_COLORREF 0x00110E0C
!define LK_TEXT 0xEAE5DA
!define LK_MUTED 0xA9A497
!define LK_GOLD 0xC5A46D
!define LK_GOLD_COLORREF 0x006DA4C5
!define LK_INK 0x15130F
!define LK_DISABLED_BG 0x303640
!define LK_EMBER 0xC9705A

; Client size at 100% display scale; every px below is scaled by $lkScale.
!define LK_WINDOW_WIDTH 520
!define LK_WINDOW_HEIGHT 420
!define LK_HERO_TOP 32
!define LK_HERO_WIDTH 288
!define LK_HERO_HEIGHT 144
!define LK_BUTTON_WIDTH 220
!define LK_BUTTON_HEIGHT 42

!define LK_WM_NOTIFY_OUTER_NEXT 0x408
!define LK_PBM_SETBARCOLOR 0x409
!define LK_PBM_SETBKCOLOR 0x2001
!define LK_SWP_NOZORDER_NOACTIVATE 0x14
!define LK_SWP_FRAMECHANGED_NOZORDER_NOACTIVATE 0x34
!define LK_DWMWA_USE_IMMERSIVE_DARK_MODE 20
!define LK_DWMWA_CAPTION_COLOR 35

Var lkScale
Var lkArtScale
Var lkWidth
Var lkHeight
Var lkHeroBottom
Var lkHeroBitmap
Var lkFontTitle
Var lkFontBody
Var lkFontSmall
Var lkFontButton
Var lkPage
Var lkShortcutState
; The one checkbox a page may have (LkCheckRow).
Var lkCheckBox

; Interactive installs only: passive and silent ones (the updater) already get it from the template.
!macro NSIS_HOOK_POSTINSTALL
  ${If} $PassiveMode <> 1
  ${AndIfNot} ${Silent}
  ${AndIf} $lkShortcutState = ${BST_CHECKED}
    Call CreateOrUpdateDesktopShortcut
  ${EndIf}
!macroend

; The uninstall progress page has no Next button left to press, so it always leaves for the
; goodbye page by itself (the template only auto-closes in passive and update mode).
!macro NSIS_HOOK_POSTUNINSTALL
  SetAutoClose true
!macroend

; OUT = VALUE px at 100%, scaled to the window's DPI.
!macro LK_PX OUT VALUE
  IntOp ${OUT} ${VALUE} * $lkScale
  IntOp ${OUT} ${OUT} / 100
!macroend

!macro LK_HIDE_ITEM PARENT ID
  GetDlgItem $0 ${PARENT} ${ID}
  ShowWindow $0 ${SW_HIDE}
!macroend

; Centered text line across the page; leaves the label in $0.
!macro LK_LABEL Y HEIGHT TEXT FONT COLOR
  ${NSD_CreateLabel} 0 ${Y} $lkWidth ${HEIGHT} "${TEXT}"
  Pop $0
  ${NSD_AddStyle} $0 ${SS_CENTER}
  SetCtlColors $0 ${COLOR} ${LK_BG}
  SendMessage $0 ${WM_SETFONT} ${FONT} 1
!macroend

; A flat gold "button": a clickable STATIC, because a Win32 button cannot be colored without
; owner-draw. Enter still works through the hidden default Next button. Leaves it in $0.
!macro LK_BUTTON Y TEXT FG BG CALLBACK
  !insertmacro LK_PX $8 ${LK_BUTTON_WIDTH}
  !insertmacro LK_PX $9 ${LK_BUTTON_HEIGHT}
  IntOp $7 $lkWidth - $8
  IntOp $7 $7 / 2
  nsDialogs::CreateControl STATIC ${DEFAULT_STYLES}|${SS_CENTER}|${SS_CENTERIMAGE}|${SS_NOTIFY} 0 $7 ${Y} $8 $9 "${TEXT}"
  Pop $0
  SetCtlColors $0 ${FG} ${BG}
  SendMessage $0 ${WM_SETFONT} $lkFontButton 1
  ${NSD_OnClick} $0 ${CALLBACK}
!macroend

; Starts a page under the logo, filling the rest of the window. Leaves the page in $lkPage.
!macro LK_PAGE_BEGIN UN
  Call ${UN}LkHideChrome
  nsDialogs::Create 1018
  Pop $lkPage
  ${IfThen} $lkPage == error ${|} Abort ${|}
  StrCpy $0 $lkPage
  Call ${UN}LkPlaceInner
!macroend

; UN is "" for the installer and "un." for the uninstaller: NSIS needs the prefix on every
; function the uninstaller calls, so the same functions are inserted once per side.
!macro LK_CHROME_FUNCTIONS UN
  Function ${UN}LkGuiInit
    Call ${UN}LkReadScale
    Call ${UN}LkResizeWindow
    Call ${UN}LkHideChrome
    Call ${UN}LkCreateFonts
    SetCtlColors $HWNDPARENT ${LK_TEXT} ${LK_BG}
    System::Call 'dwmapi::DwmSetWindowAttribute(p $HWNDPARENT, i ${LK_DWMWA_USE_IMMERSIVE_DARK_MODE}, *i 1, i 4)'
    System::Call 'dwmapi::DwmSetWindowAttribute(p $HWNDPARENT, i ${LK_DWMWA_CAPTION_COLOR}, *i ${LK_BG_COLORREF}, i 4)'
    Call ${UN}LkShowHero
  FunctionEnd

  ; GetDpiForWindow needs Windows 10 1607; older ones fall back to 100%.
  Function ${UN}LkReadScale
    System::Call 'user32::GetDpiForWindow(p $HWNDPARENT) i .r0'
    IntOp $0 $0 + 0
    ${IfThen} $0 <= 0 ${|} StrCpy $0 96 ${|}
    IntOp $lkScale $0 * 100
    IntOp $lkScale $lkScale / 96
    StrCpy $lkArtScale 100
    ${IfThen} $lkScale >= 125 ${|} StrCpy $lkArtScale 125 ${|}
    ${IfThen} $lkScale >= 150 ${|} StrCpy $lkArtScale 150 ${|}
    ${IfThen} $lkScale >= 200 ${|} StrCpy $lkArtScale 200 ${|}
  FunctionEnd

  ; Grows the client area to LK_WINDOW_* around the same center; the frame size is whatever
  ; Windows draws, measured as window rect minus client rect.
  Function ${UN}LkResizeWindow
    System::Call '*(i, i, i, i) p .r1'
    System::Call 'user32::GetWindowRect(p $HWNDPARENT, p r1)'
    System::Call '*$1(i .r2, i .r3, i .r4, i .r5)'
    System::Call 'user32::GetClientRect(p $HWNDPARENT, p r1)'
    System::Call '*$1(i, i, i .r6, i .r7)'
    System::Free $1
    !insertmacro LK_PX $lkWidth ${LK_WINDOW_WIDTH}
    !insertmacro LK_PX $lkHeight ${LK_WINDOW_HEIGHT}
    IntOp $8 $4 - $2
    IntOp $8 $8 - $6
    IntOp $8 $8 + $lkWidth
    IntOp $9 $5 - $3
    IntOp $9 $9 - $7
    IntOp $9 $9 + $lkHeight
    Call ${UN}LkMoveWindowCentered
  FunctionEnd

  ; In: $2,$3 old top-left, $4,$5 old bottom-right, $8,$9 new outer size.
  Function ${UN}LkMoveWindowCentered
    IntOp $0 $4 - $2
    IntOp $0 $0 - $8
    IntOp $0 $0 / 2
    IntOp $0 $0 + $2
    IntOp $1 $5 - $3
    IntOp $1 $1 - $9
    IntOp $1 $1 / 2
    IntOp $1 $1 + $3
    System::Call 'user32::SetWindowPos(p $HWNDPARENT, p 0, i r0, i r1, i r8, i r9, i ${LK_SWP_NOZORDER_NOACTIVATE})'
  FunctionEnd

  ; NSIS shows Back again on every page change, so each page calls this from its show function.
  Function ${UN}LkHideChrome
    !insertmacro LK_HIDE_ITEM $HWNDPARENT 1
    !insertmacro LK_HIDE_ITEM $HWNDPARENT 2
    !insertmacro LK_HIDE_ITEM $HWNDPARENT 3
    !insertmacro LK_HIDE_ITEM $HWNDPARENT 1028
    !insertmacro LK_HIDE_ITEM $HWNDPARENT 1256
    !insertmacro LK_HIDE_ITEM $HWNDPARENT 1034
    !insertmacro LK_HIDE_ITEM $HWNDPARENT 1035
    !insertmacro LK_HIDE_ITEM $HWNDPARENT 1036
    !insertmacro LK_HIDE_ITEM $HWNDPARENT 1037
    !insertmacro LK_HIDE_ITEM $HWNDPARENT 1038
    !insertmacro LK_HIDE_ITEM $HWNDPARENT 1039
  FunctionEnd

  ; Segoe UI ships with every Windows; the brand fonts only exist inside the logo bitmap.
  Function ${UN}LkCreateFonts
    CreateFont $lkFontTitle "Segoe UI" 16 600
    CreateFont $lkFontBody "Segoe UI" 11 400
    CreateFont $lkFontSmall "Segoe UI" 9 400
    CreateFont $lkFontButton "Segoe UI" 11 600
  FunctionEnd

  ; The logo is a child of the outer window, so it stays put while the pages change under it.
  Function ${UN}LkShowHero
    Call ${UN}LkExtractHero
    System::Call 'user32::LoadImage(p 0, t "$PLUGINSDIR\hero.bmp", i ${IMAGE_BITMAP}, i 0, i 0, i ${LR_LOADFROMFILE}) p .r0'
    StrCpy $lkHeroBitmap $0
    IntOp $8 ${LK_HERO_WIDTH} * $lkArtScale
    IntOp $8 $8 / 100
    IntOp $9 ${LK_HERO_HEIGHT} * $lkArtScale
    IntOp $9 $9 / 100
    IntOp $6 $lkWidth - $8
    IntOp $6 $6 / 2
    !insertmacro LK_PX $7 ${LK_HERO_TOP}
    IntOp $lkHeroBottom $7 + $9
    System::Call 'user32::CreateWindowEx(i 0, w "STATIC", w "", i ${WS_CHILD}|${WS_VISIBLE}|${SS_BITMAP}, i r6, i r7, i r8, i r9, p $HWNDPARENT, p 0, p 0, p 0) p .r1'
    SendMessage $1 ${STM_SETIMAGE} ${IMAGE_BITMAP} $lkHeroBitmap
  FunctionEnd

  ; One bitmap per display scale, so the logo is never stretched.
  Function ${UN}LkExtractHero
    InitPluginsDir
    ${Select} $lkArtScale
      ${Case} 125
        File "/oname=$PLUGINSDIR\hero.bmp" "${LK_ART}\hero-125.bmp"
      ${Case} 150
        File "/oname=$PLUGINSDIR\hero.bmp" "${LK_ART}\hero-150.bmp"
      ${Case} 200
        File "/oname=$PLUGINSDIR\hero.bmp" "${LK_ART}\hero-200.bmp"
      ${CaseElse}
        File "/oname=$PLUGINSDIR\hero.bmp" "${LK_ART}\hero-100.bmp"
    ${EndSelect}
  FunctionEnd

  ; In: $0 = the page's inner dialog. Moves it under the logo, filling the rest of the window.
  Function ${UN}LkPlaceInner
    IntOp $1 $lkHeight - $lkHeroBottom
    System::Call 'user32::SetWindowPos(p r0, p 0, i 0, i $lkHeroBottom, i $lkWidth, i r1, i ${LK_SWP_NOZORDER_NOACTIVATE})'
    SetCtlColors $0 ${LK_TEXT} ${LK_BG}
  FunctionEnd

  ; In: $1 = top, $3 = text, $4 = row width at 100%. Out: $lkCheckBox, centered with its label.
  ; A text-less themed box (the Windows 11 glyph) plus our own label: a themed checkbox ignores
  ; SetCtlColors for its text, which would stay black on the dark background.
  Function ${UN}LkCheckRow
    !insertmacro LK_PX $4 $4
    IntOp $7 $lkWidth - $4
    IntOp $7 $7 / 2
    !insertmacro LK_PX $5 18
    ${NSD_CreateCheckbox} $7 $1 $5 $5 ""
    Pop $lkCheckBox
    SetCtlColors $lkCheckBox "" ${LK_BG}
    !insertmacro LK_PX $6 26
    IntOp $7 $7 + $6
    IntOp $4 $4 - $6
    ${NSD_CreateLabel} $7 $1 $4 $5 "$3"
    Pop $0
    SetCtlColors $0 ${LK_TEXT} ${LK_BG}
    SendMessage $0 ${WM_SETFONT} $lkFontSmall 1
    ${NSD_OnClick} $0 ${UN}LkToggleCheckBox
  FunctionEnd

  Function ${UN}LkToggleCheckBox
    Pop $0
    ${NSD_GetState} $lkCheckBox $1
    ${If} $1 = ${BST_CHECKED}
      ${NSD_Uncheck} $lkCheckBox
    ${Else}
      ${NSD_Check} $lkCheckBox
    ${EndIf}
  FunctionEnd

  ; Out: $1 = top of the page's main button, whose bottom edge sits 40 px above the window's.
  Function ${UN}LkBottomButtonTop
    IntOp $1 $lkHeight - $lkHeroBottom
    !insertmacro LK_PX $2 82
    IntOp $1 $1 - $2
  FunctionEnd

  ; Out: $1 = top of the row above the main button.
  Function ${UN}LkBottomRowsTop
    Call ${UN}LkBottomButtonTop
    !insertmacro LK_PX $2 38
    IntOp $1 $1 - $2
  FunctionEnd

  ; Out: $5 = the progress page, under the logo, with only the bar left of NSIS's controls.
  Function ${UN}LkStyleInstFiles
    Call ${UN}LkHideChrome
    FindWindow $0 "#32770" "" $HWNDPARENT
    Call ${UN}LkPlaceInner
    StrCpy $5 $0
    !insertmacro LK_HIDE_ITEM $5 1016
    !insertmacro LK_HIDE_ITEM $5 1027
    !insertmacro LK_HIDE_ITEM $5 1006
    Call ${UN}LkStyleProgressBar
  FunctionEnd

  ; In: $5 = the progress page, $3 = the text. NSIS's own status line (1006) ignores SetCtlColors
  ; (black on the dark page) and prints raw steps ("Size:80 Kb  Files:1"), so a fixed line replaces it.
  Function ${UN}LkStatusLine
    !insertmacro LK_PX $2 30
    !insertmacro LK_PX $6 22
    System::Call 'user32::CreateWindowEx(i 0, w "STATIC", w "$3", i ${WS_CHILD}|${WS_VISIBLE}|${SS_CENTER}, i 0, i r2, i $lkWidth, i r6, p r5, p 0, p 0, p 0) p .r1'
    SetCtlColors $1 ${LK_MUTED} ${LK_BG}
    SendMessage $1 ${WM_SETFONT} $lkFontSmall 1
  FunctionEnd

  ; In: $5 = the progress page. Without its theme the bar takes our colors (themed, it stays green),
  ; but the classic bar brings a white 3D edge, dropped here (SWP_FRAMECHANGED redraws the frame).
  Function ${UN}LkStyleProgressBar
    GetDlgItem $1 $5 1004
    System::Call 'uxtheme::SetWindowTheme(p r1, w "", w "")'
    ${NSD_RemoveStyle} $1 ${WS_BORDER}
    ${NSD_RemoveExStyle} $1 ${WS_EX_STATICEDGE}|${WS_EX_CLIENTEDGE}
    SendMessage $1 ${LK_PBM_SETBARCOLOR} 0 ${LK_GOLD_COLORREF}
    SendMessage $1 ${LK_PBM_SETBKCOLOR} 0 ${LK_PANEL_COLORREF}
    !insertmacro LK_PX $2 80
    !insertmacro LK_PX $3 60
    !insertmacro LK_PX $6 6
    IntOp $4 $lkWidth - $2
    IntOp $4 $4 - $2
    System::Call 'user32::SetWindowPos(p r1, p 0, i r2, i r3, i r4, i r6, i ${LK_SWP_FRAMECHANGED_NOZORDER_NOACTIVATE})'
  FunctionEnd
!macroend

!macro LK_STYLE_INSTFILES
  ; The install page leaves for the done page by itself (the done page is the one with a button).
  AutoCloseWindow true
  InstProgressFlags smooth
  !define MUI_PAGE_CUSTOMFUNCTION_SHOW LkInstFilesShow

  ; Passive runs (the updater) skip the home page, hence the detection here.
  Function LkInstFilesShow
    Call LkStyleInstFiles
    Call LkDetectInstalled
    StrCpy $3 "Instalando o Lorkarium…"
    ${IfThen} $lkCompare == "1" ${|} StrCpy $3 "Atualizando o Lorkarium…" ${|}
    Call LkStatusLine
  FunctionEnd
!macroend

!include "${__FILEDIR__}\page-home.nsh"
!include "${__FILEDIR__}\page-done.nsh"
!include "${__FILEDIR__}\page-uninstall.nsh"
