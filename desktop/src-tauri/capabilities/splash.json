{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "splash",
  "description": "Only the local splash talks to the shell; the remote site gets no IPC at all.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-begin-startup",
    "allow-retry-connection"
  ]
}
